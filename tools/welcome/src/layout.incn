pub def site_footer(compact: bool = true) -> DocumentNode:
    mut community = community_section()
    if compact:
        community.attributes["class"] = "community-section community-compact ruled"
        community.attributes["id"] = "footer-community"
        community.attributes["aria-labelledby"] = "footer-community-heading"
        for index in range(len(community.children)):
            mut child = community.children[index]
            if "class" in child.attributes and child.attributes["class"] == "community-copy":
                mut content: list[DocumentNode] = []
                for item in child.children:
                    if item.tag == "h2":
                        content.append(el("h2", {"id": "footer-community-heading"}, item.children))
                    elif item.tag != "nav" and item.tag != "":
                        content.append(item)
                child.children = content
                community.children[index] = child
    return el("footer", {"class": "site-footer"}, [el("div", {"class": "wrap"}, [community]), footer_credits()])


def footer_credits() -> DocumentNode:
    return el(
        "div",
        {"class": "footer wrap ruled"},
        [txt("\n    "), el(
            "div",
            {"class": "footer-identity"},
            [txt("\n      "), el(
                "a",
                {"class": "brand footer-brand", "href": "#welcome", "aria-label": "Built with Incan — back to home"},
                [el(
                    "img",
                    {"class": "built-with-stamp", "src": "assets/built-with-incan-mono.png", "width": "2172", "height": "724", "alt": "Built with Incan"},
                    [],
                )],
            ), txt("\n      "), el(
                "a",
                {"class": "encero-credit", "href": "https://encero.systems"},
                [txt("\n        "), el("span", {"class": "encero-credit-divider", "aria-hidden": "true"}, [txt("|")]), txt(
                    "\n        ",
                ), el("em", {}, [txt("by")]), txt("\n        "), el(
                    "span",
                    {"class": "encero-credit-name"},
                    [txt("ENCERO")],
                ), txt("\n      ")],
            ), txt("\n    ")],
        ), txt("\n    "), el(
            "nav",
            {"aria-label": "Footer navigation"},
            [el("a", {"href": "media.html"}, [txt("Media kit")]), el(
                "a",
                {"href": "https://incan.io/dev/release_notes/"},
                [txt("Releases")],
            ), el("a", {"href": "https://incan.io/dev/roadmap/"}, [txt("Roadmap")]), el(
                "a",
                {"href": "https://incan.io/dev/contributing/"},
                [txt("Contribute")],
            ), el(
                "a",
                {"href": "https://github.com/encero-systems/incan"},
                [txt("GitHub "), el("span", {"class": "icon github", "aria-hidden": "true"}, [])],
            )],
        ), txt("\n    "), el("small", {"class": "copyright"}, [txt("© 2026 Encero Systems")]), txt("\n  ")],
    )


pub def example_navigation() -> DocumentNode:
    return el(
        "nav",
        {"class": "example-navigation", "aria-label": "Code examples"},
        [txt("\n        "), el(
            "div",
            {"class": "example-tabs"},
            [txt("\n"), el(
                "button",
                {"type": "button", "data-example": "0", "aria-pressed": "false", "id": "tab-0"},
                [txt("Typed data")],
            ), txt("\n"), el(
                "button",
                {"type": "button", "data-example": "6", "aria-pressed": "false", "id": "tab-6"},
                [txt("Combinators")],
            ), txt("\n"), el(
                "button",
                {"type": "button", "data-example": "7", "aria-pressed": "false", "id": "tab-7"},
                [txt("Capabilities")],
            ), txt("\n"), el(
                "button",
                {"type": "button", "data-example": "8", "aria-pressed": "false", "id": "tab-8"},
                [txt("Architect")],
            ), txt("\n")],
        ), txt("\n"), el(
            "label",
            {"class": "example-picker"},
            [el("span", {"class": "sr-only"}, [txt("Choose example")]), el(
                "select",
                {"id": "example-select"},
                [txt("\n"), el("option", {"value": "0"}, [txt("Typed data")]), txt("\n"), el(
                    "option",
                    {"value": "1"},
                    [txt("Collections")],
                ), txt("\n"), el("option", {"value": "2"}, [txt("Pattern matching")]), txt("\n"), el(
                    "option",
                    {"value": "3"},
                    [txt("Enums")],
                ), txt("\n"), el("option", {"value": "4"}, [txt("Optional values")]), txt("\n"), el(
                    "option",
                    {"value": "5"},
                    [txt("Error handling")],
                ), txt("\n"), el("option", {"value": "6"}, [txt("Combinators")]), txt("\n"), el(
                    "option",
                    {"value": "7"},
                    [txt("Capabilities")],
                ), txt("\n"), el("option", {"value": "8"}, [txt("Architect")]), txt("\n")],
            )],
        ), txt("\n"), el(
            "div",
            {"class": "example-controls"},
            [txt("\n          "), el(
                "span",
                {"class": "example-count", "aria-hidden": "true", "id": "example-count"},
                [txt("01 / 09")],
            ), txt("\n          "), el(
                "button",
                {"class": "example-previous", "type": "button", "aria-label": "Previous example", "id": "example-previous"},
                [el("span", {"class": "icon arrow", "aria-hidden": "true"}, [])],
            ), txt("\n          "), el(
                "button",
                {"class": "tour-toggle", "type": "button", "aria-label": "Pause example rotation", "id": "tour-toggle"},
                [txt("Pause")],
            ), txt("\n          "), el(
                "button",
                {"class": "example-next", "type": "button", "aria-label": "Next example", "id": "example-next"},
                [el("span", {"class": "icon arrow", "aria-hidden": "true"}, [])],
            ), txt("\n        ")],
        ), txt("\n      ")],
    )


pub def rust_context() -> DocumentNode:
    return el(
        "div",
        {"class": "rust-context"},
        [el("strong", {}, [txt("Incan and Rust. One project.")]), el(
            "p",
            {},
            [txt("Incan and Rust code live side by side in Oven-managed projects. Use each where it fits.")],
        ), el(
            "a",
            {"href": "https://incan.io/dev/language/tutorials/add_a_rust_crate/"},
            [txt("Explore Rust interop "), el("span", {"class": "icon arrow", "aria-hidden": "true"}, [])],
        )],
    )
