pub def run_section() -> DocumentNode:
    return el(
        "section",
        {"class": "run-section ruled", "id": "start", "aria-labelledby": "run-heading"},
        [txt("\n      "), el(
            "div",
            {"class": "run-copy"},
            [el("h2", {"id": "run-heading"}, [txt("Make something run.")]), txt("\n      "), el(
                "p",
                {"class": "section-lead"},
                [txt("Create a project. Run it. Test it. Build a native binary.")],
            )],
        ), txt("\n      "), el(
            "div",
            {"class": "code-panel terminal-panel"},
            [txt("\n        "), el(
                "div",
                {"class": "panel-heading"},
                [el(
                    "span",
                    {"class": "file-label"},
                    [el("span", {"class": "icon terminal", "aria-hidden": "true"}, []), txt("Terminal")],
                ), el(
                    "button",
                    {"class": "copy-button", "type": "button", "data-copy": "terminal-example", "aria-label": "Copy project commands", "id": "copy-terminal"},
                    [el("span", {"class": "icon copy", "aria-hidden": "true", "id": "copy-icon-terminal"}, []), el(
                        "span",
                        {"class": "copy-label", "id": "copy-label-terminal"},
                        [txt("Copy")],
                    )],
                )],
            ), txt("\n        "), el(
                "pre",
                {"class": "terminal-code", "tabindex": "0", "aria-label": "First project commands"},
                [el(
                    "code",
                    {"id": "terminal-example"},
                    [el(
                        "span",
                        {"class": "command"},
                        [el("span", {"class": "executable"}, [txt("incan new")]), txt(" "), el(
                            "span",
                            {"class": "function"},
                            [txt("hello")],
                        ), txt(" --yes")],
                    ), txt("\n"), el("span", {"class": "command"}, [txt("cd hello")]), txt("\n"), el(
                        "span",
                        {"class": "command"},
                        [txt("incan oven bake --project .")],
                    ), txt("\n"), el(
                        "span",
                        {"class": "command"},
                        [el("span", {"class": "executable"}, [txt("incan run")])],
                    ), txt("\n"), el(
                        "span",
                        {"class": "command"},
                        [el("span", {"class": "executable"}, [txt("incan test")])],
                    ), txt("\n"), el(
                        "span",
                        {"class": "command"},
                        [el("span", {"class": "executable"}, [txt("incan build")]), txt(" --release")],
                    )],
                )],
            ), txt("\n      ")],
        ), txt("\n    ")],
    )


