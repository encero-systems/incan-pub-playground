                {"class": "welcome-copy"},
                [txt("\n        "), el(
                    "h1",
                    {"id": "welcome-heading", "aria-label": "Welcome to Incan."},
                    [el("span", {"class": "welcome-prefix"}, [txt("Welcome to")]), el(
