"""Approved Incapunk 2.0 components, authored as structured Incan nodes."""

from pub::pallay import DocumentNode
from components import el, txt


pub def site_header() -> DocumentNode:
    return el(
        "header",
        {"class": "site-header"},
        [txt("\n    "), el(
            "div",
            {"class": "masthead wrap"},
            [txt("\n      "), el(
                "a",
                {"class": "brand", "href": "#welcome", "aria-label": "Incan home"},
                [txt("\n        "), el(
                    "img",
                    {"class": "brand-lockup", "src": "assets/brand-source.png", "alt": "Incan", "width": "759", "height": "244"},
                    [],
                ), txt("\n      ")],
            ), txt("\n      "), el(
                "button",
                {"class": "menu-toggle", "type": "button", "aria-expanded": "false", "aria-controls": "site-nav", "id": "menu-button"},
                [el("span", {"class": "icon menu-icon", "aria-hidden": "true"}, []), el("span", {}, [txt("Menu")])],
            ), txt("\n      "), el(
                "nav",
                {"id": "site-nav", "aria-label": "Main navigation"},
                [txt("\n        "), el("a", {"href": "https://incan.io/dev/start_here/"}, [txt("Learn")]), txt(
                    "\n        ",
                ), el("a", {"href": "docs/index.html"}, [txt("Docs")]), txt("\n        "), el(
                    "a",
                    {"href": "oven.html"},
                    [txt("Oven")],
                ), txt("\n        "), el(
                    "a",
                    {"href": "https://encero-systems.github.io/incan-pub-playground/"},
                    [txt("Incan.pub")],
                ), txt("\n        "), el("a", {"href": "#project"}, [txt("Project")]), txt("\n      ")],
            ), txt("\n      "), el(
                "form",
                {"class": "header-search", "action": "https://incan.io/dev/", "role": "search"},
                [txt("\n        "), el(
                    "label",
                    {"class": "sr-only", "for": "docs-query"},
                    [txt("Search Incan documentation")],
                ), txt("\n        "), el(
                    "input",
                    {"id": "docs-query", "type": "search", "name": "q", "placeholder": "Search docs…", "autocomplete": "off"},
                    [],
                ), txt("\n        "), el("button", {"type": "submit"}, [txt("Search")]), txt("\n      ")],
            ), txt("\n      "), el(
                "a",
                {"class": "release-status", "href": "https://incan.io/dev/roadmap/"},
                [txt("Preview · 0.6")],
            ), txt("\n    ")],
        ), txt("\n  ")],
    )


