"""Documentation shell sharing the approved homepage identity and visual language."""

from pub::pallay import DocumentNode
from components import el, txt
from layout import site_header, site_footer
from markdown_docs import DocPage
from docs_catalog import (
    ContentCatalog,
    navigation,
    landing,
    section_for,
    section_title,
    catalog_stylesheet,
    page_type,
    type_badge,
    module_tabs,
    module_for,
)


pub def local_shell(original: DocumentNode) -> DocumentNode:
    mut node = original
    if node.tag == "button" and "id" in node.attributes and node.attributes["id"] == "menu-button":
        return el("a", {"class": "menu-toggle", "href": "#docs-navigation"}, [txt("Browse docs ↓")])
    for key in ["src", "href"]:
        if key in node.attributes:
            value = node.attributes[key]
            if value.startswith("assets/"):
                node.attributes[key] = "../" + value
            elif key == "href" and value == "media.html":
                node.attributes[key] = "../media.html"
            elif key == "href" and value == "#welcome":
                node.attributes[key] = "../#welcome"
            elif key == "href" and value == "#project":
                node.attributes[key] = "../#project"
            elif value == "https://incan.io/dev/start_here/":
                node.attributes[key] = "nav-learn.html"
            elif value == "https://incan.io/dev/tooling/explanation/oven_alpha/":
                node.attributes[key] = "nav-oven.html"
            elif value == "https://incan.io/dev/language/" or value == "docs/index.html":
                node.attributes[key] = "index.html"
    mut children: list[DocumentNode] = []
    for child in node.children:
        children.append(local_shell(child))
    node.children = children
    return node


pub def shell(
    page: DocPage,
    article: list[DocumentNode],
    headings: list[DocumentNode],
    catalog: ContentCatalog,
) -> DocumentNode:
    section = section_for(page.key, catalog)
    mut section_url = "index.html"
    if section != "":
        section_url = "nav-" + section + ".html"
    mut breadcrumb = [el("a", {"href": "index.html"}, [txt("Docs")]), el(
        "a",
        {"href": section_url},
        [txt(" / " + section_title(section, catalog))],
    )]
    module_key = module_for(page.key, catalog)
    if module_key != "":
        breadcrumb.append(el("a", {"href": "module-" + module_key + ".html"}, [txt(" / std." + module_key)]))
        if page.key != "module-" + module_key:
            breadcrumb.append(txt(" / " + page_type(page.key, catalog)))
    mut source_url = "content-map.json"
    if page.source != "":
        source_url = "sources/" + page.source
    mut toc: list[DocumentNode] = [el("p", {"class": "docs-eyebrow"}, [txt("On this page")])]
    for heading in headings:
        toc.append(heading)
    toc.append(el("a", {"class": "docs-top", "href": "#main"}, [txt("Back to top ↑")]))
    return el(
        "div",
        {"class": "docs-page"},
        [el("a", {"class": "docs-skip", "href": "#main"}, [txt("Skip to content")]), local_shell(site_header()), el(
            "div",
            {"class": "docs-layout wrap"},
            [navigation(page.key, catalog), el(
                "main",
                {"id": "main", "class": "doc-article", "tabindex": "-1"},
                [el("div", {"class": "doc-breadcrumb"}, breadcrumb)] + [el(
                    "details",
                    {"class": "docs-mobile-toc"},
                    [el("summary", {}, [txt("On this page")]), el(
                        "nav",
                        {"aria-label": "On this page, compact"},
                        headings,
                    )],
                )] + [el("p", {"class": "doc-type-line"}, [type_badge(page_type(page.key, catalog))])] + module_tabs(
                    page.key,
                    catalog,
                ) + article + [el(
                    "div",
                    {"class": "doc-source"},
                    [txt("Incan documentation · "), el("a", {"href": source_url}, [txt("Page source ↓")])],
                ), el(
                    "nav",
                    {"class": "doc-next", "aria-label": "More documentation"},
                    [el("a", {"href": "index.html"}, [txt("← Documentation overview")]), el(
                        "a",
                        {"href": "https://incan.io/dev/"},
                        [txt("Continue on the docsite ↗")],
                    )],
                )],
            ), el("aside", {"class": "docs-toc"}, [el("nav", {"aria-label": "On this page"}, toc)])],
        ), local_shell(site_footer())],
    )


pub def overview(catalog: ContentCatalog) -> DocumentNode:
    page = DocPage(key="index", title="Documentation", group="Welcome", source="", description="")
    return shell(page, landing(catalog), [], catalog)


pub def docs_stylesheet() -> str:
    return "\n.docs-layout{display:grid;grid-template-columns:208px minmax(0,760px) 188px;gap:44px;align-items:start;padding-block:50px 72px;max-width:1360px}\n.docs-sidebar,.docs-toc{position:sticky;top:118px;font-size:13px;max-height:calc(100vh - 145px);overflow:auto}\n.docs-overview{font-size:18px;font-weight:650;color:var(--gold-bright);display:block;margin-bottom:25px}\n.docs-sidebar ul{list-style:none;padding:0;margin:0}.docs-sidebar li{margin:0 0 24px}.docs-sidebar small{display:block;color:var(--quiet);font-size:10px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:6px}\n.docs-sidebar li a{display:block;border-left:2px solid transparent;padding:5px 10px;color:var(--muted)}.docs-sidebar a:hover,.docs-toc a:hover{color:var(--cyan)}\n.docs-sidebar a[aria-current]{border-color:var(--cyan);background:#42e8ef0a;color:var(--text)}.docs-all{color:var(--cyan);display:block;margin-top:30px}.docs-snapshot{font-size:11px;color:var(--quiet);line-height:1.7;border-top:1px solid var(--outline);padding-top:18px;margin-top:24px}\n.doc-article{min-width:0;font-size:16px;line-height:1.78;color:#d1d8d2}.doc-article h1{font-size:clamp(32px,3vw,44px);line-height:1.15;white-space:normal;color:var(--gold-bright);margin:0 0 26px;font-weight:650;letter-spacing:-.035em}\n.doc-breadcrumb{color:var(--quiet);font-size:12px;margin:0 0 24px}.doc-breadcrumb a{color:var(--cyan)}\n.doc-article h2{font-size:26px;color:var(--gold);margin:44px 0 18px;line-height:1.25;scroll-margin-top:110px}.doc-article h3{font-size:20px;color:var(--gold-bright);margin:30px 0 12px;line-height:1.3;scroll-margin-top:110px}.doc-article h4{color:var(--gold-bright);font-size:17px;scroll-margin-top:110px}\n.doc-article p{margin:0 0 18px}.doc-article strong{color:var(--text);font-weight:650}.doc-article a{color:var(--cyan);text-decoration:underline;text-decoration-color:#42e8ef45;text-underline-offset:3px}.doc-article a:hover{text-decoration-color:var(--cyan)}\n.doc-article ul,.doc-article ol{padding-left:25px;margin:16px 0 24px}.doc-article li{padding-left:3px;margin-block:7px}.doc-article li::marker{color:var(--gold)}\n.doc-article code{font-family:var(--mono);font-size:.84em;padding:2px 5px;border:1px solid #293b3280;background:#111b15;border-radius:4px;color:#e8ddad;overflow-wrap:anywhere}\n.doc-article pre{max-width:100%;overflow:auto;background:linear-gradient(130deg,#101a14,#080e0b);border:1px solid var(--outline);border-left:2px solid #927843;border-radius:6px;padding:22px;margin:22px 0 28px;line-height:1.65;tab-size:4}\n.doc-article pre code{display:block;white-space:pre;overflow-wrap:normal;background:none;border:0;padding:0;color:#dfe6df;font-size:13px}\n.doc-token-keyword{color:#e6a2f0}.doc-token-type{color:#62e5e9}.doc-token-string{color:#e0d995}.doc-token-comment{color:#8d9e92;font-style:italic}\n.doc-article blockquote{border-left:2px solid var(--gold);margin:24px 0;padding:14px 24px;background:#ffd06b08;color:var(--gold-bright)}.doc-article blockquote p:last-child{margin:0}\n.doc-table-wrap{max-width:100%;overflow:auto;margin:24px 0;border:1px solid var(--outline);border-radius:6px}.doc-article table{border-collapse:collapse;width:100%;font-size:13px;line-height:1.65;min-width:450px}.doc-article th{background:#132018;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--gold-bright)}.doc-article th,.doc-article td{padding:13px 16px;border-bottom:1px solid var(--outline);vertical-align:top}.doc-article tr:last-child td{border-bottom:0}.doc-article td code{font-size:11px}\n.doc-callout{border:1px solid #35514b;border-radius:6px;margin:26px 0;background:#42e8ef04;overflow:hidden}.doc-callout summary{cursor:pointer;padding:15px 20px;color:var(--cyan);font-size:14px;font-weight:600;background:#42e8ef08}.doc-callout summary:focus-visible{outline:2px solid var(--cyan);outline-offset:-3px}.doc-callout> :not(summary){margin-left:20px;margin-right:20px}.doc-callout>summary+p{margin-top:20px}.doc-callout> :last-child{margin-bottom:20px}\n.doc-language-panel{margin:20px 0;border-top:1px solid var(--outline)}.doc-language-panel .doc-panel-label{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--gold);padding-top:12px;margin-bottom:6px}.doc-language-panel pre{margin-top:8px}\n.docs-eyebrow{font-size:10px;color:var(--quiet);text-transform:uppercase;letter-spacing:.16em;margin-bottom:16px!important}.docs-toc a{display:block;font-size:11px;color:var(--muted);line-height:1.6;margin:0 0 12px;border-left:1px solid var(--outline);padding-left:12px}.docs-toc .toc-h3{padding-left:23px;font-size:10px;color:var(--quiet)}.docs-toc .docs-top{margin-top:24px;color:var(--cyan)}\n.doc-source{border-top:1px solid var(--outline);margin-top:40px;padding-top:18px;font-size:11px;color:var(--quiet)}.doc-next{display:flex;justify-content:space-between;gap:20px;margin-top:26px;font-size:12px}.doc-article hr{border:0;border-top:1px solid var(--outline);margin:38px 0}\n.doc-article .doc-lead{font-size:18px;color:var(--muted);max-width:620px}.docs-cards{display:grid;gap:16px;margin:32px 0}.doc-article .docs-card{display:block;text-decoration:none;border:1px solid var(--outline);background:linear-gradient(120deg,#142018,#0b110e);border-radius:7px;padding:24px}.docs-card:hover{border-color:#568073}.docs-card small{color:var(--quiet);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.docs-card h2{margin:10px 0 12px}.docs-card p{font-size:14px;color:var(--muted)}.docs-card span{font-size:12px;color:var(--cyan)}.doc-import-note{font-size:13px;border-top:1px solid var(--outline);margin-top:40px}.doc-import-note h2{font-size:20px}\n.docs-skip{position:fixed;top:8px;left:8px;z-index:30;padding:12px;background:var(--panel);color:var(--cyan);transform:translateY(-200%)}.docs-skip:focus{transform:none}\n@media(max-width:1250px){.docs-layout{grid-template-columns:175px minmax(0,1fr);gap:32px}.docs-toc{display:none}}\n@media(max-width:740px){.docs-layout{display:flex;flex-direction:column;padding-top:28px;gap:28px}.docs-sidebar{position:static;max-height:none;width:100%;font-size:12px;border-bottom:1px solid var(--outline);padding-bottom:20px}.docs-overview{margin-bottom:12px}.docs-sidebar ul{display:flex;gap:10px;flex-wrap:wrap}.docs-sidebar li{margin:0}.docs-sidebar small,.docs-snapshot,.docs-all{display:none}.docs-sidebar li a{border:1px solid var(--outline);border-radius:4px;padding:6px 9px}.docs-sidebar a[aria-current]{border-color:#42e8ef70}.doc-article{width:100%;font-size:15px}.doc-article h1{font-size:34px}.doc-article h2{font-size:24px}.doc-article pre{padding:16px}.doc-next{flex-wrap:wrap}.docs-page .menu-toggle{display:inline-flex;font-size:11px;white-space:nowrap}.docs-page .release-status{display:none}}\n\n/* Imported tutorial semantics and architecture reading paths. */\n.inc-tutorial-meta{border:1px solid var(--outline);border-radius:6px;padding:18px 22px;background:#ffffff03;margin:24px 0}.inc-tutorial-meta dl{margin:0}.inc-tutorial-meta dl>div{display:grid;grid-template-columns:105px minmax(0,1fr);gap:14px;padding:7px 0;border-bottom:1px solid #293b3260}.inc-tutorial-meta dl>div:last-child{border:0}.inc-tutorial-meta dt{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--quiet);padding-top:3px}.inc-tutorial-meta dd{margin:0;font-size:13px;color:var(--muted)}\n.doc-article .inc-step-rail{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:0;list-style:none;margin:26px 0}.inc-step-rail li{border-top:2px solid #a58b4b;padding:10px 8px 0!important;font-size:11px;color:var(--muted)}.inc-step-rail strong{display:block;font-size:13px;color:var(--gold-bright);margin-bottom:4px}\n.inc-learning-panel{border-left:2px solid var(--cyan);background:#42e8ef07;padding:20px 24px;margin:26px 0;border-radius:0 6px 6px 0}.inc-learning-panel::before{content:attr(data-label);display:block;font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:var(--cyan);margin-bottom:12px}.inc-learning-panel p:last-child{margin:0}.inc-learning-panel--complete{border-color:var(--gold);background:#ffcd6808}.inc-learning-panel--complete::before{color:var(--gold)}\n.doc-diagram{border:1px solid var(--outline);padding:22px;border-radius:7px;background:#101b14;margin:26px 0;max-width:100%;overflow:auto}.doc-diagram-canvas{min-width:0;white-space:pre-wrap;font:12px var(--mono);overflow:auto}.doc-diagram-canvas[data-render-state=ready]{font-family:var(--body);white-space:normal}.doc-diagram-canvas svg{display:block;max-width:100%;height:auto;margin:auto}.doc-diagram-source{margin-top:14px;border-top:1px solid var(--outline);padding-top:12px;font-size:11px;color:var(--quiet)}.doc-diagram-source summary{cursor:pointer}.doc-diagram-source pre{margin-bottom:0}.inc-diagram-caption{font-size:12px;color:var(--quiet);text-align:center;margin-top:-12px!important}\n.doc-article section[data-footnotes]{border-top:1px solid var(--outline);margin-top:40px;padding-top:18px;font-size:12px}.doc-article sup a{font-size:10px;border:1px solid var(--outline);padding:0 3px;border-radius:3px;text-decoration:none}\n.arch-start{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:30px 0 38px}.doc-article .arch-start a{text-decoration:none;border-top:1px solid #9b8244;padding-top:14px}.arch-start small{font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:var(--quiet);display:block}.arch-start strong{display:block;font-size:16px;color:var(--gold-bright);margin:7px 0}.arch-start span{display:block;font-size:12px;color:var(--muted);line-height:1.6}\n.arch-build-steps{list-style:none!important;counter-reset:build-step;margin:28px 0!important;padding:0!important}.arch-build-steps li{position:relative;padding:0 0 18px 42px!important;border-left:1px solid #6c603b;margin:0 0 0 12px!important;counter-increment:build-step}.arch-build-steps li:last-child{border-color:transparent}.arch-build-steps li::before{content:counter(build-step,decimal-leading-zero);position:absolute;left:-12px;top:0;background:var(--ink);color:var(--gold);font:11px/26px var(--mono);padding-right:8px}.arch-build-steps strong{font-size:16px}.arch-build-steps p{font-size:13px;color:var(--muted);margin:6px 0 0!important;line-height:1.7}\n.arch-module-map{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 30px;margin:26px 0}.arch-module{border-left:2px solid #50746b;padding-left:16px}.arch-module strong{color:var(--gold-bright);font-size:15px}.arch-module p{font-size:12px;color:var(--muted);margin:6px 0 0;line-height:1.7}.arch-original,.arch-glossary{border:1px solid var(--outline);border-radius:5px;padding:13px 16px;color:var(--muted);font-size:12px;margin:18px 0}.arch-original summary,.arch-glossary summary{cursor:pointer}.arch-original pre{margin-bottom:3px}.arch-glossary .doc-table-wrap{margin-bottom:4px}\n.docs-mobile-toc{display:none}\n@media(max-width:1250px){.docs-mobile-toc{display:block;border-bottom:1px solid var(--outline);padding:12px 0;margin-bottom:26px;font-size:12px;color:var(--muted)}.docs-mobile-toc summary{cursor:pointer;color:var(--cyan)}.docs-mobile-toc nav{display:grid;gap:10px;max-height:45vh;overflow:auto;padding-block:15px}.docs-mobile-toc nav a{text-decoration:none}.docs-mobile-toc .toc-h3{padding-left:15px;font-size:11px}}\n@media(max-width:740px){.arch-start{grid-template-columns:1fr;gap:15px;margin-top:25px}.arch-start span{font-size:12px}.arch-module-map{grid-template-columns:1fr;gap:18px}.doc-diagram{padding:12px}.doc-diagram-canvas svg{min-width:450px}.inc-tutorial-meta{padding:12px}.inc-tutorial-meta dl>div{grid-template-columns:80px minmax(0,1fr);gap:10px}.inc-tutorial-meta dd{font-size:12px}.doc-article .inc-step-rail{grid-template-columns:repeat(2,minmax(0,1fr))}.inc-learning-panel{padding:16px}.docs-sidebar ul{gap:7px}.docs-sidebar li a{font-size:11px;padding:4px 8px}.arch-original{padding:10px}}\n\n.docs-previous{border-top:1px solid var(--outline);padding-top:16px;margin-top:20px;color:var(--quiet)}\n.docs-previous summary{cursor:pointer;font-size:12px;margin-bottom:18px}\n@media(max-width:740px){.docs-previous{margin-top:12px;padding-top:12px}.docs-previous summary{margin-bottom:8px}}\n" + catalog_stylesheet()
