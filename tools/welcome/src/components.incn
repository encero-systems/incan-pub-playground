"""Small reusable document components over Pallay's validated tree."""

from pub::pallay import DocumentNode, element, content


pub def el(tag: str, attributes: Dict[str, str], children: list[DocumentNode]) -> DocumentNode:
    return element(tag, attributes, children)


pub def txt(value: str) -> DocumentNode:
    return content(value)


pub def icon(name: str, identity: str = "") -> DocumentNode:
    mut attributes = {"class": "icon " + name, "aria-hidden": "true"}
    if identity != "":
        attributes["id"] = identity
    return el("span", attributes, [])
