"""Markdown content adapter: standard parsing via markdown-rs, docsite policy in Incan."""

from rust::markdown import to_html_with_options, Options
from std.fs import Path
from pub::pallay import DocumentNode, parse_template
from components import el, txt


pub model DocPage:
    pub key: str
    pub title: str
    pub group: str
    pub source: str
    pub description: str


