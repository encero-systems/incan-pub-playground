"""The nine authored examples and their explanation points; no browser controller."""


pub model Note:
    pub line: str
    pub anchor: str
    pub title: str
    pub description: str


pub model CodeExample:
    pub key: str
    pub filename: str
    pub label: str
    pub markup: str
    pub notes: list[Note]
    pub caption: str
    pub language: str
    pub line_count: int


pub def catalog() -> list[CodeExample]:
    return [CodeExample(
        key="hello",
        filename="hello.incn",
        label="Typed data",
        markup="<span class=\"line\" id=\"line-hello-1\"><span id=\"named-data\"><span class=\"keyword\">model</span> User:</span></span>\n<span class=\"line\" id=\"line-hello-2\"><span id=\"anchor-hello-0\">    name: <span class=\"type\">str</span></span></span>\n<span class=\"line\" id=\"line-hello-3\"> </span>\n<span class=\"line\" id=\"line-hello-4\"><span id=\"typed-functions\"><span class=\"keyword\">def</span> <span class=\"function\">greet_user</span>(user: User) -&gt; <span class=\"type\">str</span>:</span></span>\n<span class=\"line\" id=\"line-hello-5\"><span id=\"anchor-hello-1\">    <span class=\"keyword\">return</span> <span class=\"string\">f&quot;Hello, {user.name}!&quot;</span></span></span>\n<span class=\"line\" id=\"line-hello-6\"> </span>\n<span class=\"line\" id=\"line-hello-7\"><span id=\"clear-structure\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span></span>\n<span class=\"line\" id=\"line-hello-8\"><span id=\"anchor-hello-2\">    user = User(name=<span class=\"string\">&quot;Incan&quot;</span>)</span></span>\n<span class=\"line\" id=\"line-hello-9\">    <span class=\"function\">println</span>(<span class=\"function\">greet_user</span>(user))</span>",
        notes=[Note(
            line="line-hello-2",
            anchor="anchor-hello-0",
            title="Named data.",
            description="Define data with clear types.",
        ), Note(
            line="line-hello-5",
            anchor="anchor-hello-1",
            title="Typed functions.",
            description="Functions declare their input and output types.",
        ), Note(
            line="line-hello-8",
            anchor="anchor-hello-2",
            title="Clear structure.",
            description="A simple, familiar program structure.",
        )],
        caption="Complete Incan example",
        language="incan",
        line_count=9,
    ), CodeExample(
        key="collections",
        filename="collections.incn",
        label="Collections",
        markup="<span class=\"line\" id=\"line-collections-1\"><span id=\"anchor-collections-0\"><span class=\"keyword\">def</span> <span class=\"function\">evens</span>(xs: <span class=\"type\">List</span>[<span class=\"type\">int</span>]) -&gt; <span class=\"type\">List</span>[<span class=\"type\">int</span>]:</span></span>\n<span class=\"line\" id=\"line-collections-2\">    <span class=\"keyword\">return</span> [</span>\n<span class=\"line\" id=\"line-collections-3\"><span id=\"anchor-collections-1\">        x * x <span class=\"keyword\">for</span> x <span class=\"keyword\">in</span> xs <span class=\"keyword\">if</span> x % <span class=\"number\">2</span> == <span class=\"number\">0</span></span></span>\n<span class=\"line\" id=\"line-collections-4\">    ]</span>\n<span class=\"line\" id=\"line-collections-5\"> </span>\n<span class=\"line\" id=\"line-collections-6\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-collections-7\"><span id=\"anchor-collections-2\">    squares = <span class=\"function\">evens</span>([<span class=\"number\">1</span>, <span class=\"number\">2</span>, <span class=\"number\">3</span>, <span class=\"number\">4</span>, <span class=\"number\">5</span>, <span class=\"number\">6</span>])</span></span>\n<span class=\"line\" id=\"line-collections-8\">    first = squares[<span class=\"number\">0</span>]</span>\n<span class=\"line\" id=\"line-collections-9\">    <span class=\"function\">println</span>(<span class=\"string\">f&quot;First square: {first}&quot;</span>)</span>",
        notes=[Note(
            line="line-collections-1",
            anchor="anchor-collections-0",
            title="Typed collections.",
            description="A list of integers goes in and comes out.",
        ), Note(
            line="line-collections-3",
            anchor="anchor-collections-1",
            title="Filter and transform.",
            description="Keep even numbers and square each one.",
        ), Note(
            line="line-collections-7",
            anchor="anchor-collections-2",
            title="Reusable functions.",
            description="Call the function with ordinary data.",
        )],
        caption="Complete Incan example",
        language="incan",
        line_count=9,
    ), CodeExample(
        key="matching",
        filename="matching.incn",
        label="Pattern matching",
        markup="<span class=\"line\" id=\"line-matching-1\"><span class=\"keyword\">def</span> <span class=\"function\">describe</span>(code: <span class=\"type\">int</span>) -&gt; <span class=\"type\">str</span>:</span>\n<span class=\"line\" id=\"line-matching-2\"><span id=\"anchor-matching-0\">    <span class=\"keyword\">match</span> code:</span></span>\n<span class=\"line\" id=\"line-matching-3\"><span id=\"anchor-matching-1\">        <span class=\"keyword\">case</span> <span class=\"number\">200</span>:</span></span>\n<span class=\"line\" id=\"line-matching-4\">            <span class=\"keyword\">return</span> <span class=\"string\">&quot;Ready&quot;</span></span>\n<span class=\"line\" id=\"line-matching-5\">        <span class=\"keyword\">case</span> _:</span>\n<span class=\"line\" id=\"line-matching-6\"><span id=\"anchor-matching-2\">            <span class=\"keyword\">return</span> <span class=\"string\">&quot;Try again&quot;</span></span></span>\n<span class=\"line\" id=\"line-matching-7\"> </span>\n<span class=\"line\" id=\"line-matching-8\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-matching-9\">    <span class=\"function\">println</span>(<span class=\"function\">describe</span>(<span class=\"number\">200</span>))</span>",
        notes=[Note(
            line="line-matching-2",
            anchor="anchor-matching-0",
            title="Pattern matching.",
            description="Choose a branch from the value.",
        ), Note(
            line="line-matching-3",
            anchor="anchor-matching-1",
            title="Specific cases.",
            description="Handle a known value explicitly.",
        ), Note(
            line="line-matching-6",
            anchor="anchor-matching-2",
            title="A fallback.",
            description="The wildcard handles the remaining values.",
        )],
        caption="Complete Incan example",
        language="incan",
        line_count=9,
    ), CodeExample(
        key="enums",
        filename="enums.incn",
        label="Enums",
        markup="<span class=\"line\" id=\"line-enums-1\"><span class=\"keyword\">enum</span> <span class=\"type\">Message</span>:</span>\n<span class=\"line\" id=\"line-enums-2\"><span id=\"anchor-enums-0\">    Text(<span class=\"type\">str</span>)</span></span>\n<span class=\"line\" id=\"line-enums-3\">    Quit</span>\n<span class=\"line\" id=\"line-enums-4\"> </span>\n<span class=\"line\" id=\"line-enums-5\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-enums-6\"><span id=\"anchor-enums-1\">    message = <span class=\"type\">Message</span>.Text(<span class=\"string\">&quot;Hello&quot;</span>)</span></span>\n<span class=\"line\" id=\"line-enums-7\">    <span class=\"keyword\">match</span> message:</span>\n<span class=\"line\" id=\"line-enums-8\"><span id=\"anchor-enums-2\">        <span class=\"keyword\">case</span> <span class=\"type\">Message</span>.Text(text):</span></span>\n<span class=\"line\" id=\"line-enums-9\">            <span class=\"function\">println</span>(text)</span>\n<span class=\"line\" id=\"line-enums-10\">        <span class=\"keyword\">case</span> <span class=\"type\">Message</span>.Quit:</span>\n<span class=\"line\" id=\"line-enums-11\">            <span class=\"function\">println</span>(<span class=\"string\">&quot;Goodbye&quot;</span>)</span>",
        notes=[Note(
            line="line-enums-2",
            anchor="anchor-enums-0",
            title="Data-bearing variants.",
            description="A variant can carry a value with it.",
        ), Note(
            line="line-enums-6",
            anchor="anchor-enums-1",
            title="Construct a value.",
            description="Choose a variant and supply its data.",
        ), Note(
            line="line-enums-8",
            anchor="anchor-enums-2",
            title="Unpack the variant.",
            description="Match the variant to access its text.",
        )],
        caption="Complete Incan example",
        language="incan",
        line_count=11,
    ), CodeExample(
        key="optional",
        filename="optional.incn",
        label="Optional values",
        markup="<span class=\"line\" id=\"line-optional-1\"><span id=\"anchor-optional-0\"><span class=\"keyword\">def</span> <span class=\"function\">greet</span>(name: <span class=\"type\">Option</span>[<span class=\"type\">str</span>]) -&gt; <span class=\"type\">str</span>:</span></span>\n<span class=\"line\" id=\"line-optional-2\">    <span class=\"keyword\">match</span> name:</span>\n<span class=\"line\" id=\"line-optional-3\"><span id=\"anchor-optional-1\">        <span class=\"keyword\">case</span> <span class=\"type\">Some</span>(value):</span></span>\n<span class=\"line\" id=\"line-optional-4\">            <span class=\"keyword\">return</span> <span class=\"string\">f&quot;Hello, {value}&quot;</span></span>\n<span class=\"line\" id=\"line-optional-5\"><span id=\"anchor-optional-2\">        <span class=\"keyword\">case</span> <span class=\"type\">None</span>:</span></span>\n<span class=\"line\" id=\"line-optional-6\">            <span class=\"keyword\">return</span> <span class=\"string\">&quot;Hello, stranger&quot;</span></span>\n<span class=\"line\" id=\"line-optional-7\"> </span>\n<span class=\"line\" id=\"line-optional-8\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-optional-9\">    <span class=\"function\">println</span>(<span class=\"function\">greet</span>(<span class=\"type\">Some</span>(<span class=\"string\">&quot;Incan&quot;</span>)))</span>",
        notes=[Note(
            line="line-optional-1",
            anchor="anchor-optional-0",
            title="Explicit absence.",
            description="Option describes a value that may be missing.",
        ), Note(
            line="line-optional-3",
            anchor="anchor-optional-1",
            title="A present value.",
            description="Some carries the name into this branch.",
        ), Note(
            line="line-optional-5",
            anchor="anchor-optional-2",
            title="Handle absence.",
            description="None has its own path and greeting.",
        )],
        caption="Complete Incan example",
        language="incan",
        line_count=9,
    ), CodeExample(
        key="results",
        filename="results.incn",
        label="Error handling",
        markup="<span class=\"line\" id=\"line-results-1\"><span id=\"anchor-results-0\"><span class=\"keyword\">def</span> <span class=\"function\">checked</span>(n: <span class=\"type\">int</span>) -&gt; <span class=\"type\">Result</span>[<span class=\"type\">int</span>, <span class=\"type\">str</span>]:</span></span>\n<span class=\"line\" id=\"line-results-2\">    <span class=\"keyword\">if</span> n &lt;= <span class=\"number\">0</span>:</span>\n<span class=\"line\" id=\"line-results-3\"><span id=\"anchor-results-1\">        <span class=\"keyword\">return</span> <span class=\"type\">Err</span>(<span class=\"string\">&quot;Must be positive&quot;</span>)</span></span>\n<span class=\"line\" id=\"line-results-4\">    <span class=\"keyword\">return</span> <span class=\"type\">Ok</span>(n)</span>\n<span class=\"line\" id=\"line-results-5\"> </span>\n<span class=\"line\" id=\"line-results-6\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-results-7\">    <span class=\"keyword\">match</span> <span class=\"function\">checked</span>(<span class=\"number\">42</span>):</span>\n<span class=\"line\" id=\"line-results-8\"><span id=\"anchor-results-2\">        <span class=\"keyword\">case</span> <span class=\"type\">Ok</span>(value):</span></span>\n<span class=\"line\" id=\"line-results-9\">            <span class=\"function\">println</span>(value)</span>\n<span class=\"line\" id=\"line-results-10\">        <span class=\"keyword\">case</span> <span class=\"type\">Err</span>(message):</span>\n<span class=\"line\" id=\"line-results-11\">            <span class=\"function\">println</span>(message)</span>",
        notes=[Note(
            line="line-results-1",
            anchor="anchor-results-0",
            title="Explicit outcomes.",
            description="Result declares success and error types.",
        ), Note(
            line="line-results-3",
            anchor="anchor-results-1",
            title="Return an error.",
            description="Invalid input gets a meaningful error value.",
        ), Note(
            line="line-results-8",
            anchor="anchor-results-2",
            title="Handle both paths.",
            description="Match success or error at the call site.",
        )],
        caption="Complete Incan example",
        language="incan",
        line_count=11,
    ), CodeExample(
        key="combinators",
        filename="combinators.incn",
        label="Combinators",
        markup="<span class=\"line\" id=\"line-combinators-1\"><span class=\"keyword\">def</span> <span class=\"function\">positive</span>(score: <span class=\"type\">int</span>) -&gt; <span class=\"type\">bool</span>:</span>\n<span class=\"line\" id=\"line-combinators-2\">    <span class=\"keyword\">return</span> score &gt; <span class=\"number\">0</span></span>\n<span class=\"line\" id=\"line-combinators-3\"> </span>\n<span class=\"line\" id=\"line-combinators-4\"><span class=\"keyword\">def</span> <span class=\"function\">double</span>(score: <span class=\"type\">int</span>) -&gt; <span class=\"type\">int</span>:</span>\n<span class=\"line\" id=\"line-combinators-5\">    <span class=\"keyword\">return</span> score * <span class=\"number\">2</span></span>\n<span class=\"line\" id=\"line-combinators-6\"> </span>\n<span class=\"line\" id=\"line-combinators-7\"><span class=\"keyword\">def</span> <span class=\"function\">main</span>() -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-combinators-8\">    ready = [<span class=\"number\">3</span>, -<span class=\"number\">1</span>, <span class=\"number\">5</span>, <span class=\"number\">8</span>].<span class=\"function\">iter</span>()</span>\n<span class=\"line\" id=\"line-combinators-9\"><span id=\"anchor-combinators-0\">        .<span class=\"function\">filter</span>(<span class=\"function\">positive</span>)</span></span>\n<span class=\"line\" id=\"line-combinators-10\"><span id=\"anchor-combinators-1\">        .<span class=\"function\">map</span>(<span class=\"function\">double</span>)</span></span>\n<span class=\"line\" id=\"line-combinators-11\">        .<span class=\"function\">take</span>(<span class=\"number\">2</span>)</span>\n<span class=\"line\" id=\"line-combinators-12\"><span id=\"anchor-combinators-2\">        .<span class=\"function\">collect</span>()</span></span>\n<span class=\"line\" id=\"line-combinators-13\">    <span class=\"function\">println</span>(ready[<span class=\"number\">0</span>])</span>",
        notes=[Note(
            line="line-combinators-9",
            anchor="anchor-combinators-0",
            title="Keep the useful values.",
            description="Filter the input with a typed callback.",
        ), Note(
            line="line-combinators-10",
            anchor="anchor-combinators-1",
            title="Compose transformations.",
            description="Map each score without a separate loop.",
        ), Note(
            line="line-combinators-12",
            anchor="anchor-combinators-2",
            title="Choose when to collect.",
            description="Take two values, then materialize the result.",
        )],
        caption="Iterator composition \\u00b7 complete example",
        language="incan",
        line_count=13,
    ), CodeExample(
        key="capabilities",
        filename="capabilities.incn",
        label="Capabilities",
        markup="<span class=\"line\" id=\"line-capabilities-1\"><span class=\"keyword\">from</span> std.runtime <span class=\"keyword\">import</span> host</span>\n<span class=\"line\" id=\"line-capabilities-2\"> </span>\n<span class=\"line\" id=\"line-capabilities-3\"><span id=\"anchor-capabilities-0\"><span class=\"keyword\">capability</span> refund:</span></span>\n<span class=\"line\" id=\"line-capabilities-4\">    description = <span class=\"string\">&quot;Refund a charge&quot;</span></span>\n<span class=\"line\" id=\"line-capabilities-5\">    <span class=\"keyword\">scope</span>:</span>\n<span class=\"line\" id=\"line-capabilities-6\"><span id=\"anchor-capabilities-1\">        tenant: <span class=\"type\">str</span></span></span>\n<span class=\"line\" id=\"line-capabilities-7\">    requires = [host.http.request]</span>\n<span class=\"line\" id=\"line-capabilities-8\"> </span>\n<span class=\"line\" id=\"line-capabilities-9\"><span id=\"anchor-capabilities-2\">@<span class=\"function\">provider_operation</span>(refund)</span></span>\n<span class=\"line\" id=\"line-capabilities-10\"><span class=\"keyword\">pub</span> <span class=\"keyword\">def</span> <span class=\"function\">issue_refund</span>(charge_id: <span class=\"type\">str</span>) -&gt; <span class=\"type\">None</span>:</span>\n<span class=\"line\" id=\"line-capabilities-11\">    ...</span>",
        notes=[Note(
            line="line-capabilities-3",
            anchor="anchor-capabilities-0",
            title="Name the authority.",
            description="Declare a domain capability in source.",
        ), Note(
            line="line-capabilities-6",
            anchor="anchor-capabilities-1",
            title="Give it a scope.",
            description="A grant can constrain the tenant dimension.",
        ), Note(
            line="line-capabilities-9",
            anchor="anchor-capabilities-2",
            title="Connect the operation.",
            description="Declare the capability required by this provider operation.",
        )],
        caption="Capability declaration excerpt \\u00b7 0.6 / 0.7 preview",
        language="incan",
        line_count=11,
    ), CodeExample(
        key="architect",
        filename="architect.sh",
        label="Architect",
        markup="<span class=\"line\" id=\"line-architect-1\"><span class=\"comment\"># Review the project</span></span>\n<span class=\"line\" id=\"line-architect-2\"><span id=\"anchor-architect-0\">incan <span class=\"function\">architect</span> .</span></span>\n<span class=\"line\" id=\"line-architect-3\"> </span>\n<span class=\"line\" id=\"line-architect-4\"><span class=\"comment\"># Focus on architectural boundaries</span></span>\n<span class=\"line\" id=\"line-architect-5\">incan <span class=\"function\">architect</span> . \\</span>\n<span class=\"line\" id=\"line-architect-6\"><span id=\"anchor-architect-1\">    --profile architecture</span></span>\n<span class=\"line\" id=\"line-architect-7\"> </span>\n<span class=\"line\" id=\"line-architect-8\"><span class=\"comment\"># Machine-readable findings</span></span>\n<span class=\"line\" id=\"line-architect-9\">incan <span class=\"function\">architect</span> src/lib.incn \\</span>\n<span class=\"line\" id=\"line-architect-10\"><span id=\"anchor-architect-2\">    --format json</span></span>",
        notes=[Note(
            line="line-architect-2",
            anchor="anchor-architect-0",
            title="Review the project.",
            description="Ask Architect for evidence-backed findings.",
        ), Note(
            line="line-architect-6",
            anchor="anchor-architect-1",
            title="Choose your focus.",
            description="Narrow the review to architectural boundaries.",
        ), Note(
            line="line-architect-10",
            anchor="anchor-architect-2",
            title="Feed your tools.",
            description="Request structured findings for an editor or agent.",
        )],
        caption="Architect command sketch \\u00b7 0.7 preview",
        language="shell",
        line_count=10,
    )]
