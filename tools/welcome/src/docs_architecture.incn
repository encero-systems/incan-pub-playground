"""Reading paths through the 0.6 architecture draft; compiler design stays in Markdown."""

from pub::pallay import DocumentNode
from components import el, txt


def starting_points() -> DocumentNode:
    return el(
        "nav",
        {"class": "arch-start", "aria-label": "Architecture starting points"},
        [el(
            "a",
            {"href": "#the-native-compilation-path"},
            [el("small", {}, [txt("01 / Follow the program")]), el("strong", {}, [txt("Source to native code")]), el(
                "span",
                {},
                [txt("Incan, checked bodies and the pinned rustc.")],
            )],
        ), el(
            "a",
            {"href": "#who-owns-what"},
            [el("small", {}, [txt("02 / Find the boundary")]), el("strong", {}, [txt("Compiler, Oven, kernel")]), el(
                "span",
                {},
                [txt("Separate semantics from host mechanics.")],
            )],
        ), el(
            "a",
            {"href": "#what-must-be-proven"},
            [el("small", {}, [txt("03 / Check the evidence")]), el("strong", {}, [txt("The cutover contract")]), el(
                "span",
                {},
                [txt("What must be true before 0.6 ships.")],
            )],
        )],
    )


pub def architecture_document(root: DocumentNode) -> DocumentNode:
    mut children: list[DocumentNode] = []
    mut added = false
    for node in root.children:
        if node.tag == "h1":
            children.append(el("p", {"class": "docs-eyebrow"}, [txt("Inside the toolchain · 0.6 design")]))
        children.append(node)
        if node.tag == "p" and not added:
            children.append(starting_points())
            added = true
    return DocumentNode(tag="", children=children)
