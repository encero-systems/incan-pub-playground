from rust::markdown import to_html_with_options, Options


pub def parser_probe() -> None:
    options = Options.gfm()
    match to_html_with_options("# Hello\n\n| A | B |\n| - | - |\n| one | two |", options):
        Ok(html) => println(html)
        Err(error) =>
            println(str(error))
            assert false, "Markdown parse failed"
