"""Browser diagram mechanism; diagram content and visual policy are authored in Incan."""

from pub::pallay import DocumentNode
from components import el, txt


pub def diagram(source: str, label: str) -> DocumentNode:
    return el(
        "div",
        {"class": "doc-diagram"},
        [el("div", {"class": "doc-diagram-canvas", "data-diagram": "mermaid", "aria-label": label}, [txt(source)])],
    )


pub def diagram_runtime() -> str:
    return "\n(async function(){\n  const nodes=[...document.querySelectorAll('[data-diagram=\"mermaid\"]')];\n  if(!nodes.length)return;\n  if(!window.mermaid){for(const node of nodes)node.dataset.renderState='unavailable';return;}\n  await document.fonts.ready;\n  window.mermaid.initialize({startOnLoad:false,securityLevel:'strict',theme:'base',flowchart:{useMaxWidth:true,htmlLabels:false,curve:'basis'},themeVariables:{background:'#080c0a',primaryColor:'#13241b',primaryTextColor:'#f2f3ef',primaryBorderColor:'#a78b4d',secondaryColor:'#112522',tertiaryColor:'#162019',lineColor:'#83aaa0',edgeLabelBackground:'#080c0a',fontFamily:'Exo 2, sans-serif',fontSize:'14px'}});\n  for(const node of nodes){\n    try{await window.mermaid.run({nodes:[node],suppressErrors:false});node.dataset.renderState='ready';}\n    catch(error){node.dataset.renderState='error';node.textContent='Diagram unavailable. The original source is available below.';console.error('Documentation diagram failed',error);}\n  }\n})();\n"
