"""Incapunk appearance declaration. Generated CSS is a browser target artifact."""


pub def stylesheet() -> str:
    return ":root {\n  color-scheme: dark;\n  --ink:#080c0a; --panel:#0b110e; --gold:#ffcd68; --gold-bright:#ffe7a6;\n  --cyan:#42e8ef; --text:#f2f3ef; --muted:#bdc6c0; --quiet:#94a59b;\n  --outline:#293b32; --rule:#69572e; --display:'Exo 2',sans-serif;\n  --body:'Exo 2',sans-serif; --mono:ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace;\n}\n*{box-sizing:border-box} [hidden]{display:none!important}\nhtml{scroll-behavior:smooth;scroll-padding-top:98px}\nbody{margin:0;background:var(--ink);color:var(--text);font:16px/1.5 var(--body)}\na{color:inherit;text-decoration:none} button,input,select{font:inherit} button{cursor:pointer}\na,button{touch-action:manipulation} button,select,input{color:inherit}\na:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible,pre:focus-visible{outline:2px solid var(--cyan);outline-offset:4px;border-radius:3px}\nh1,h2,h3,p{margin:0} h1,h2,h3{font-family:var(--display);line-height:1.13;letter-spacing:-.025em}\nh1{font-size:clamp(38px,4.3vw,64px);font-weight:700;letter-spacing:-.035em;white-space:nowrap}\nh1 span,h2{color:var(--gold)} h2{font-size:32px;font-weight:700}\n.wrap{width:calc(100% - 100px);max-width:1280px;margin-inline:auto}\n.site-header{position:sticky;top:0;z-index:10;background:#080c0af7;border-bottom:1px solid #28362d;backdrop-filter:blur(16px)}\n.masthead{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px}\n.brand{display:inline-flex;flex-shrink:0;align-items:center}\n.brand-lockup{width:216px;height:auto;display:block;mix-blend-mode:lighten}\n.masthead nav{display:flex;align-items:center;gap:28px;font-size:14px;white-space:nowrap}\n.masthead nav a{padding-block:20px} .masthead nav a:hover,.footer a:hover{color:var(--gold)}\n.header-search{display:flex;align-items:center;min-width:0;max-width:234px;margin-left:auto;border:1px solid var(--outline);border-radius:6px;background:var(--panel)}\n.header-search input{min-width:0;width:100%;padding:9px 0 9px 12px;border:0;background:none;font-size:13px}\n.header-search input::placeholder{color:var(--quiet)}\n.header-search button{padding:8px;border:0;background:none;font-size:11px;color:var(--muted)}\n.header-search button:hover{color:var(--cyan)}\n.release-status{font-size:11px;white-space:nowrap;border:1px solid #8b7137;color:var(--gold-bright);border-radius:5px;padding:8px 10px}\n.menu-toggle{display:none}\n.hero-scene{position:relative;overflow:hidden;isolation:isolate}\n.hero-art{position:absolute;width:100%;max-width:none;left:50%;transform:translateX(-50%);top:0;bottom:0;pointer-events:none;z-index:-1;overflow:hidden}\n.hero-backdrop{position:absolute;top:40px;left:0;width:100%;height:auto;display:block}\n.hero-cube{position:absolute;left:55.5%;top:4px;width:30%;height:auto;filter:drop-shadow(0 14px 14px #0009)}\n.welcome{position:relative;min-height:480px;display:flex;align-items:center;padding-block:46px 80px}\n.welcome-copy{position:relative;z-index:1;max-width:660px}\n.welcome p{max-width:510px;font-size:21px;line-height:1.5;margin-top:18px;color:#dde2dd}\n.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin-top:28px}\n.button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:48px;padding:11px 22px;border:1px solid var(--outline);border-radius:6px;font-size:15px;font-weight:600;transition:background .18s,border-color .18s,transform .18s}\n.button-primary,.button-community{background:#ffcc68;border-color:#f5cf7a;color:#17140c;box-shadow:inset 0 1px 0 #fff1bc}\n.button-primary:hover,.button-community:hover{background:#ffdf95;border-color:#fff0bc;transform:translateY(-1px)}\n.button-secondary{background:#080c0ad9;border-color:#7d928b;color:var(--text)}\n.button-secondary:hover{border-color:var(--cyan);background:#14201a}\n.icon{display:inline-block;width:20px;height:20px;flex-shrink:0;vertical-align:middle;background:currentColor;mask:var(--icon) center/contain no-repeat;-webkit-mask:var(--icon) center/contain no-repeat}\n.arrow{--icon:url('assets/icons/arrow-right.svg');width:16px;height:16px}.file{--icon:url('assets/icons/file-code.svg')}.copy{--icon:url('assets/icons/copy.svg')}.check{--icon:url('assets/icons/check.svg')}.terminal{--icon:url('assets/icons/terminal-2.svg')}.database{--icon:url('assets/icons/database.svg')}.world{--icon:url('assets/icons/world.svg')}.cube{--icon:url('assets/icons/cube.svg')}.packages{--icon:url('assets/icons/packages.svg')}.settings{--icon:url('assets/icons/settings.svg')}.map{--icon:url('assets/icons/map.svg')}.github{--icon:url('assets/icons/brand-github.svg')}.linkedin{--icon:url('assets/icons/brand-linkedin.svg')}.menu-icon{--icon:url('assets/icons/menu-2.svg')}\n.gold{color:var(--gold)}\n.example-section{padding:0 0 26px;position:relative}\n.example-navigation{display:flex;align-items:center;gap:22px;min-height:48px;margin-bottom:17px;font-size:13px}\n.example-tabs,.example-controls{display:flex;align-items:center;gap:8px}\n.example-tabs button{position:relative;padding:10px 13px;border:0;border-bottom:2px solid transparent;background:none;color:var(--muted);font-size:13px;min-height:44px}\n.example-tabs button[aria-pressed=true]{color:var(--gold);border-bottom-color:var(--gold)}\n.example-tabs button:hover{color:var(--gold-bright)}\n.example-picker{width:175px;flex-shrink:0}.example-picker select{width:100%;min-height:40px;border:1px solid var(--outline);border-radius:5px;background:#101914;color:var(--cyan);font-size:13px;padding:7px 12px}\n.example-controls{margin-left:auto}.example-count{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums;margin-right:10px;white-space:nowrap}\n.example-previous,.example-next,.tour-toggle{display:inline-flex;align-items:center;justify-content:center;min-height:40px;min-width:40px;border:1px solid var(--outline);border-radius:5px;background:var(--panel);color:var(--muted)}\n.example-previous .arrow{transform:rotate(180deg)}.tour-toggle{font-size:12px;padding:8px 13px}\n.example-controls button:hover{color:var(--cyan);border-color:#5a9389}\n.example-body{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:64px}\n.code-panel{min-width:0;border:1px solid var(--outline);border-radius:7px;background:#0a100dd9;overflow:hidden}\n.panel-heading{height:43px;display:flex;align-items:center;justify-content:space-between;padding-left:18px;border-bottom:1px solid var(--outline)}\n.file-label{display:flex;align-items:center;gap:10px;color:var(--cyan);font-size:13px}\n.copy-button{height:42px;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-width:84px;border:0;border-left:1px solid var(--outline);background:none;color:var(--muted);font-size:12px}\n.copy-button .icon{width:16px;height:16px}.copy-button:hover{background:#18241c;color:var(--text)}.copy-button:focus-visible{outline-offset:-4px}\n.source-code,.terminal-code{font-family:var(--mono);margin:0;overflow:auto;tab-size:4}\n.source-code{font-size:15px;line-height:1.72;padding:22px 12px 22px 0;counter-reset:code-line;min-height:calc(var(--example-lines,13)*1.72em + 44px)}\n.source-code code{display:block;white-space:normal}.line{display:block;position:relative;white-space:pre;padding-left:65px;min-height:1.72em;transition:background .25s}\n.line::before{counter-increment:code-line;content:counter(code-line);position:absolute;left:14px;width:26px;text-align:right;font-size:.85em;color:#96a99d}\n.line:target,.line.tour-active{background:#afdcba08}.keyword{color:#e9a0f3}.type{color:#5de6ed}.function{color:#83d6eb}.string{color:#f2da7c}.number{color:#ffd69a}.comment{color:#96a99d}\n.annotations{display:flex;flex-direction:column;justify-content:space-around;padding:32px 0 18px;position:relative}\n.annotations>div{max-width:28ch}.annotations a{display:inline-block;font-size:17px;font-weight:600;line-height:1.3;color:var(--gold)}\n.annotations a:hover{text-decoration:underline;text-underline-offset:4px}.annotations p{font-size:13px;color:var(--muted);line-height:1.5;margin-top:7px}\n.annotations .tour-active a{color:var(--gold-bright)}.tour-controls{display:none}\n.leader-line{pointer-events:none;z-index:2}.example-caption{font-size:12px;color:var(--quiet);margin-top:10px}\n.rust-context{display:flex;align-items:center;gap:24px;margin-top:26px;padding:22px 0 4px;border-top:1px solid var(--rule);font-size:13px}\n.rust-context strong{color:var(--gold);font-weight:600;white-space:nowrap}.rust-context p{color:var(--muted)}.rust-context a{color:var(--cyan);margin-left:auto;white-space:nowrap}\n.ruled{border-top:1px solid var(--rule)}\n.run-section{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:center;gap:70px;padding:29px 0}\n.section-lead{font-size:18px;line-height:1.5;margin-top:10px}.run-copy .section-lead{max-width:28ch}\n.terminal-code{font-size:14px;line-height:1.65;padding:15px 20px}.terminal-code code{white-space:normal}\n.command{display:block;white-space:pre;padding-left:24px;position:relative}.command::before{content:'$';position:absolute;left:0;color:var(--gold-bright)}.executable{color:var(--cyan)}.terminal-panel .file-label{color:var(--muted)}.terminal-panel .terminal{color:var(--gold)}\n.projects-section,.tools-section{padding:27px 0 31px}\n.project-links,.tool-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:24px}\n.resource-link{display:flex;align-items:flex-start;gap:14px;padding:4px 22px;border-left:1px solid var(--rule);min-width:0}\n.resource-link:first-child{border-left:0;padding-left:0}.resource-link:last-child{padding-right:0}\n.resource-icon{width:31px;height:31px;color:var(--cyan)}.resource-icon.gold{color:var(--gold)}\n.resource-link strong{display:flex;align-items:center;gap:6px;color:var(--cyan);font-weight:600;font-size:14px;line-height:1.4}\n.resource-link strong .arrow{width:14px;height:14px}.resource-link:hover strong{text-decoration:underline;text-underline-offset:4px}\n.description{display:block;font-size:13px;color:var(--muted);line-height:1.5;margin-top:8px;max-width:29ch}\n.browse-link{display:flex;align-items:center;gap:8px;color:var(--cyan);font-size:13px;margin-top:8px}\n.tool-preview{display:inline-block;color:var(--gold-bright);font-size:10px;font-weight:400}\n.performance-section{padding:32px 0;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:76px}\n.eyebrow{color:var(--cyan);font-size:11px;text-transform:uppercase;letter-spacing:.14em;margin-bottom:12px}\n.performance-intro>p:not(.eyebrow){font-size:15px;color:var(--muted);max-width:42ch;margin-top:15px}\n.performance-goals{margin:25px 0 0}.performance-goals>div{padding:15px 0;border-top:1px solid var(--outline)}\n.performance-goals dt{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--muted)}\n.evidence-label{color:var(--cyan);font-size:11px}.evidence-label.target{color:var(--gold-bright)}\n.performance-goals dd{margin:7px 0 0;font-size:20px;font-weight:600;color:var(--gold-bright)}\n.performance-goals small{display:block;font:13px/1.5 var(--body);color:var(--muted);margin-top:5px}\n.benchmark-panel{min-width:0;align-self:start;border:1px solid var(--outline);border-radius:7px;background:var(--panel);padding:21px 22px}\n.benchmark-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.benchmark-heading h3{font-size:23px;color:var(--gold-bright);font-weight:600}.benchmark-heading>span{font-size:11px;color:var(--quiet);white-space:nowrap}\n.benchmark-panel table{width:100%;border-collapse:collapse;font-size:14px;font-variant-numeric:tabular-nums}\n.benchmark-panel caption{text-align:left;font-size:12px;color:var(--muted);padding:9px 0 18px}\n.benchmark-panel th,.benchmark-panel td{padding:10px 8px;border-bottom:1px solid var(--outline);text-align:right;white-space:nowrap}\n.benchmark-panel th:first-child{text-align:left;padding-left:0}.benchmark-panel th:last-child,.benchmark-panel td:last-child{padding-right:0}\n.benchmark-panel thead th{font-size:12px;font-weight:400;color:var(--muted)}\n.benchmark-panel th:nth-child(2),.benchmark-panel td:nth-child(2){color:var(--cyan)}\n.benchmark-panel tbody th{font-weight:500}.benchmark-panel tbody th span{display:block;font-size:10px;color:var(--quiet);font-weight:400;margin-top:2px}\n.benchmark-panel td span{font-size:10px;color:var(--quiet);margin-left:3px}\n.benchmark-panel tbody tr:hover{background:#8ebe9708}.benchmark-method{font-size:11px;line-height:1.6;color:var(--muted);margin-top:16px}\n.benchmark-links{display:flex;justify-content:space-between;gap:10px;margin-top:14px;font-size:12px}.benchmark-links a{color:var(--cyan)}.benchmark-links code{font:11px var(--mono);color:var(--muted)}\n.community-section{position:relative;isolation:isolate;display:grid;grid-template-columns:360px minmax(0,1fr);gap:70px;min-height:330px;margin-top:0}\n.community-section::before{content:'';position:absolute;inset:0 calc((min(1280px,100vw - 100px) - 100vw)/2);z-index:-1;background:url('assets/community-scene.webp') center/cover no-repeat;pointer-events:none}\n.incus-portrait{position:relative;align-self:end;display:flex;align-items:flex-end;min-width:0;height:330px}\n.incus-portrait img{display:block;width:285px;height:auto;max-height:350px;object-fit:contain;object-position:left bottom;max-width:100%}\n.meet-incus{position:absolute;left:0;bottom:16px;font-size:13px;color:var(--cyan);display:flex;align-items:center;gap:8px;padding:5px;background:#080c0ac9;border-radius:4px}\n.meet-incus:hover{text-decoration:underline;text-underline-offset:4px}\n.community-copy{padding:34px 0;align-self:center}.community-copy h2{color:var(--text)}\n.community-action{display:flex;align-items:center;gap:22px;margin-top:22px}.linkedin-label{display:flex;align-items:center;gap:8px;font-size:13px}.linkedin-label .icon{color:#5bc8f0}\n.project-nav{display:flex;align-items:center;flex-wrap:wrap;margin-top:21px;gap:0}\n.project-nav a{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border-left:1px solid #526053;font-size:13px}\n.project-nav a:first-child{border-left:0;padding-left:0}.project-nav a:last-child{padding-right:0}.project-nav a:hover{color:var(--gold)}\n.project-nav .icon{width:18px;height:18px}.project-nav .arrow{display:none}\n.footer{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:14px 0}\n.footer .brand-lockup{width:175px}.footer nav{display:flex;align-items:center;gap:25px;font-size:12px}.footer nav a{display:flex;align-items:center;gap:7px;min-height:44px}.footer .github{width:18px;height:18px}\n.copyright{font-size:11px;color:var(--quiet);white-space:nowrap}\n.skip-link{position:fixed;left:16px;top:-90px;background:var(--gold-bright);color:var(--ink);padding:12px 20px;z-index:30}.skip-link:focus{top:16px}\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(min-width:1600px){.welcome{min-height:540px}.hero-backdrop{top:0}.hero-cube{top:-20px}.welcome p{max-width:500px}}\n@media(max-width:1200px){\n .wrap{width:calc(100% - 64px)}.masthead{gap:18px}.masthead nav{gap:20px}.brand-lockup{width:180px}.header-search{max-width:180px}.release-status{font-size:10px;padding:7px}\n h1{font-size:50px}.welcome{min-height:440px}.welcome p{font-size:19px;max-width:440px}.welcome-copy{max-width:530px}.hero-cube{width:32%;left:58%;top:14px}.hero-backdrop{top:90px}\n .example-navigation{gap:12px}.example-tabs{gap:0}.example-tabs button{padding-inline:9px}.example-picker{width:140px}.example-body{grid-template-columns:minmax(0,1fr) 235px;gap:50px}.source-code{font-size:14px}.annotations a{font-size:16px}\n .performance-section{gap:40px}.resource-link{padding-inline:16px;gap:10px}.resource-link strong{font-size:13px}.description{font-size:12px}.run-section{gap:40px}\n .community-section{grid-template-columns:300px minmax(0,1fr);gap:40px}.community-section::before{inset-inline:calc((100% - 100vw)/2)}.project-nav a{padding-inline:13px}\n}\n@media(max-width:1000px){\n .header-search{display:none}.release-status{margin-left:auto}.masthead nav{gap:18px}.masthead{gap:20px}.welcome{min-height:410px}.welcome h1{font-size:43px}.welcome p{font-size:17px;max-width:380px}.hero-cube{top:45px;width:33%;left:61%}.hero-backdrop{top:155px}.hero-actions{gap:10px}.hero-actions .button{padding-inline:15px;font-size:13px}\n .example-tabs{display:none}.example-picker{width:220px}.example-body{grid-template-columns:minmax(0,1fr) 205px;gap:40px}.source-code{font-size:13px}.line{padding-left:45px}.line::before{left:6px;width:22px}.annotations a{font-size:15px}.annotations p{font-size:12px}\n .rust-context{flex-wrap:wrap;gap:8px 20px}.rust-context p{flex:1;min-width:280px}.rust-context a{margin-left:0}\n h2{font-size:28px}.section-lead{font-size:16px}.performance-section{gap:30px;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}.benchmark-panel{padding:18px 15px}.benchmark-heading h3{font-size:20px}.benchmark-panel table{font-size:12px}.benchmark-panel th,.benchmark-panel td{padding-inline:5px}\n .project-links,.tool-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 0}.resource-link:nth-child(3){border-left:0;padding-left:0}.resource-link strong{font-size:14px}.description{font-size:13px}.resource-link{gap:16px;padding-inline:24px}\n .community-section{grid-template-columns:230px minmax(0,1fr);gap:25px}.incus-portrait img{width:225px}.community-action{align-items:flex-start;flex-direction:column;gap:14px}.community-copy{padding:28px 0}.project-nav a{padding-inline:10px;font-size:12px}.project-nav .icon{display:none}.footer{flex-wrap:wrap;gap:0 25px}.copyright{margin-left:auto}\n}\n@media(max-width:740px){\n .wrap{width:calc(100% - 40px)}.masthead{min-height:72px;position:relative;gap:14px}.brand-lockup{width:166px}.release-status{font-size:9px;max-width:92px;text-align:center;white-space:normal;padding:6px}\n .menu-toggle{display:inline-flex;gap:6px;align-items:center;justify-content:center;min-height:44px;min-width:44px;background:var(--panel);border:1px solid var(--outline);border-radius:5px;font-size:12px;order:3;padding:8px}\n .masthead nav{display:none;position:absolute;top:100%;left:0;right:0;padding:12px;background:#0b110e;border:1px solid var(--outline);box-shadow:0 8px 20px #0006;z-index:12}\n .masthead nav.is-open{display:flex;flex-wrap:wrap;gap:0}.masthead nav a{width:50%;padding:14px 12px;font-size:15px}\n .welcome{min-height:620px;align-items:flex-start;padding-block:32px 330px}.welcome h1{font-size:clamp(32px,6.5vw,44px);white-space:normal}.welcome p{font-size:17px;max-width:460px;margin-top:13px}.desktop-break{display:none}.welcome-copy{max-width:none}.hero-actions{margin-top:21px}\n .hero-art{top:auto;bottom:0;height:330px;width:860px;left:auto;right:calc(50% - 260px);transform:none}.hero-backdrop{top:0}.hero-cube{width:265px;left:470px;top:-12px}.hero-actions .button{font-size:14px;padding:11px 17px}\n .example-navigation{margin-bottom:14px;gap:10px;flex-wrap:wrap}.example-picker{width:100%;flex-basis:100%}.example-picker select{min-height:44px}.example-controls{margin-left:0;justify-content:space-between;width:100%;gap:12px}.example-count{margin-right:auto}.example-controls button{min-height:44px;min-width:44px}\n .example-body{display:block}.source-code{font-size:12px;line-height:1.75;min-height:calc(var(--example-lines,13)*1.75em + 36px);padding-block:18px}.line{padding-left:38px}.line::before{left:5px;width:18px;font-size:10px}.panel-heading{height:43px;padding-left:13px}.copy-button{min-width:75px}\n .annotations{display:grid;gap:17px;padding:22px 0 0;grid-template-columns:1fr}.annotations>div{max-width:none}.annotations a{font-size:16px;padding-block:3px}.annotations p{font-size:13px;margin-top:3px}.rust-context{font-size:13px;margin-top:23px;padding-top:18px;gap:10px}.rust-context p{flex-basis:100%;min-width:0}.rust-context a{padding-top:3px}\n h2{font-size:28px}.run-section{display:block;padding:25px 0}.run-copy .section-lead{max-width:35ch}.terminal-panel{margin-top:21px}.terminal-code{font-size:12px;padding:14px}.section-lead{font-size:16px}\n .projects-section,.tools-section{padding:25px 0}.project-links,.tool-links{margin-top:22px;gap:25px 0}.resource-link{padding-inline:13px;gap:9px}.resource-link strong{font-size:13px}.resource-icon{width:25px;height:25px}.description{font-size:12px}.resource-link strong .arrow{display:none}\n .performance-section{display:block;padding:28px 0}.performance-intro>p:not(.eyebrow){max-width:50ch}.performance-goals{margin-top:22px}.benchmark-panel{margin-top:22px;padding:18px 13px}.benchmark-panel table{font-size:12px}.benchmark-panel th,.benchmark-panel td{padding:10px 5px}.benchmark-heading h3{font-size:20px}.benchmark-heading>span{font-size:9px}.benchmark-panel caption{font-size:11px}.benchmark-panel tbody th span{font-size:9px}.benchmark-panel td span{font-size:9px;margin-left:2px}.benchmark-method{font-size:11px}.benchmark-links code{font-size:9px}\n .tool-links{display:block}.tool-links .resource-link{border-left:0;border-top:1px solid var(--outline);padding:17px 0;gap:17px}.tool-links .resource-link:first-child{border-top:0;padding-top:0}.tool-links .resource-link:last-child{padding-bottom:0}.tool-links .resource-icon{width:31px;height:31px}.tool-links strong{font-size:15px}.tool-links .description{font-size:13px;max-width:40ch}\n .community-section{display:flex;flex-direction:column;gap:0;padding-top:24px;overflow:visible}.community-section::before{background-position:38% center;opacity:.65}.community-copy{order:0;padding:0}.community-copy h2{font-size:30px}.community-action{flex-direction:row;flex-wrap:wrap;gap:16px;align-items:center}.community-action .button{font-size:14px}.project-nav{margin-top:16px}.project-nav a{padding-inline:12px;font-size:12px}.incus-portrait{order:1;height:265px;margin-top:18px;align-self:flex-start}.incus-portrait img{width:245px;max-height:265px}.meet-incus{left:225px;bottom:13px;white-space:nowrap;padding:6px}\n .footer{padding:16px 0 24px;gap:8px 20px}.footer .brand-lockup{width:145px}.footer nav{gap:18px;font-size:11px;flex-wrap:wrap}.copyright{margin-left:0;width:100%}\n}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}\n/* Keep the generated plinth and the unchanged emblem on one spatial baseline. */\n@media(min-width:1201px) and (max-width:1599px){.hero-backdrop{top:0}.hero-cube{top:-16px;width:28%;left:56.5%}}\n@media(max-width:740px){.meet-incus{left:0;bottom:12px}}\n/* A continuous scene fills the hero, rather than a short image band below copy. */\n.hero-scene{--hero-height:480px}\n.hero-art{min-width:calc(var(--hero-height)*2.5)}\n.hero-backdrop{top:0;width:100%;height:auto}\n.hero-cube{left:56.5%;width:28%;top:-16px}\n/* The architecture is atmosphere; Incus is the foreground. */\n.community-section::before{opacity:.38}\n.incus-portrait img{filter:drop-shadow(0 8px 18px #000b)}\n@media(min-width:1600px){.hero-scene{--hero-height:540px}}\n@media(max-width:1200px){.hero-scene{--hero-height:440px}}\n@media(max-width:1000px){.hero-scene{--hero-height:410px}}\n@media(max-width:740px){\n .hero-scene{--hero-height:620px}\n .hero-art{width:100%;min-width:0;max-width:none;height:100%;inset:0;transform:none}\n .hero-backdrop{height:100%;width:100%;object-fit:cover;object-position:center bottom}\n .hero-cube{width:min(57vw,270px);left:50%;top:auto;bottom:118px;transform:translateX(-50%)}\n .community-section::before{opacity:.32}\n .meet-incus{left:0;bottom:12px}\n}\n@media(max-width:740px){\n .hero-scene{--hero-height:700px}\n .welcome{min-height:700px;padding-bottom:390px}\n .hero-cube{width:min(57vw,250px);bottom:206px}\n}\n/* The code is the primary teaching surface, not small supporting UI. */\n@media(min-width:1201px){\n .source-code{font-size:18px;line-height:1.55;min-height:calc(var(--example-lines,13)*1.55em + 44px)}\n .line{min-height:1.55em}\n}\n@media(min-width:1001px) and (max-width:1200px){.source-code{font-size:16px}}\n\n/* Full-bleed wide displays: the environment fills the viewport independently\n   of the readable content grid. Keep the original emblem at a useful size and\n   anchor the plinth's landing point instead of enlarging/cropping the emblem. */\n@media(min-width:1572px){\n .hero-cube{width:440px;left:calc(70.6% - 220px);top:calc(24.2vw - 398px)}\n}\n@media(min-width:1819px){\n .hero-backdrop{top:calc(440px - 24.2vw)}\n .hero-cube{top:42px}\n}\n\n/* The isolated wordmark has genuine alpha; this viewport only removes the\n   generator's transparent canvas padding. No blend mode or floor reflection. */\n.hero-wordmark{display:inline-block;position:relative;overflow:hidden;width:4.1em;height:1.05em;vertical-align:-.15em}\n.hero-wordmark img{position:absolute;width:4.8em;max-width:none;height:auto;left:-.36em;top:-.52em;display:block}\n.hero-period{color:var(--gold);margin-left:.02em}\n@media(max-width:380px){.welcome h1{font-size:28px}}\n\n/* Original Incapunk header rail, reused at the two hero baselines. */\n:root{--inc-rail:linear-gradient(90deg,rgba(72,240,239,0),rgba(72,240,239,.78) 12%,rgba(255,193,90,.9) 46%,rgba(255,92,105,.78) 84%,rgba(255,92,105,0))}\n.site-header{border-bottom:0}\n.site-header::after,.hero-scene::after,.community-section::after{\n content:'';position:absolute;left:0;right:0;bottom:0;height:2px;\n background:var(--inc-rail);pointer-events:none;z-index:3;\n box-shadow:0 1px 8px #ffd48212;\n}\n.community-section::after{left:calc((100% - 100vw)/2);right:calc((100% - 100vw)/2)}\n.community-section{min-height:290px;margin-top:30px;overflow:visible}\n.incus-portrait{height:290px}\n.community-copy{padding-block:24px}\n.footer{border-top:0}\n@media(min-width:741px) and (max-width:1000px){\n .community-section{min-height:270px}\n .incus-portrait{height:270px}\n .incus-portrait img{width:250px;max-width:none}\n}\n@media(max-width:740px){\n .community-section{margin-top:20px;min-height:0}\n .community-copy{padding:0}\n .incus-portrait{height:245px}\n .incus-portrait img{max-height:265px}\n}\n\n/* Intermediate widths still have room for Incus beside the community copy. */\n@media(min-width:560px) and (max-width:740px){\n .community-section{display:grid;grid-template-columns:clamp(180px,30vw,220px) minmax(0,1fr);gap:24px;min-height:230px;padding-top:0}\n .incus-portrait{order:0;height:230px;margin-top:0;align-self:end;width:100%}\n .incus-portrait img{width:220px;max-width:100%;max-height:265px}\n .community-copy{order:0;align-self:center;padding-block:24px;min-width:0}\n .community-action{gap:12px}\n .project-nav a{padding-inline:9px}\n}\n\n/* Approved Encero signature. Relative font URL also works under Pages subpaths. */\n@font-face{font-family:\"EnceroLato\";src:url(\"fonts/Lato-Bold.ttf\") format(\"truetype\");font-weight:700;font-style:normal;font-display:swap}\n.footer-identity{display:flex;align-items:center;gap:10px;flex-shrink:0}\n.encero-credit{display:inline-flex;align-items:baseline;gap:.45em;white-space:nowrap;color:inherit;text-decoration:none;font-size:14px;line-height:1.3}\n.encero-credit-divider{margin-right:.15em;opacity:.5}\n.encero-credit em{font-weight:400;font-style:italic}\n.encero-credit-name{font-family:\"EnceroLato\",sans-serif;font-weight:700;font-style:normal;letter-spacing:.14em}\n.encero-credit{opacity:.68;transition:opacity .18s;transform:translateY(3px)}\n.encero-credit:hover,.encero-credit:focus-visible{opacity:1}\n.encero-credit:focus-visible{outline:2px solid currentColor;outline-offset:4px}\n\n/* Incapunk 2.0: original metallic craft within the approved open layout. */\n:root{\n --panel-metal:linear-gradient(90deg,#48f0ef70,#e9cc89aa 18%,#80461270 39%,#ffdb8ecc 58%,#854c1b70 78%,#ff5c6960);\n}\n.code-panel,.benchmark-panel{\n position:relative;border-color:#a98b4b44;\n background:linear-gradient(#0a100df2,#0a100df2) padding-box;\n box-shadow:inset 0 1px 0 #fff0b710,inset 0 -1px 0 #ffc15a08,0 8px 24px #0003;\n}\n.code-panel::before,.benchmark-panel::before{\n content:'';position:absolute;left:0;right:0;top:0;height:1px;\n background:var(--panel-metal);pointer-events:none;z-index:1;\n}\n.panel-heading{\n background:linear-gradient(180deg,#fff0b708,#0002);\n border-bottom-color:#a98b4b38;\n box-shadow:inset 0 -1px 0 #0006;\n}\n.button-primary,.button-community{\n background:linear-gradient(180deg,#ffe6a3 0%,#ffd078 18%,#edb64f 80%,#daa03a 100%);\n border-color:#f4d38d;\n box-shadow:inset 0 1px 0 #fff5d4,inset 0 -2px 0 #8b530b4d,0 3px 10px #0004;\n}\n.button-primary:hover,.button-primary:focus-visible,.button-community:hover,.button-community:focus-visible{\n background:linear-gradient(180deg,#fff0be,#ffd88c 24%,#f4bf60 82%,#e2ac4d);\n box-shadow:inset 0 1px 0 #fff8df,inset 0 -2px 0 #8b530b35,0 4px 16px #ffc15a18;\n}\n.button-secondary{\n background:linear-gradient(180deg,#15302be6,#091511ed 35%,#080e0be6);\n border-color:#6bc7c080;\n box-shadow:inset 0 1px 0 #b3fff015,inset 0 -1px 0 #0009,0 3px 10px #0003;\n}\n.button-secondary:hover,.button-secondary:focus-visible{background:linear-gradient(180deg,#1c3931,#0c1f18 40%,#0b1610);border-color:var(--cyan)}\n.example-tabs button{border-radius:4px 4px 0 0;transition:color .18s,background .18s,border-color .18s,box-shadow .18s}\n.example-tabs button[aria-pressed=true]{\n color:var(--gold-bright);border-bottom-color:var(--gold);\n background:linear-gradient(180deg,#ffc15a13,#ffc15a05);\n box-shadow:inset 0 1px 0 #ffe5a81c;\n}\n.example-tabs button:hover,.example-tabs button:focus-visible{background:#48f0ef0b;color:var(--gold-bright)}\n.resource-link{transition:background .18s,box-shadow .18s}\n.resource-link:hover,.resource-link:focus-visible{background:linear-gradient(90deg,#48f0ef0b,#ffc15a05);box-shadow:inset 0 1px 0 #ffe5a810}\n\n/* Welcome is the quiet introduction; the actual wordmark carries the name. */\n.welcome h1{font-size:76px;white-space:normal;line-height:1}\n.welcome-prefix{display:block;color:var(--text);font-size:20px;font-weight:400;letter-spacing:.025em;line-height:1.3;margin-bottom:7px}\n.welcome-brand{display:inline-flex;align-items:baseline;white-space:nowrap}\n.welcome-brand .hero-wordmark{vertical-align:baseline}\n.welcome .welcome-tagline{font-size:14px;font-weight:500;line-height:1.5;letter-spacing:.16em;text-transform:uppercase;margin-top:15px;color:var(--gold-bright);max-width:none}\n.language-qualities{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 24px;list-style:none;margin:20px 0 0;padding:0;max-width:430px;color:#dde2dd;font-size:15px;line-height:1.45}\n.language-qualities li{display:flex;align-items:center;gap:9px}\n.language-qualities .icon{width:14px;height:14px;color:var(--cyan);opacity:.8}\n.welcome .hero-actions{margin-top:25px}\n@media(max-width:1200px){.welcome h1{font-size:68px}.welcome-prefix{font-size:18px}.welcome .welcome-tagline{font-size:13px;letter-spacing:.14em}.language-qualities{font-size:14px;max-width:400px;gap:8px 20px}}\n@media(max-width:1000px){.welcome h1{font-size:58px}.welcome-prefix{font-size:17px}.welcome .welcome-tagline{font-size:12px;letter-spacing:.13em}.language-qualities{font-size:13px;max-width:360px;gap:7px 16px}}\n@media(max-width:740px){\n .welcome h1{font-size:58px}.welcome-prefix{font-size:17px;margin-bottom:4px}\n .welcome .welcome-tagline{font-size:12px;letter-spacing:.12em;margin-top:12px}\n .language-qualities{font-size:13px;gap:8px 12px;max-width:360px;margin-top:18px}\n .language-qualities li{gap:7px}.language-qualities .icon{width:12px;height:12px}\n .welcome{min-height:600px;padding-bottom:250px}.hero-scene{--hero-height:600px}\n .hero-cube{width:min(57vw,220px);bottom:38px}\n}\n\n@media(max-width:740px){\n .hero-art::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,#080c0ab8 0%,#080c0a80 36%,transparent 61%)}\n}\n\n\n/* Rail-free monochrome stamp: preserve source geometry and crop specimen padding. */\n.footer-brand{position:relative;width:96px;height:27px;overflow:hidden}\n.built-with-stamp{display:block;position:absolute;max-width:none;width:143%;height:auto;left:-21.5%;top:-29%;mix-blend-mode:lighten}\n@media(max-width:740px){.footer-brand{width:92px;height:26px}.footer-identity{gap:8px}}\n\n/* At tablet widths the emblem can sit beside the lower copy, not a full portrait row. */\n@media(min-width:560px) and (max-width:740px){\n .welcome{min-height:490px;padding-bottom:180px}\n .hero-scene{--hero-height:490px}\n .hero-cube{width:200px;left:76%;bottom:185px}\n .hero-art::after{background:linear-gradient(110deg,#080c0ad9 0%,#080c0a85 44%,transparent 75%)}\n}\n\n@media(max-width:559px){.hero-backdrop{top:130px;mask-image:linear-gradient(180deg,transparent,#000 22%)}}\n\n/* Shared closing scene: compact outside the homepage, always in document flow. */\n.site-footer{margin-top:40px}\n.site-footer .community-section{margin-top:0}\n.community-compact{grid-template-columns:210px minmax(0,1fr);gap:40px;min-height:190px}\n.community-compact .incus-portrait{height:190px;margin-top:0;align-self:end}\n.community-compact .incus-portrait img{width:190px;max-width:100%;max-height:225px}\n.community-compact .community-copy{padding-block:24px;min-width:0}\n.community-compact .community-copy h2{font-size:26px}\n.community-compact .section-lead{font-size:15px;margin-top:10px}\n.community-compact .community-action{flex-direction:row;align-items:center;flex-wrap:wrap;gap:12px 20px;margin-top:16px}\n.community-compact .button{font-size:13px;padding:10px 16px}\n.community-compact .linkedin-label{font-size:12px}\n@media(max-width:740px){\n .site-footer{margin-top:32px}\n .community-compact{display:grid;grid-template-columns:145px minmax(0,1fr);gap:22px;min-height:180px;padding-top:0}\n .community-compact .incus-portrait{height:180px;order:0;width:100%}\n .community-compact .incus-portrait img{width:155px;max-height:200px}\n .community-compact .community-copy{order:0;padding-block:22px}\n .community-compact .community-copy h2{font-size:24px}\n .community-compact .meet-incus{font-size:11px;bottom:10px}\n}\n@media(max-width:459px){\n .community-compact{grid-template-columns:96px minmax(0,1fr);gap:14px;min-height:190px}\n .community-compact .incus-portrait{height:150px}\n .community-compact .incus-portrait img{width:110px;max-width:none;max-height:165px;margin-left:-12px}\n .community-compact .community-copy h2{font-size:21px}\n .community-compact .section-lead{font-size:13px;line-height:1.5}\n .community-compact .button{font-size:12px;padding:9px 10px}\n .community-compact .community-action{gap:8px;margin-top:12px}\n .community-compact .meet-incus{font-size:10px;gap:3px;left:-6px;padding:4px}\n}\n"
