"""Incan-authored media resource for the 0.6 website, adapted from Katie's brief."""

from pub::pallay import DocumentNode, parse_template, render_tree
from components import el, txt
from layout import site_header, site_footer


def media_shell(original: DocumentNode) -> DocumentNode:
    mut node = original
    if node.tag == "button" and "id" in node.attributes and node.attributes["id"] == "menu-button":
        return el("a", {"class": "menu-toggle media-mobile-home", "href": "index.html"}, [txt("Home →")])
    if "href" in node.attributes:
        if node.attributes["href"] == "#welcome":
            node.attributes["href"] = "index.html#welcome"
        elif node.attributes["href"] == "#project":
            node.attributes["href"] = "#footer-community"
    mut children: list[DocumentNode] = []
    for child in node.children:
        children.append(media_shell(child))
    node.children = children
    return node


pub def media_document() -> str:
    parsed = parse_template(
        "<main id=\"main\" class=\"media-main\">\n<section class=\"media-hero ruled\"><div class=\"wrap media-hero-inner\">\n<div><p class=\"media-eyebrow\">For writers, creators &amp; the community</p><h1>Meet <span>Incan.</span></h1><p class=\"media-deck\">A modern programming language.</p><p class=\"media-intro\">The language, the people and the ideas behind it. A starting point for telling Incan’s story.</p><div class=\"hero-actions\"><a class=\"button button-primary\" href=\"#overview\">The short version ↓</a><a class=\"button button-secondary\" href=\"#brand-assets\">Brand assets ↓</a></div></div>\n<img class=\"media-emblem\" src=\"assets/incan-logo.png\" width=\"1024\" height=\"1024\" alt=\"Incan’s gold tesseract with its luminous cyan core\">\n</div></section>\n<nav class=\"wrap media-jump\" aria-label=\"Media kit sections\"><a href=\"#overview\">Overview</a><a href=\"#language\">Language</a><a href=\"#practical\">Projects</a><a href=\"#vision\">Vision</a><a href=\"#ecosystem\">Ecosystem</a><a href=\"#people\">People</a><a href=\"#brand-assets\">Assets</a><a href=\"#resources\">Resources</a></nav>\n<div class=\"wrap media-content\">\n<section id=\"overview\" class=\"media-section media-overview\"><div><p class=\"media-eyebrow\">01 / In a few words</p><h2>A different balance between readability and precision.</h2><p>Incan is a statically typed programming language with readable source, native compilation and Rust interoperability—being developed with a future of more inspectable, AI-assisted software development in mind.</p><p>Python shows how readable syntax can make software easier to author and understand. Rust brings static guarantees, native execution, and an established library ecosystem. Incan explores its own way of bringing these strengths together.</p><p>The goal is not simply to imitate either language. It is to build a coherent language and toolchain that keep application logic readable while making more of the underlying mechanics explicit and inspectable.</p><p class=\"media-note\">Prepared for the 0.6 website launch. This preview describes the intended release direction; the release notes will record what ships.</p></div><div class=\"media-summary\"><p class=\"media-eyebrow\">Short description</p><blockquote>Incan is a modern, statically typed programming language for building native software. It brings readable source and explicit types together with Rust interoperability. Oven provides the shared project and build system, with Incan and Rust code living side by side.</blockquote><a class=\"media-link\" href=\"media-description.txt\" download=\"incan-description.txt\">Download description <span aria-hidden=\"true\">↓</span></a><dl class=\"media-facts\"><div><dt>Name</dt><dd>Incan · from incandescent</dd></div><div><dt>Creator</dt><dd>Danny Meijer</dd></div><div><dt>Project</dt><dd>Open source · Encero Systems</dd></div><div><dt>Website</dt><dd><a href=\"https://incan.io\">incan.io ↗</a></dd></div></dl></div></section>\n<section id=\"language\" class=\"media-section\"><div class=\"media-section-heading\"><div><p class=\"media-eyebrow\">02 / The language</p><h2>Start with a small example.</h2></div><p>The best introduction to a programming language is code you can read, run, and explore. Use Incan’s official tutorials for syntax and examples compatible with the release you install.</p></div><div class=\"media-code-grid\"><div class=\"code-panel\"><div class=\"panel-heading\"><span class=\"file-label\">hello.incn</span><span class=\"media-note\">A first program</span></div><pre tabindex=\"0\" aria-label=\"Incan example\"><code><span class=\"mk-keyword\">def</span> main() -&gt; <span class=\"mk-type\">None</span>:\n    name = <span class=\"mk-string\">\"Incan\"</span>\n    message = <span class=\"mk-string\">\"Building the future\"</span>\n    println(<span class=\"mk-string\">f\"Hello, {name}\"</span>)\n    println(<span class=\"mk-string\">f\"{message}\"</span>)</code></pre></div><div class=\"media-language-notes\"><h3>Readable by design.</h3><p>Python-inspired syntax aims to keep everyday application logic expressive and easy to follow. Static typing and compiler feedback help developers understand program structure and errors.</p><a class=\"media-link\" href=\"index.html#main\">Explore the annotated examples →</a><h3>Rust, alongside Incan.</h3><p>The 0.6 design gives Incan its own compiler frontend. Incan and Rust share an Oven-managed project and compile to native code.</p><a class=\"media-link\" href=\"docs/architecture.html\">Read the 0.6 architecture →</a></div></div></section>\n<section id=\"practical\" class=\"media-section\"><p class=\"media-eyebrow\">03 / Practical exploration</p><h2>Move from syntax to real projects.</h2><p class=\"media-prose\">Start with a small program, move into a typed data processor, then explore APIs and Rust interoperability. These examples help visitors investigate what the current toolchain supports.</p><div class=\"media-learning\"><article><p class=\"media-eyebrow\">Application example</p><h3>Typed data processing</h3><p>Use typed models to read JSON, validate and transform order data, test core logic, and produce a report.</p><ul><li>Learn the language through a concrete task.</li><li>See types applied to application data.</li><li>Follow a project from input to output.</li></ul><a class=\"media-link\" href=\"docs/collections.html\">Explore collections and data →</a></article><article><p class=\"media-eyebrow\">Ecosystem example</p><h3>APIs, async work, and Rust</h3><p>Explore the documented tutorials for typed web APIs, asynchronous workflows, and supported Rust crate integration.</p><ul><li>Build on a practical tutorial.</li><li>Check compatibility and supported scope.</li><li>Use release notes to understand limitations.</li></ul><a class=\"media-link\" href=\"docs/typed-api.html\">Explore the API tutorial →</a></article></div></section>\n<section id=\"vision\" class=\"media-section\"><div class=\"media-section-heading\"><div><p class=\"media-eyebrow\">04 / AI-first vision</p><h2>Build software that people can inspect and verify.</h2></div><p>Code is easier to generate.<br><strong>Evidence matters.</strong><br>Human + agent · Shared project model</p></div><div class=\"media-vision media-vision-restored\"><p>Incan’s longer-term vision is for developers and AI agents to work from a shared understanding of a project. Rather than treating generated code as the end result, the workflow should make it easier to examine proposed changes, understand their impact, run tests, and review evidence.</p><p>This direction informs the language, compiler feedback, project model, and tooling. It is an evolving vision: not every part of the described workflow is available today.</p></div></section>\n<section id=\"ecosystem\" class=\"media-section\"><p class=\"media-eyebrow\">05 / The toolchain</p><h2>The tools around the language.</h2><p class=\"media-prose\">Oven is the build and project system being developed around Incan and Rust. Its direction is to make project inputs and build outputs more explicit and inspectable, including dependencies, compiler versions, targets, and artifacts.</p><div class=\"media-tools\"><article><span class=\"icon cube gold\" aria-hidden=\"true\"></span><h3>Oven</h3><p>Prepare dependencies, build, run and test. A shared project system for Incan and Rust.</p><a href=\"docs/architecture.html#main\">Project &amp; build architecture →</a></article><article><span class=\"icon packages gold\" aria-hidden=\"true\"></span><h3>Incan.pub</h3><p>Find a loaf, inspect its features and builds, and bring it into your project.</p><a href=\"https://encero-systems.github.io/incan-pub-playground/\">Explore the registry preview ↗</a></article><article><span class=\"icon file gold\" aria-hidden=\"true\"></span><h3>Architect <small>Preview</small></h3><p>Evidence-backed advice about a project’s design, grounded in its code and relationships.</p><a href=\"index.html#main\">Explore the tooling examples →</a></article></div></section>\n<section id=\"people\" class=\"media-section media-people\"><div class=\"media-creator\"><div class=\"media-portrait\"><img src=\"assets/danny-meijer-cyan-meta.png\" alt=\"Danny Meijer, creator of Incan\" width=\"1086\" height=\"1448\" loading=\"lazy\"></div><div class=\"media-creator-copy\"><p class=\"media-eyebrow\">06 / The creator</p><h2>Created by Danny Meijer.</h2><p>Incan is created by Danny Meijer, an independent data and software engineer whose experience spans software, data engineering, and cloud platforms.</p><p>Danny has 20 years of experience across software, data engineering, and cloud platforms and previously worked as a Principal Software Engineer at Nike. His work on Incan reflects an interest in readable application code, reliable tooling, and developer experience.</p><p>He also shares his knowledge through open-source work and teaching, including <em>Mastering Big Data Analytics with PySpark</em>.</p><div class=\"media-creator-links\"><a class=\"media-link\" href=\"https://www.linkedin.com/in/ACoAAAKIZeYBKsh_BaZDVWwqj0UmqOOZvv7kuxo\">Connect on LinkedIn ↗</a><a class=\"media-link\" href=\"https://encero.systems\">About Encero Systems ↗</a></div></div></div><div class=\"media-story\"><h3>Incandescent, by name.</h3><p>Gold, dark architecture and a luminous cyan core form Incan’s visual identity. Incus gives that world a familiar face.</p><p>Its name comes from <em>incandescent</em> — the source of the light at the heart of the identity.</p><a class=\"media-link\" href=\"https://www.linkedin.com/groups/42515004/\">Meet the community ↗</a></div></section>\n<section id=\"brand-assets\" class=\"media-section\"><div class=\"media-section-heading\"><div><p class=\"media-eyebrow\">07 / Brand assets</p><h2>The marks. The mascot.</h2></div><p>Original files from this website. Preserve their proportions and leave clear space around the artwork.</p></div><div class=\"media-assets\"><div class=\"media-asset-card\"><div class=\"media-asset-preview\"><img src=\"assets/incan-logo.png\" width=\"1024\" height=\"1024\" alt=\"Incan tesseract symbol\" loading=\"lazy\"></div><div class=\"media-asset-caption\"><h3>Tesseract</h3><a href=\"assets/incan-logo.png\" download=\"incan-tesseract.png\">Download PNG ↓</a></div></div><div class=\"media-asset-card\"><div class=\"media-asset-preview media-asset-wordmark\"><img src=\"assets/wordmark-inline-clean.png\" width=\"1983\" height=\"793\" alt=\"INCAN wordmark\" loading=\"lazy\"></div><div class=\"media-asset-caption\"><h3>Wordmark</h3><a href=\"assets/wordmark-inline-clean.png\" download=\"incan-wordmark.png\">Download PNG ↓</a></div></div><div class=\"media-asset-card\"><div class=\"media-asset-preview media-asset-incus\"><img src=\"assets/incus.webp\" alt=\"Incus, Incan’s armoured llama mascot\" loading=\"lazy\"></div><div class=\"media-asset-caption\"><h3>Incus</h3><a href=\"assets/incus.webp\" download=\"incus.webp\">Download WebP ↓</a></div></div></div><p class=\"media-note\">These are the website’s raster assets. Vector and print-ready masters are not included in this preview.</p></section>\n<section id=\"status\" class=\"media-section\"><p class=\"media-eyebrow\">08 / Project status</p><h2>Explore what exists today.</h2><p class=\"media-prose\">Incan is beta software. This website is being prepared for the 0.6 release, and the language and toolchain continue to evolve. The 0.6 architecture introduces Incan’s own frontend alongside Rust and a shared project model through Oven.</p><p class=\"media-prose\">Roadmap items describe planned outcomes, not guaranteed release dates. Check the documentation, release notes, and compatible tutorial version before relying on a feature or using it in production.</p><a class=\"media-link\" href=\"docs/architecture.html\">Explore the 0.6 architecture →</a></section>\n<section id=\"resources\" class=\"media-section\"><p class=\"media-eyebrow\">09 / Resources</p><h2>Your starting point for Incan.</h2><p>Use the official project sources to explore the code, learn the language, and check the latest supported workflows.</p><div class=\"media-resources\"><a href=\"docs/explore.html\"><strong>Documentation</strong><span>Learn, build and look things up →</span></a><a href=\"https://github.com/encero-systems/incan\"><strong>Source code</strong><span>Follow development on GitHub ↗</span></a><a href=\"https://incan.io/dev/release_notes/\"><strong>Release notes</strong><span>Check the scope of each release ↗</span></a><a href=\"https://www.linkedin.com/groups/42515004/\"><strong>Community</strong><span>Join the conversation on LinkedIn ↗</span></a></div><p class=\"media-prose media-closing\">Start with the source, try the documented tutorials, and follow Incan as its language and toolchain evolve.</p><p class=\"media-attribution\">Media kit prepared by Hamstrong Katie. Adapted for Incan’s 0.6 website, with updated technical context and brand assets.</p></section>\n</div></main>",
        "media-kit",
    )
    match parsed:
        Err(error) =>
            println(error)
            assert false, "Invalid media document"
        Ok(_) => pass
    content = parsed.unwrap()
    root = el(
        "div",
        {"class": "media-page"},
        [el("a", {"class": "skip-link", "href": "#main"}, [txt("Skip to content")]), media_shell(site_header()), content, media_shell(
            site_footer(),
        )],
    )
    return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"generator\" content=\"Incan · Pallay\"><meta name=\"theme-color\" content=\"#080c0a\"><meta name=\"description\" content=\"Incan media kit: the language, its ecosystem, creator and brand assets. Prepared for the 0.6 website.\"><title>Media kit · Incan</title><link rel=\"icon\" href=\"assets/incan-logo.png\"><link rel=\"stylesheet\" href=\"assets/fonts/fonts.css\"><link rel=\"stylesheet\" href=\"style.css\"><link rel=\"stylesheet\" href=\"media.css\"></head><body>" + render_tree(
        root,
    ) + "</body></html>"


pub def media_stylesheet() -> str:
    return "/* Media resource, sharing the Incapunk 2.0 shell. */\n.media-page h1,.media-page h2,.media-page h3{white-space:normal}.media-main{overflow:hidden}.media-hero{position:relative;background:linear-gradient(90deg,#080c0af5 12%,#080c0ab8 54%,#080c0a50),url('assets/hero-scene.webp') center 55%/cover}.media-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--inc-rail)}.media-hero-inner{display:grid;grid-template-columns:1.5fr 1fr;align-items:center;gap:48px;min-height:390px;padding-block:58px}.media-eyebrow{font-size:10px!important;font-weight:600;text-transform:uppercase;letter-spacing:.16em;color:var(--gold);margin:0 0 20px!important}.media-hero h1{font-size:clamp(42px,5vw,64px);line-height:1.08;letter-spacing:-.04em;margin:0 0 16px;color:var(--text)}.media-hero h1 span{color:var(--gold)}.media-deck{font-size:23px;margin:0 0 16px}.media-intro{max-width:460px;font-size:16px;line-height:1.7;color:var(--muted)}.media-emblem{width:280px;max-width:100%;height:auto;justify-self:center;filter:drop-shadow(0 12px 25px #0008)}.media-jump{display:flex;gap:28px;flex-wrap:wrap;padding-block:22px;border-bottom:1px solid var(--outline);font-size:12px;color:var(--muted)}.media-jump a:hover{color:var(--cyan)}.media-section{padding-block:54px;border-bottom:1px solid var(--outline);scroll-margin-top:110px}.media-section h2{font-size:32px;line-height:1.2;margin:0 0 20px;color:var(--gold-bright)}.media-section h3{font-size:19px;color:var(--text);margin:0 0 13px}.media-section p{font-size:15px;line-height:1.8;color:var(--muted);margin:0 0 20px}.media-overview,.media-people{display:grid;grid-template-columns:1fr 1.3fr;gap:70px}.media-summary{padding:28px 32px;background:#121912;border:1px solid var(--outline);border-top:2px solid var(--gold);border-radius:4px}.media-summary blockquote{font-size:19px;line-height:1.75;margin:0 0 22px;color:var(--text)}.media-link,.media-assets a,.media-tools a{font-size:13px;color:var(--cyan);text-underline-offset:4px}.media-link:hover,.media-assets a:hover,.media-tools a:hover{text-decoration:underline}.media-note{font-size:12px!important;line-height:1.6!important;color:var(--quiet)!important}.media-facts{margin:28px 0 0;padding:0;border-top:1px solid var(--outline)}.media-facts div{display:grid;grid-template-columns:90px 1fr;gap:12px;padding-top:13px;font-size:12px}.media-facts dt{color:var(--quiet)}.media-facts dd{margin:0;color:var(--muted)}.media-section-heading{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;margin-bottom:24px}.media-code-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:start}.media-code-grid pre{margin:0;padding:24px;overflow:auto;font:14px/1.85 var(--mono)}.media-code-grid .panel-heading{padding:12px 20px}.media-code-grid .panel-heading .media-note{font-size:10px!important}.mk-keyword{color:#e6a2f0}.mk-type{color:#62e5e9}.mk-string{color:#e0d995}.media-language-notes h3:not(:first-child){margin-top:30px}.media-tools{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:32px}.media-tools article{border-left:1px solid var(--outline);padding-left:22px}.media-tools .icon{display:block;width:27px;height:27px;margin-bottom:20px}.media-tools small{font-size:10px;color:var(--gold);font-weight:400}.media-vision{border-left:2px solid var(--cyan);padding:4px 0 4px 26px;margin-top:45px;max-width:800px}.media-vision p:last-child{margin:0}.media-story{border-left:1px solid var(--outline);padding-left:32px}.media-assets{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:20px 0}.media-assets .media-asset-card{margin:0;min-width:0;border:1px solid var(--outline);border-radius:5px;overflow:hidden}.media-asset-preview{height:200px;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#1a2824,#080c0a 75%);overflow:hidden}.media-asset-preview img{width:155px;height:155px;object-fit:contain}.media-asset-wordmark img{width:96%;max-width:100%;height:auto;flex-shrink:0}.media-asset-incus{align-items:end}.media-asset-incus img{width:200px;height:200px;object-fit:contain;object-position:bottom}.media-assets .media-asset-caption{padding:20px;border-top:1px solid var(--outline)}.media-assets h3{font-size:16px;margin-bottom:10px}.media-resources{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-block:28px}.media-resources a{border-top:1px solid #86703c;padding-top:18px}.media-resources strong{display:block;color:var(--text);font-size:15px}.media-resources span{display:block;color:var(--cyan);font-size:12px;line-height:1.7;margin-top:10px}.media-attribution{font-size:11px!important;color:var(--quiet)!important;margin:34px 0 0!important}.media-page .community-section{margin-top:65px}.media-page a:focus-visible{outline:2px solid var(--cyan);outline-offset:5px}.media-page .media-mobile-home{display:none}\n@media(max-width:900px){.media-overview,.media-people{gap:32px}.media-hero-inner{gap:20px}.media-code-grid{grid-template-columns:1fr}.media-language-notes{max-width:650px}.media-resources{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:740px){.media-page .media-mobile-home{display:inline-flex}.media-hero-inner{grid-template-columns:1fr 170px;min-height:350px;padding-block:36px}.media-hero h1{font-size:44px}.media-deck{font-size:20px}.media-intro{font-size:14px}.media-overview,.media-people{grid-template-columns:1fr;gap:24px}.media-section{padding-block:36px}.media-section-heading{grid-template-columns:1fr;gap:0;margin-bottom:12px}.media-jump{gap:14px 22px}.media-summary{padding:24px}.media-section h2{font-size:28px}.media-story{padding-left:22px}.media-tools{gap:20px}.media-tools article{padding-left:15px}.media-assets{gap:12px}.media-asset-preview{height:150px}.media-asset-preview img{width:125px;height:125px}.media-asset-wordmark img{width:96%;height:auto}.media-asset-incus img{width:150px;height:150px}.media-assets .media-asset-caption{padding:15px}.media-code-grid pre{font-size:13px;padding:18px}}\n@media(max-width:559px){.media-hero-inner{grid-template-columns:1fr;gap:22px;padding-block:32px}.media-emblem{width:160px;grid-row:2;justify-self:end;margin-top:-15px}.media-hero .hero-actions{gap:10px}.media-hero .button{font-size:12px;padding:10px 13px}.media-hero h1{font-size:42px}.media-tools,.media-assets{grid-template-columns:1fr}.media-tools article{padding:10px 0 14px 20px}.media-asset-preview{height:180px}.media-asset-preview img{width:155px;height:155px}.media-asset-wordmark img{width:96%;height:auto}.media-asset-incus img{width:180px;height:180px}.media-resources{gap:20px}.media-summary blockquote{font-size:17px}.media-facts div{grid-template-columns:65px 1fr}.media-code-grid .panel-heading .media-note{display:none}.media-page .release-status{display:none}}\n\n/* A compact, identity-preserving portrait edit of Katie's original image. */\n.media-people{grid-template-columns:1.65fr 1fr;gap:44px}.media-creator{display:grid;grid-template-columns:140px minmax(0,1fr);gap:26px;align-items:start}.media-portrait{position:relative;width:140px;height:187px;overflow:hidden;border-radius:6px;background:#14201b;border:1px solid #78613d;margin-top:3px}.media-portrait img{display:block;width:100%;height:100%;object-fit:cover}.media-creator-copy{min-width:0}.media-creator-copy h2{font-size:28px}.media-creator-copy .media-eyebrow{margin-bottom:14px!important}\n@media(max-width:1000px){.media-people{grid-template-columns:1fr;gap:32px}.media-story{margin-left:166px}}\n@media(max-width:559px){.media-creator{grid-template-columns:90px minmax(0,1fr);gap:18px}.media-portrait{width:90px;height:120px}.media-creator-copy h2{font-size:24px}.media-creator-copy .media-eyebrow{font-size:9px!important;letter-spacing:.1em}.media-creator-copy p:not(.media-eyebrow){font-size:14px}.media-story{margin-left:0}}\n\n@media(max-width:559px){.media-creator{gap:12px 18px}.media-creator-copy{display:contents}.media-portrait{grid-column:1;grid-row:1 / 3;margin:0}.media-creator-copy .media-eyebrow{grid-column:2;align-self:end;margin:0!important}.media-creator-copy h2{grid-column:2;align-self:start;margin:0}.media-creator-copy p:not(.media-eyebrow),.media-creator-copy>a{grid-column:1 / -1;margin:0}}\n\n.media-prose{max-width:850px}.media-learning{display:grid;grid-template-columns:1fr 1fr;gap:44px;margin-top:30px}.media-learning article{border-left:1px solid var(--outline);padding-left:24px}.media-learning ul{padding-left:18px;color:var(--muted);font-size:14px;line-height:1.8;margin:0 0 22px}.media-learning li{margin-bottom:6px}.media-learning li::marker{color:var(--gold)}.media-vision-restored{margin-top:0}.media-vision-restored p+p{margin-top:20px}.media-creator-links{display:flex;gap:14px 22px;flex-wrap:wrap;margin-top:18px}.media-closing{margin-top:32px!important}.media-people{grid-template-columns:1.8fr 1fr}.media-creator{grid-template-columns:140px minmax(0,1fr)}\n@media(max-width:1000px){.media-people{grid-template-columns:1fr}}\n@media(max-width:559px){.media-learning{grid-template-columns:1fr;gap:30px}.media-creator{grid-template-columns:90px minmax(0,1fr)}.media-creator-links{grid-column:1 / -1;margin-top:6px}.media-creator-copy p:not(.media-eyebrow){margin-top:5px}}\n"


pub def media_description() -> str:
    return "Incan is a modern, statically typed programming language for building native software. It brings readable source and explicit types together with Rust interoperability. Oven provides the shared project and build system, with Incan and Rust code living side by side.\n\nPrepared for the 0.6 website launch. Preview description; consult release notes for shipped scope.\nhttps://incan.io\n"
