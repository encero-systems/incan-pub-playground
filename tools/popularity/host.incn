"""Host boundaries for the trial: curl handles HTTPS; all collection logic is Incan."""
from rust::std::process import Command
from rust::std::string import String as RustString
from std.fs import Path
from std.json import JsonValue, parse


pub def run(program: str, arguments: list[str]) -> Result[str, str]:
    mut command = Command.new(program.to_string())
    for argument in arguments:
        command.arg(argument.to_string())
    match command.output():
        Ok(output) =>
            data: bytes = output.stdout
            if not output.status.success():
                return Err(f"{program} failed")
            match RustString.from_utf8(data):
                Ok(text) => return Ok(text.to_string())
                Err(error) => return Err(f"{error}")
        Err(error) => return Err(f"{program}: {error}")


pub def read(path: str) -> Result[str, str]:
    match Path(path).read_text("utf-8", "strict"):
        Ok(text) => return Ok(text)
        Err(error) => return Err(error.message())


pub def json(text: str) -> Result[JsonValue, str]:
    match parse(text):
        Ok(value) => return Ok(value)
        Err(error) => return Err(error.message())


pub def write_json(path: str, value: JsonValue) -> Result[None, str]:
    match value.to_pretty_json():
        Ok(text) =>
            match Path(path + ".tmp").write_text(text + "\n", "utf-8", "strict", None):
                Err(error) => return Err(error.message())
                Ok(_) => pass
            match Path(path + ".tmp").rename(path):
                Ok(_) => return Ok(None)
                Err(error) => return Err(error.message())
        Err(error) => return Err(error.message())


pub def mkdir(path: str) -> Result[None, str]:
    match Path(path).mkdir(true, true):
        Ok(_) => return Ok(None)
        Err(error) => return Err(error.message())
