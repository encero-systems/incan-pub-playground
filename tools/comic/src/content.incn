"""Examples aligned to the specification PR stack, pinned at PR 2878's head.

The invoice describes both Cents and Invoice. The lock example is an excerpt
with supporting descriptions omitted.
The nested-table example is a complete neutral-core document.
"""

pub def model_example() -> str:
    return "shop.billing.Cents = Record { value: i64 }\nshop.billing.Invoice = Incan.Model {\n    visibility = Public\n    id: Int\n    total: shop.billing.Cents\n}"


pub def value_example() -> str:
    return "shop.billing.Invoice << (id=1,\n    total=(value=1200))"


pub def table_example() -> str:
    return "shop.Buyer = Record { id: i64, name: string }\nshop.Item = Record { id: i64, buyer: shop.Buyer }\n\nshop.Item << [\n    (1, (7, \"ada\")),\n    (2, (9, \"bob\")),\n]"


pub def lock_example() -> str:
    return "oven.Locked << (\n    loaf=pub.crates-io.aho-corasick,\n    version=\"1.1.4\",\n    digest=\"sha256:558ce675…\",\n    signature=Verified(signer=\"…\"),\n    satisfied_by=Source,\n    target_features=[\"perf-literal\", \"std\"],\n    dependencies=[pub.crates-io.memchr],\n)"


pub def spec_url(path: str) -> str:
    return "https://github.com/encero-systems/incan/blob/d1d4e738a9ab4ee96291fcbe05818ceeee1b2cee/specs/comic/" + path
