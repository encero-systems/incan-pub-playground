"""Isolated second-edition front page. The approved original stays unchanged."""
from pub::pallay import DocumentNode
from components import el, node, txt, paragraph, link, code_block, shell, section_heading, value_diagram, representations_diagram, community_banner, navigation_arrow
from content import table_example, lock_example
from benchmarks import benchmark_widget
from ticker import example_ticker
from syntax_highlight import highlight
from theme import stylesheet
from crumb import crumb_chapter


pub def connected_lock() -> DocumentNode:
    mut before: list[DocumentNode] = []
    mut focused: list[DocumentNode] = []
    mut after: list[DocumentNode] = []
    mut stage = 0
    for part in highlight(lock_example()):
        mut text = part.text
        if len(part.children) > 0:
            text = part.children[0].text
        if stage == 0 and text == "dependencies":
            stage = 1
        if stage == 1 and "\n" in text:
            stage = 2
        if stage == 0:
            before.append(part)
        elif stage == 1:
            focused.append(part)
        else:
            after.append(part)
    focused.append(el("img", {"src": "/assets/navigation-arrow.svg", "class": "v2-reference-arrow", "alt": "", "aria-hidden": "true", "width": "40", "height": "20"}, []))
    mut lines = before
    lines.append(el("span", {"class": "v2-code-line v2-link-line"}, focused))
    for part in after:
        lines.append(part)
    code = el("figure", {"class": "code-panel v2-lock-code"}, [node("figcaption", "Incan profile proposal", "code-label"), el("pre", {"tabindex": "0", "aria-label": "Proposed lock value; supporting descriptions omitted and digest shortened"}, [el("code", {}, lines)]), node("p", "Scroll code horizontally", "v2-code-hint")])
    parent = el("div", {"class": "v2-package"}, [node("strong", "aho-corasick"), node("code", "1.1.4")])
    target = el("div", {"class": "v2-package v2-package-target"}, [node("strong", "memchr"), node("code", "2.8.0")])
    scene = el("figure", {"class": "v2-dependency-scene", "aria-label": "The dependencies field names memchr. aho-corasick version 1.1.4 depends on memchr version 2.8.0."}, [node("figcaption", "Resolved dependency", "diagram-caption"), parent, el("div", {"class": "v2-dependency-edge"}, [node("span", "depends on"), navigation_arrow("next")]), target])
    return el("div", {"class": "v2-reference-layout"}, [code, scene])


pub def home_v2() -> DocumentNode:
    hero = el("section", {"class": "hero wrap"}, [el("div", {"class": "hero-title"}, [el("img", {"src": "/assets/yellow-headline-flair.png", "alt": "", "aria-hidden": "true", "class": "headline-flair headline-flair-left"}, []), el("h1", {}, [txt("Data with its "), el("br", {}, []), node("em", "meaning"), txt(" intact.")]), el("img", {"src": "/assets/yellow-headline-flair.png", "alt": "", "aria-hidden": "true", "class": "headline-flair headline-flair-right"}, [])]), paragraph(".COMIC describes models, values and references as readable, canonical text. Crumb encodes the same typed values in binary.", "hero-description"), el("div", {"class": "hero-actions"}, [link("Read the syntax", "/syntax/", "button button-primary"), link("Explore benchmarks", "/benchmarks/", "text-link cyan")]), example_ticker()])
    edition = el("nav", {"class": "v2-edition wrap", "aria-label": "Front page editions"}, [node("span", "EDITION 02", "v2-edition-label"), link("View original", "/"), link("Jump to the examples", "#v2-structure"), link("Meet Crumb", "#v2-crumb")])
    structure = el("section", {"id": "v2-structure", "class": "v2-chapter v2-paper v2-structure wrap"}, [section_heading("01", "Name the structure once.", "Structure"), el("div", {"class": "nested-layout"}, [el("div", {"class": "section-intro"}, [paragraph("Descriptions name the fields, including nested types. The rows carry the values."), link("Read about nested tables", "/syntax/#nested-tables")]), el("div", {}, [code_block(table_example(), ".COMIC · Nested table"), value_diagram()])])])
    references = el("section", {"class": "v2-chapter v2-references wrap"}, [section_heading("02", "A lock file with connections.", "References"), paragraph("Resolved versions and dependencies, represented as typed records.", "section-lead"), connected_lock(), el("div", {"class": "v2-reference-caption"}, [node("span", "One field. An explicit dependency.", "v2-caption"), paragraph("The dependencies field names memchr. Reading the reference does not fetch code.")]), paragraph("Descriptions omitted; digest shortened. Excerpt from the current Incan profile proposal. Oven’s lock remains TOML until the proposal is adopted.", "fine-print muted"), link("See the worked example", "/syntax/#references", "text-link cyan")])
    benchmark = el("section", {"class": "v2-chapter v2-paper v2-benchmark wrap"}, [section_heading("04", "Measure the trade-offs.", "Benchmarks"), paragraph("Historical prototype measurements. These precede the current grammar; explore their results and limitations.", "section-lead"), benchmark_widget()])
    forms = el("section", {"class": "v2-chapter v2-forms wrap"}, [node("span", "05 / Representation", "issue-number"), node("h2", "Readable as .COMIC. Binary as Crumb."), paragraph("Two proposed forms of one typed value model."), representations_diagram(true), paragraph("The core is language-neutral. Incan is the first implementation, currently in progress.", "muted"), el("div", {"class": "closing-links"}, [link("Read the comic with Incus", "/casebook/", "text-link cyan"), link("Read the specification", "/paper/", "text-link cyan")])])
    return shell("/v2/", [edition, hero, structure, references, crumb_chapter(), benchmark, forms, community_banner()], "homepage home-v2")


pub def stylesheet_v2() -> str:
    return stylesheet() + "\n/* Isolated edition: the original page receives none of these rules. */\n.home-v2 .v2-edition{display:flex;gap:24px;align-items:center;padding:18px 0 0;font-size:13px}\n.home-v2 .v2-edition-label{font:500 10px/1.4 'Martian Mono',monospace;color:var(--amber);letter-spacing:.06em}\n.home-v2 .v2-edition a{color:var(--cyan);text-underline-offset:5px}\n.home-v2 .hero{padding-top:38px;padding-bottom:0}\n.home-v2 .v2-chapter{position:relative;isolation:isolate;border:3px solid #000;box-shadow:6px 6px 0 #fff4df24;padding:34px;margin-top:30px;margin-bottom:34px}\n.home-v2 .v2-paper{background:var(--cream);color:var(--ink);color-scheme:light;box-shadow:6px 6px 0 #fff4df2b}\n.home-v2 .v2-paper a{color:var(--teal)}\n.home-v2 .section-heading{padding-bottom:0;margin-bottom:26px;gap:14px}\n.home-v2 .section-heading:after,.home-v2 .section-heading h2:after{content:none;display:none}\n.home-v2 .section-heading h2{font-size:48px}\n.home-v2 .nested-layout{grid-template-columns:190px minmax(0,1fr);gap:30px}\n.home-v2 .section-intro{font-size:18px}\n.home-v2 .nested-layout .code-panel pre{font-size:13px;padding:16px;line-height:1.7}\n.home-v2 .nested-layout .code-panel{margin-bottom:26px}\n.home-v2 .namespace-map{max-width:none}\n.home-v2 .v2-references{background:#18252d;overflow:hidden;padding-bottom:30px}\n.home-v2 .v2-references:before{content:'';position:absolute;z-index:-1;right:-150px;top:-150px;width:540px;height:405px;background:url('/assets/comic-halftone.svg') center/contain no-repeat;opacity:.38;pointer-events:none}\n.home-v2 .v2-reference-layout{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:40px;align-items:end;margin:30px 0 22px}\n.home-v2 .v2-lock-code{margin:0;min-width:0;box-shadow:5px 5px 0 #0005}\n.home-v2 .v2-lock-code pre{font-size:13px;line-height:24px;padding:16px 20px 20px;overflow:visible}\n.home-v2 .v2-lock-code code{white-space:pre}\n.home-v2 .v2-code-line{display:inline-block;position:relative;min-width:100%;height:24px;vertical-align:top}\n.home-v2 .v2-link-line{background:#ffc35a55;box-shadow:-8px 0 0 #ffc35a55,8px 0 0 #ffc35a55}\n.home-v2 .v2-reference-arrow{position:absolute;left:calc(100% + 22px);top:2px;width:40px;height:20px;max-width:none}\n.home-v2 .v2-dependency-scene{margin:0 0 24px;min-width:0}\n.home-v2 .v2-dependency-scene>.diagram-caption{font:500 10px/1.4 'Martian Mono',monospace;color:var(--cream);margin-bottom:15px}\n.home-v2 .v2-package{min-height:64px;background:var(--cream);color:var(--ink);border:2px solid #000;box-shadow:4px 4px 0 #0004;display:flex;align-items:center;justify-content:space-between;padding:10px 12px;gap:8px;font-size:16px}\n.home-v2 .v2-package code{font-size:12px;color:var(--teal)}\n.home-v2 .v2-package-target{border-top:5px solid var(--amber)}\n.home-v2 .v2-dependency-edge{display:flex;align-items:center;justify-content:center;gap:12px;font-size:13px;padding:16px 0}\n.home-v2 .v2-dependency-edge .navigation-arrow{transform:rotate(90deg);width:24px;height:20px}\n.home-v2 .v2-reference-caption{display:flex;align-items:baseline;gap:20px;margin:20px 0}\n.home-v2 .v2-caption{display:inline-block;background:var(--amber);color:var(--ink);font:500 11px/1.5 'Martian Mono',monospace;padding:5px 9px;transform:skew(-6deg);box-shadow:3px 3px 0 #0003;flex-shrink:0}\n.home-v2 .v2-reference-caption p{font-size:15px;margin:0;max-width:45ch}\n.home-v2 .v2-references>.fine-print{margin:18px 0 15px;max-width:85ch}\n.home-v2 .v2-benchmark{padding-bottom:28px}\n.home-v2 .v2-benchmark .benchmark-widget{border:2px solid #111820;box-shadow:4px 4px 0 #11182026;padding:20px 24px 24px;margin-top:28px;background:#fff8ea}\n.home-v2 .v2-benchmark .chart-controls{margin:0 0 24px}\n.home-v2 .v2-benchmark .dataset-chart h3{display:table;background:var(--amber);border:1.5px solid #111820;box-shadow:3px 3px 0 #11182026;padding:7px 12px;font:500 13px/1.4 'Martian Mono',monospace;transform:skew(-5deg);margin-bottom:13px}\n.home-v2 .v2-benchmark .chart-result{display:table;background:var(--amber);padding:8px 12px;border:1px solid #111820;font-size:14px;box-shadow:3px 3px 0 #11182026;margin-top:22px;max-width:100%}\n.home-v2 .v2-benchmark .method-note{background:none}\n.home-v2 .v2-benchmark button{box-shadow:2px 2px 0 #11182026}\n.home-v2 .v2-forms{text-align:left;background:#18252d}\n.home-v2 .v2-forms>.issue-number{display:table;margin-bottom:20px}\n.home-v2 .v2-forms>h2{font-size:43px;max-width:25ch;margin-bottom:16px}\n.home-v2 .v2-forms>p{font-size:18px}\n.home-v2 .representations-diagram{border:2px solid #000;background:var(--cream);color:var(--ink);box-shadow:5px 5px 0 #0004;margin:28px 0;padding:18px}\n.home-v2 .representation-card{box-shadow:none;min-height:215px;border-width:1.5px;padding:14px}\n.home-v2 .representation-card h3{font-size:27px}\n.home-v2 .representation-card pre{font-size:11px;white-space:pre-wrap;overflow-wrap:anywhere}\n.home-v2 .represented-type{overflow-wrap:anywhere;font-size:11px}\n.home-v2 .represented-fields{font-size:12px}\n.home-v2 .flow-forward{color:var(--teal)}\n.home-v2 .flow-backward{color:#926000}\n.home-v2 .representation-footnote{color:#465b5d;margin-bottom:0}\n.home-v2 .representations-flow{grid-template-columns:minmax(0,1fr) 62px minmax(0,1fr) 62px minmax(0,1fr);gap:8px}\n.home-v2 .closing-links{justify-content:flex-start;margin-top:24px}\n.home-v2 .community-banner{padding-top:0}\n.home-v2 .community-incus:before{left:-50px;top:-15px;width:420px;height:315px;opacity:.27}\n@media(max-width:1000px){.home-v2 .v2-chapter{padding:26px}.home-v2 .v2-reference-layout{grid-template-columns:minmax(0,1fr) 180px;gap:32px}.home-v2 .v2-lock-code pre{font-size:11px;padding-left:14px;padding-right:14px}.home-v2 .v2-reference-arrow{left:calc(100% + 16px);width:32px}.home-v2 .v2-reference-caption{display:block}.home-v2 .v2-reference-caption p{margin-top:14px}.home-v2 .nested-layout{grid-template-columns:150px minmax(0,1fr);gap:24px}.home-v2 .representation-card{padding:10px}.home-v2 .representations-flow{grid-template-columns:minmax(0,1fr) 46px minmax(0,1fr) 46px minmax(0,1fr);gap:6px}}\n@media(max-width:780px){.home-v2 .v2-reference-layout{grid-template-columns:minmax(0,1fr)}.home-v2 .v2-reference-arrow{display:none}.home-v2 .v2-lock-code pre{overflow:auto}.home-v2 .v2-code-line{min-width:0;height:auto}.home-v2 .v2-dependency-scene{margin:4px 0 0;display:grid;grid-template-columns:minmax(0,1fr) 85px minmax(0,1fr);align-items:center;gap:10px}.home-v2 .v2-dependency-scene>.diagram-caption{grid-column:1/-1;margin-bottom:0}.home-v2 .v2-dependency-edge{flex-direction:column;gap:6px;padding:0}.home-v2 .v2-dependency-edge .navigation-arrow{transform:none}.home-v2 .v2-package{min-height:72px;flex-direction:column;justify-content:center}.home-v2 .nested-layout{grid-template-columns:minmax(0,1fr)}.home-v2 .section-intro{max-width:58ch;padding-top:0;margin-bottom:0;gap:12px}.home-v2 .representations-flow{grid-template-columns:minmax(0,1fr);max-width:420px}.home-v2 .representation-card{min-height:0;padding:18px}.home-v2 .representation-card pre{font-size:13px}.home-v2 .represented-type{font-size:13px}.home-v2 .represented-fields{font-size:14px}.home-v2 .representations-diagram{padding:20px 14px}.home-v2 .representation-flow{min-height:70px}.home-v2 .representation-card h3{font-size:29px}}\n@media(max-width:600px){.home-v2 .v2-edition{flex-wrap:wrap;gap:10px 18px;padding-top:15px;font-size:12px}.home-v2 .v2-edition-label{width:100%}.home-v2 .hero{padding-top:26px}.home-v2 .v2-chapter{padding:21px 17px;margin-top:22px;margin-bottom:25px;box-shadow:4px 4px 0 #fff4df24}.home-v2 .section-heading h2{font-size:35px}.home-v2 .section-heading{gap:12px;margin-bottom:20px}.home-v2 .nested-layout .code-panel pre{font-size:12px;padding:14px}.home-v2 .v2-reference-layout{margin-top:24px;gap:23px}.home-v2 .v2-lock-code pre{font-size:11px;padding:14px 12px 18px}.home-v2 .v2-lock-code .code-label{font-size:9px;max-width:calc(100% - 24px)}.home-v2 .v2-dependency-scene{grid-template-columns:minmax(0,1fr) 62px minmax(0,1fr);gap:7px}.home-v2 .v2-package{font-size:12px;padding:8px 5px}.home-v2 .v2-dependency-edge{font-size:11px}.home-v2 .v2-caption{font-size:10px}.home-v2 .v2-reference-caption p{font-size:16px}.home-v2 .v2-benchmark .benchmark-widget{padding:17px 12px 18px;margin-top:24px}.home-v2 .v2-benchmark .dataset-chart h3{font-size:12px}.home-v2 .v2-benchmark .chart-controls{margin-bottom:22px}.home-v2 .v2-benchmark .chart-controls label{margin-bottom:10px;display:block}.home-v2 .v2-benchmark .chart-result{font-size:13px;padding:8px}.home-v2 .v2-benchmark .bar-row{grid-template-columns:85px minmax(0,1fr) 53px;gap:6px}.home-v2 .v2-benchmark .bar-label,.home-v2 .v2-benchmark .bar-value{font-size:10px}.home-v2 .v2-benchmark .workload-buttons{gap:8px;flex-wrap:wrap;justify-content:flex-start}.home-v2 .v2-benchmark .workload-buttons button{font-size:10px;padding:7px}.home-v2 .v2-benchmark .method-note{font-size:12px}.home-v2 .v2-forms>h2{font-size:34px}.home-v2 .closing-links{flex-direction:column;align-items:flex-start;gap:16px}.home-v2 .community-incus:before{width:360px;height:270px;left:-30px;top:-5px}}\n\n/* Follow-up: preserve whole-document lexer context and align the diagram with the stored field. */\n.home-v2 .v2-link-line{min-width:calc(100% - 4ch);height:auto;vertical-align:baseline}\n.home-v2 .v2-dependency-scene{margin-bottom:28px}\n.home-v2 .nested-layout{grid-template-columns:210px minmax(0,1fr)}\n.home-v2 .v2-forms>.issue-number{background:var(--amber);color:var(--ink);opacity:1;border:1.5px solid #000;transform:skew(-6deg);box-shadow:3px 3px 0 #0004;font:500 11px/1.4 'Martian Mono',monospace;padding:5px 9px}\n@media(max-width:1000px){.home-v2 .nested-layout{grid-template-columns:160px minmax(0,1fr)}}\n@media(max-width:780px){.home-v2 .v2-link-line{min-width:0}.home-v2 .v2-dependency-scene{margin-bottom:0}.home-v2 .nested-layout{grid-template-columns:minmax(0,1fr)}}\n\n/* Keep print texture behind the diagram on narrow screens, never the heading. */\n.home-v2 .v2-code-hint{display:none}\n@media(max-width:780px){.home-v2 .v2-references:before{display:none}.home-v2 .v2-dependency-scene{position:relative;isolation:isolate}.home-v2 .v2-dependency-scene:before{content:'';position:absolute;z-index:-1;right:-100px;top:-35px;width:280px;height:210px;background:url('/assets/comic-halftone.svg') center/contain no-repeat;opacity:.2;pointer-events:none}.home-v2 .v2-code-hint{display:block;margin:0;padding:0 12px 12px;color:#46646a;font:400 11px/1.4 Barlow,sans-serif}.home-v2 .word-highlight{white-space:nowrap}}\n@media(max-width:600px){.home-v2 .v2-benchmark .bar-label,.home-v2 .v2-benchmark .bar-value{font-size:11px}}\n\n/* The original cyan/amber arrows retain their dark field inside the new paper strip. */\n.home-v2 .representation-flow{background:var(--ink);border:1px solid #000;box-shadow:2px 2px 0 #11182026}\n.home-v2 .flow-forward{color:var(--cyan)}\n.home-v2 .flow-backward{color:var(--amber)}\n@media(max-width:780px){.home-v2 .representation-flow{width:200px;height:80px}.home-v2 .flow-forward{left:140px;right:auto}.home-v2 .flow-backward{right:140px;left:auto}}\n\n/* Reader feedback: compact field placement, teal captions and inked cartoon arrows. */\n.home-v2 .nested-field-label{display:none}\n.home-v2 .item-field{margin-top:16px}\n.home-v2 .v2-benchmark .chart-result{background:var(--teal);color:var(--cream)}\n.home-v2 .representation-flow{background:transparent;border:0;box-shadow:none;height:132px}\n.home-v2 .representation-flow img{height:88px;margin:22px auto}\n.home-v2 .flow-forward{color:var(--teal)}\n.home-v2 .flow-backward{color:#926000}\n/* Incus meets the next panel rather than ending in the gutter. */\n.home-v2 .v2-structure{margin-top:0}\n/* Geometric print fields extend beyond corners; text remains on quiet paper. */\n.home-v2 .v2-paper,.home-v2 .v2-forms{overflow:hidden}\n.home-v2 .v2-paper:before{content:'';position:absolute;z-index:-1;right:-150px;top:-150px;width:540px;height:405px;background:url('/assets/comic-halftone-amber.svg') center/contain no-repeat;opacity:.32;pointer-events:none}\n.home-v2 .v2-forms:before{content:'';position:absolute;z-index:-1;right:-160px;top:-160px;width:540px;height:405px;background:url('/assets/comic-halftone.svg') center/contain no-repeat;opacity:.24;pointer-events:none}\n@media(max-width:780px){.home-v2 .representation-flow{width:200px;height:104px}.home-v2 .representation-flow img{width:100px;height:88px;margin:8px auto}.home-v2 .flow-forward{left:148px;right:auto;top:18px}.home-v2 .flow-backward{right:148px;left:auto;top:68px}}\n@media(max-width:600px){.home-v2 .v2-structure{margin-top:0}.home-v2 .v2-paper:before{width:320px;height:240px;right:-160px;top:-120px;opacity:.2}.home-v2 .v2-forms:before{width:300px;height:225px;right:-180px;top:-100px;opacity:.16}}\n\n/* Keep the narrator inside the chapter edge; scaling from his feet preserves the baseline. */\n.home-v2 .incus-ticker-portrait{transform:scale(.91);transform-origin:bottom right;right:max(0px,calc(50% - 540px))}\n@media(min-width:1101px){.home-v2 .speech-tail{right:calc(370px + max(0px,calc(50% - 555px)))}}\n\n/* Crumb companion chapter: the shared model's binary representation. */\n.home-v2 .v2-crumb{padding-top:30px;padding-bottom:32px}\n.home-v2 .v2-crumb:before{background-image:url('/assets/comic-halftone.svg');opacity:.12}\n.home-v2 .crumb-layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:40px;margin-top:28px;align-items:start}\n.home-v2 .crumb-identity{padding:28px 26px 24px 0;border-right:1px solid var(--paper-rule);align-self:stretch}\n.home-v2 .crumb-logo{width:100%;max-width:300px;height:auto;display:block}\n.home-v2 .crumb-identity-label{font:500 11px/1.4 'Martian Mono',monospace;color:var(--teal);margin:15px 0 18px;letter-spacing:.04em}\n.home-v2 .crumb-identity-note{font-size:18px;line-height:1.5;max-width:21ch;margin:0}\n.home-v2 .crumb-story h2{font:400 48px/1.04 Bangers,sans-serif;margin:0 0 20px}\n.home-v2 .crumb-intro{font-size:20px;line-height:1.5;max-width:49ch;margin-bottom:17px}\n.home-v2 .crumb-detail{font-size:17px;line-height:1.55;max-width:58ch;margin-bottom:24px}\n.home-v2 .crumb-codecs{display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 22px;margin:0 0 20px;border-top:2px solid var(--ink)}\n.home-v2 .crumb-codecs dt,.home-v2 .crumb-codecs dd{margin:0;padding:15px 0;border-bottom:1px solid var(--paper-rule)}\n.home-v2 .crumb-codecs strong{display:block;font:400 25px/1.1 Bangers,sans-serif;margin-bottom:6px}\n.home-v2 .crumb-codecs code{font:400 10px/1.4 'Martian Mono',monospace;color:var(--teal);white-space:nowrap}\n.home-v2 .crumb-codecs dd{font-size:16px;line-height:1.5}\n.home-v2 .crumb-status{font-size:14px;color:#465b5d;margin-bottom:21px}\n.home-v2 .crumb-links{display:flex;gap:16px 25px;flex-wrap:wrap;font-size:15px}\n.home-v2 .representation-crumb-title{background:none;transform:none;padding:0;margin-bottom:9px}\n.home-v2 .representation-crumb-title img{display:block;width:156px;max-width:100%;height:auto}\n@media(max-width:1000px){.home-v2 .crumb-layout{grid-template-columns:220px minmax(0,1fr);gap:26px}.home-v2 .crumb-identity{padding-right:22px}.home-v2 .crumb-story h2{font-size:43px}.home-v2 .crumb-codecs{grid-template-columns:120px minmax(0,1fr);gap:0 16px}}\n@media(max-width:780px){.home-v2 .crumb-layout{grid-template-columns:minmax(0,1fr);gap:25px}.home-v2 .crumb-identity{border-right:0;border-bottom:1px solid var(--paper-rule);padding:0 0 22px}.home-v2 .crumb-logo{max-width:285px}.home-v2 .crumb-identity-label{margin:10px 0 12px}.home-v2 .crumb-identity-note{max-width:none;font-size:17px}.home-v2 .crumb-story h2{font-size:42px}.home-v2 .crumb-intro{font-size:19px}}\n@media(max-width:480px){.home-v2 .crumb-layout{margin-top:23px}.home-v2 .crumb-logo{max-width:260px}.home-v2 .crumb-story h2{font-size:38px}.home-v2 .crumb-detail{font-size:16px}.home-v2 .crumb-codecs{grid-template-columns:112px minmax(0,1fr);gap:0 13px}.home-v2 .crumb-codecs dd{font-size:15px}.home-v2 .crumb-codecs strong{font-size:23px}.home-v2 .crumb-codecs code{font-size:9px}.home-v2 .crumb-links{flex-direction:column;align-items:flex-start;font-size:15px;gap:15px}}\n\n.home-v2 .v2-crumb>.issue-number{display:table;opacity:1;border:1.5px solid var(--ink);background:var(--amber);color:var(--ink);font:500 11px/1.3 'Martian Mono',monospace;padding:5px 10px;transform:skew(-6deg);box-shadow:3px 3px 0 #11182026}\n"
