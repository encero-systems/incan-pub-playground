"""The .COMIC publication: approved homepage, syntax guide, evidence and design paper."""
from pub::pallay import DocumentNode
from components import el, node, txt, paragraph, link, code_block, shell, section_heading, value_diagram, dependency_diagram, representations_diagram, community_banner
from content import model_example, value_example, table_example, lock_example, spec_url
from benchmarks import benchmark_widget, results_table
from ticker import example_ticker


pub def home() -> DocumentNode:
    hero = el("section", {"class": "hero wrap"}, [el("div", {"class": "hero-title"}, [el("img", {"src": "/assets/yellow-headline-flair.png", "alt": "", "aria-hidden": "true", "class": "headline-flair headline-flair-left"}, []), el("h1", {}, [txt("Data with its "), el("br", {}, []), node("em", "meaning"), txt(" intact.")]), el("img", {"src": "/assets/yellow-headline-flair.png", "alt": "", "aria-hidden": "true", "class": "headline-flair headline-flair-right"}, [])]), paragraph(".COMIC describes models, values, and the references between them as readable, canonical data.", "hero-description"), el("div", {"class": "hero-actions"}, [link("Read the syntax", "/syntax/", "button button-primary"), link("Explore benchmarks", "/benchmarks/", "text-link cyan")]), example_ticker()])
    nested = el("section", {"class": "paper-section"}, [el("div", {"class": "wrap"}, [section_heading("01", "Name the structure once.", "Structure"), el("div", {"class": "nested-layout"}, [el("div", {"class": "section-intro"}, [paragraph("Descriptions name the fields, including nested types. The rows carry the values."), link("Read about nested tables", "/syntax/#nested-tables")]), el("div", {}, [code_block(table_example(), ".COMIC · Nested table"), value_diagram()])])])])
    lock = el("section", {"class": "lock-section wrap"}, [section_heading("02", "A lock file with connections.", "References"), paragraph("Resolved versions and dependencies, represented as typed records.", "section-lead"), code_block(lock_example(), "Incan profile proposal · Descriptions omitted; digest shortened"), dependency_diagram(), paragraph("Excerpt from the current Incan profile proposal. Oven’s lock remains TOML until the proposal is adopted.", "fine-print muted"), link("See the worked example", "/syntax/#references", "text-link cyan")])
    benchmark = el("section", {"class": "paper-section"}, [el("div", {"class": "wrap"}, [section_heading("03", "Measure the trade-offs.", "Benchmarks"), paragraph("Historical prototype measurements. These precede the current grammar; explore their results and limitations.", "section-lead"), benchmark_widget()])])
    closing = el("section", {"class": "closing wrap"}, [node("h2", "Readable as .COMIC. Binary as Crumb."), paragraph("Two proposed forms of one typed value model."), representations_diagram(), paragraph("The core is language-neutral. Incan is the first implementation, currently in progress.", "muted"), el("div", {"class": "closing-links"}, [link("Read the comic with Incus", "/casebook/", "text-link cyan"), link("Read the specification", "/paper/", "text-link cyan")])])
    return shell("/", [hero, nested, lock, benchmark, closing, community_banner()], "homepage")


def article(title: str, intro: str, active: str, children: list[DocumentNode]) -> DocumentNode:
    body = [el("div", {"class": "article-heading wrap"}, [link(".COMIC /", "/", "breadcrumb"), node("p", "DESIGN DRAFT / NOVEMBER 2026", "eyebrow"), node("h1", title), paragraph(intro, "article-lead")]), el("div", {"class": "paper-section article-paper"}, [el("article", {"class": "reading wrap"}, children)])]
    return shell(active, body, "article-page")


pub def syntax() -> DocumentNode:
    return article("A little syntax. A lot of meaning.", "The three forms, as specified in the current PR stack.", "/syntax/", [paragraph("Aligned to the specification stack through PR #2878. The source labels its text rules draft and its profiles experimental. Profile excerpts below omit supporting descriptions.", "callout"), link("Try the syntax highlighting lab", "/syntax/highlighting/", "button button-primary syntax-lab-link"), el("nav", {"class": "contents", "aria-label": "On this page"}, [link("Three forms", "#models"), link("References", "#references"), link("Tables", "#nested-tables"), link("Canonical output", "#canonical"), link("Two forms", "#two-forms")]), el("section", {"id": "models"}, [section_heading("01", "Three forms. Three meanings."), code_block("path = Kind { … }\nType << ( … )\nType << [ … ]", "Description / one value / several values"), paragraph("A description declares fields with a colon and properties with an equals sign. One value names its type with << and puts its stored cells in parentheses. A table carries several values of that type, one per row."), code_block(model_example(), "Descriptions · Incan profile + neutral core"), code_block(value_example(), "One value · Named stored fields"), paragraph("Incan.Model is a language-profile kind. It uses Incan's own types and maps into the neutral Record model. The core also works without a language profile, as the complete table example below shows."), paragraph("Reading stored state does not replay constructors, defaults or field methods. Final-state validation still applies.")]), el("section", {"id": "references"}, [section_heading("02", "A reference is more than text."), code_block("shop.billing.Cents\n\"shop.billing.Cents\"", "Reference literal / string literal · Excerpts"), paragraph("An unquoted declaration path is a reference. Its quoted spelling is a string. The slot’s declared type determines what is admitted. Reading a reference never follows it or fetches code."), code_block(lock_example(), "Proposed Oven lock excerpt · Descriptions omitted; digest shortened"), dependency_diagram(), paragraph("The current Incan profile keeps the proposed lock document separate from the adopted format: oven.lock remains TOML until this proposal is adopted.", "method-note")]), el("section", {"id": "nested-tables"}, [section_heading("03", "Name the structure once."), paragraph("Descriptions name the record fields and the types nested within them. Rows fill those fields in declaration order. Every row remains one value with its own hashes; the table is layout."), code_block(table_example(), "Complete neutral-core document"), value_diagram(), paragraph("The first row holds shop.Item id 1 with a buyer whose id is 7 and name is ada. The document declares both types before the values. A standalone value prints present fields by name; rows print positions until their first absent field.")]), el("section", {"id": "canonical"}, [section_heading("04", "One canonical text."), paragraph("Readers accept whitespace between tokens. The printer places descriptions first, sorted by path, then values in their written order. It prints a field’s declared absent value by omission, preserves exact typed literals, and follows a fixed 120-column layout."), paragraph("A current text example is a decimal such as 19.90d in a decimal<10, 2> slot. Integers are exact values constrained by their declared width. A field supplied twice is refused rather than resolved by keeping the last value."), link("Read every text rule", spec_url("spec/text.md"))]), el("section", {"id": "two-forms"}, [section_heading("05", "One model. Two forms."), paragraph(".COMIC is readable text; Crumb is binary storage of the same logical typed values. The specification stack defines experimental row and column codecs with separate physical choices."), paragraph(".COMIC text is never sealed. A sealed Crumb set carries a count and a logical-value hash that must be verified before values are exposed. Integrity does not prove authorship."), link("Read the current binary contract", spec_url("spec/binary.md"))])])


pub def benchmarks() -> DocumentNode:
    return article("Measure the trade-offs.", "Historical prototype measurements, with the workloads and caveats left in.", "/benchmarks/", [paragraph("Historical results from the earlier .COMIC Syntax paper. They use the earlier syntax and are not measurements of the current PR grammar. These benchmarks have not been rerun.", "callout"), benchmark_widget(), section_heading("01", "Every workload counts."), results_table(), paragraph("In this historical experiment, .COMIC minified used fewer tokens than TOON in 6 of these 8 workloads. TOON wins on keyed feature flags and nested contact groups. CSV is smaller on the three flat workloads where the paper includes it."), el("section", {"id": "methodology"}, [section_heading("02", "Read the fine print."), el("dl", {"class": "methodology"}, [node("dt", "Source workloads"), node("dd", "Eight TOON-derived datasets; upstream commit reported as 9622df2."), node("dt", "Tokenizer"), node("dd", "gpt-tokenizer, o200k_base. Counts describe text tokens, not runtime speed or memory."), node("dt", "Schema cost"), node("dd", "The .COMIC model was inferred from each dataset. Schema text is excluded from these data-text counts."), node("dt", "Formatting"), node("dd", "Minified and formatted .COMIC are different conditions. Per-dataset formatted counts are shown only where available in the paper."), node("dt", "Readback"), node("dd", "The earlier prototype treated missing fields and None as equivalent. That historical test condition does not establish conformance to the current absent-value rules."), node("dt", "Adaptation"), node("dd", "The nested header was adopted after observing results. These measurements are exploratory."), node("dt", "Not measured"), node("dd", ".COMIC LLM reading accuracy, a complete Crumb codec, and production parsing or encoding performance.")])]), section_heading("03", "Totals need context."), paragraph("Across these eight datasets: .COMIC minified 248,122 tokens, TOON 333,101, and JSON compact 366,978. Formatted .COMIC totals 294,577 tokens."), paragraph("That is 25.51% fewer aggregate tokens for minified .COMIC than TOON, and 11.57% fewer for formatted .COMIC. These are reductions in the sums, not the average reduction per dataset. Larger workloads dominate the total."), paragraph("Other data shapes in the paper have different outcomes. .COMIC loses on a generated sparse, wide dataset. Experimental binary-layout comparisons are separate from these text measurements."), el("div", {"class": "download-links"}, [link("Download measurement data (JSON)", "/assets/benchmarks.json"), link("Read specification and historical sources", "/paper/")])])


pub def paper() -> DocumentNode:
    return article("The specification, in the open.", "The current .COMIC and Crumb contracts live in the Incan specification PR stack.", "/paper/", [paragraph("This site follows the stack through PR #2878, pinned to commit fce42c413917d0fb2f696044f98fb3e69e7f1a61. The PRs are open; the source labels the contracts experimental and the text rules draft. This is not a released implementation claim.", "callout"), section_heading("01", "Read the current contracts."), el("div", {"class": "spec-links"}, [link("Typed values and shapes", spec_url("spec/values.md")), link("Text grammar and canonical printing", spec_url("spec/text.md")), link("Identity and hash projections", spec_url("spec/hashes.md")), link("Binary representation and sealed sets", spec_url("spec/binary.md")), link("Row codec", spec_url("spec/row-v1.md")), link("Column codec", spec_url("spec/columns-v1.md")), link("Incan language profile", spec_url("profiles/incan.md")), link("Conformance corpus contract", spec_url("spec/conformance.md"))]), section_heading("02", "Follow the specification PRs."), el("div", {"class": "spec-links"}, [link("#2775 · Value, identity and compatibility foundation", "https://github.com/encero-systems/incan/pull/2775"), link("#2777 · Text grammar and profiles", "https://github.com/encero-systems/incan/pull/2777"), link("#2782 · Read and print corpus", "https://github.com/encero-systems/incan/pull/2782"), link("#2783 · Hash preimages and vectors", "https://github.com/encero-systems/incan/pull/2783"), link("#2787 · Row layout and vectors", "https://github.com/encero-systems/incan/pull/2787"), link("#2790 · Column layout and vectors", "https://github.com/encero-systems/incan/pull/2790"), link("#2791 · Description property ordering", "https://github.com/encero-systems/incan/pull/2791"), link("#2878 · Reading wording and lock signature", "https://github.com/encero-systems/incan/pull/2878")]), el("section", {"id": "open-questions"}, [section_heading("03", "Contract and proof are separate."), paragraph("A specified rule is not proof of a delivered codec. Conformance needs independently authored text and byte vectors, refusal cases and implementation receipts that state their exact coverage."), paragraph("The text rules still list date and time literal spelling as open. The Incan profile separately lists kind descriptions as open. Row and column storage choices do not establish a universal zero-copy or performance claim."), link("Follow the story with Detective Incus", "/casebook/")]), section_heading("04", "Earlier design study."), paragraph("The earlier .COMIC Syntax paper remains available as historical context. Its syntax and exploratory measurements predate the current PR grammar; it is not the current format authority."), link("Open the earlier paper (historical)", "/assets/COMIC-Syntax.html"), paragraph("Repository license: Apache License 2.0.", "fine-print")])
