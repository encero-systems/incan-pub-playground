dge, and keep narrow view labels within their buttons. */\n.field-test .ft-league-paper{background-position:calc(100% + 95px) -30px}\n@media(max-width:600px){.field-test .ft-lenses button{font-size:21px;padding:9px 3px}}\n\n.field-test[data-view=speed] .ft-stage{align-items:start}\n\n/* The compactness lens restores the original case-file composition. */\n.field-test .ft-narrator>img.ft-incus-casefile,.field-test .ft-speech-casefile{display:none}\n.field-test[data-view=compactness] .ft-narrator>img.ft-incus-watch,.field-test[data-view=compactness] .ft-speech-watch{display:none}\n.field-test[data-view=compactness] .ft-narrator>img.ft-incus-casefile,.field-test[data-view=compactness] .ft-speech-casefile{display:flex}\n.field-test[data-view=compactness] .ft-stage{grid-template-columns:minmax(0,1fr) 265px;align-items:start}\n.field-test[data-view=compactness] .ft-cases{grid-column:1;grid-row:1}\n.field-test[data-view=compactness] .ft-narrator{display:flex;grid-column:2;grid-row:1;margin:0 -15px 0 0;align-items:center}\n.field-test[data-view=compactness] .ft-narrator>img.ft-incus-casefile{width:300px;max-width:none;margin:0 -12px 0 0;mask-image:linear-gradient(#000 86%,transparent 99%)}\n@media(max-width:1100px){.field-test[data-view=compactness] .ft-stage{grid-template-columns:minmax(0,1fr) 190px}.field-test[data-view=compactness] .ft-narrator>img.ft-incus-casefile{width:220px;margin:0}}\n@media(max-width:900px){.field-test[data-view=compactness] .ft-stage{display:flex;flex-direction:column;align-items:stretch}.field-test[data-view=compactness] .ft-cases{order:0}.field-test[data-view=compactness] .ft-narrator{order:1;display:flex;flex-direction:row;justify-content:center;align-items:center;align-self:center;margin:23px 0 -8px;width:380px;max-width:100%}.field-test[data-view=compactness] .ft-narrator>img.ft-incus-casefile{width:210px;max-width:55%;margin:0}.field-test[data-view=compactness] .ft-speech-casefile{width:170px;max-width:45%;height:130px;font-size:24px;padding:19px 21px 39px;margin:0}}\n@media(max-width:600px){.field-test[data-view=compactness] .ft-narrator{width:320px}.field-test[data-view=compactness] .ft-narrator>img.ft-incus-casefile{width:175px}.field-test[data-view=compactness] .ft-speech-casefile{width:140px;height:112px;font-size:19px;padding:15px 15px 32px}}\n\n@media(min-width:1101px){.field-test[data-view=compactness] .ft-stage{grid-template-columns:minmax(0,1fr) 340px}.field-test[data-view=compactness] .ft-narrator>img.ft-incus-casefile{position:relative;z-index:2;width:360px;margin:0 -12px 0 0}.field-test[data-view=compactness] .ft-speech-casefile{position:absolute;z-index:1;left:-20px;top:0;width:185px;height:140px;font-size:25px;padding:20px 20px 40px;margin:0}}\n/* Brand the callouts only when the panel itself has room. */\n.field-test .ft-league{container-type:inline-size}\n.field-test .ft-league-mark{display:none;width:112px;height:40px;object-fit:contain;flex:none}\n.field-test .ft-league-title>span{white-space:nowrap}\n@container(min-width:460px){.field-test .ft-league-title{display:inline-flex;align-items:center;gap:14px}.field-test .ft-league-mark{display:block}}\n\n/* Point this balloon toward the case-file narrator, keeping the lettering upright. */\n.field-test .ft-speech-casefile{transform:scaleX(-1)}\n.field-test .ft-speech-casefile>span{display:block;transform:scaleX(-1)}\n\n"
