"""Edition 03: Incus introduces the readable and binary forms together."""
from pub::pallay import DocumentNode
from components import el, node, txt, paragraph, link, code_block, shell, section_heading, value_diagram, community_banner
from content import table_example
from benchmarks import benchmark_widget
from ticker import example_ticker
from crumb import crumb_chapter
from v2 import connected_lock, stylesheet_v2


def incus_comparison() -> DocumentNode:
    comic = el("article", {"class": "v3-form v3-form-comic"}, [el("h3", {}, [el("img", {"src": "/assets/dot-comic-logo-amber.png", "alt": ".COMIC", "width": "400", "height": "160", "class": "v3-form-logo v3-comic-logo"}, [])]), node("span", "01 / Readable text", "v3-form-label"), paragraph("Read it. Write it. Review it.", "v3-form-summary"), el("pre", {"aria-label": ".COMIC value excerpt; supporting descriptions omitted"}, [node("code", "shop.billing.Invoice\n<< (id=1, total=(value=1200))")]), paragraph("Canonical text keeps descriptions and values explicit.", "v3-form-detail"), node("span", "Parse / Print", "v3-form-operation")])
    incus = el("div", {"class": "v3-comparison-incus"}, [el("img", {"src": "/assets/incus-two-forms.png", "alt": "Detective Incus tips his fedora between the readable .COMIC and binary Crumb forms", "width": "1142", "height": "1377", "loading": "lazy", "decoding": "async"}, [])])
    crumb = el("article", {"class": "v3-form v3-form-crumb"}, [el("h3", {}, [el("img", {"src": "/assets/crumb-logo.svg", "alt": "Crumb", "width": "400", "height": "128", "class": "v3-form-logo"}, [])]), node("span", "02 / Typed binary", "v3-form-label"), paragraph("Encode it. Read it back.", "v3-form-summary"), el("dl", {"class": "v3-codec-pair"}, [node("dt", "Row codec"), node("dd", "Record by record"), node("dt", "Column codec"), node("dd", "Field by field")]), paragraph("The binary form keeps the same type, fields and values.", "v3-form-detail"), node("span", "Encode / Decode", "v3-form-operation")])
    shared = el("div", {"class": "v3-shared-value"}, [node("strong", "One typed value"), node("code", "shop.billing.Invoice"), el("div", {"class": "v3-value-fields"}, [node("span", "id = 1"), node("span", "total = (value=1200)")])])
    return el("figure", {"class": "v3-comparison", "aria-label": ".COMIC and Crumb represent the same typed value. Detective Incus stands between their logos."}, [el("div", {"class": "v3-comparison-scene"}, [comic, incus, crumb]), shared, node("figcaption", "Illustrated comparison · value excerpt omits supporting descriptions · Crumb codec profiles are experimental.", "v3-comparison-note")])


pub def home_v3() -> DocumentNode:
    hero = el("section", {"class": "hero wrap"}, [el("div", {"class": "hero-title"}, [el("img", {"src": "/assets/yellow-headline-flair.png", "alt": "", "aria-hidden": "true", "class": "headline-flair headline-flair-left"}, []), el("h1", {}, [txt("Data with its "), el("br", {}, []), node("em", "meaning"), txt(" intact.")]), el("img", {"src": "/assets/yellow-headline-flair.png", "alt": "", "aria-hidden": "true", "class": "headline-flair headline-flair-right"}, [])]), paragraph(".COMIC describes models, values and references as readable, canonical text. Crumb encodes the same typed values in binary.", "hero-description"), el("div", {"class": "hero-actions"}, [link("Read the syntax", "/syntax/", "button button-primary"), link("Explore benchmarks", "/benchmarks/", "text-link cyan")]), example_ticker()])
    edition = el("nav", {"class": "v2-edition wrap", "aria-label": "Front page editions"}, [node("span", "EDITION 03", "v2-edition-label"), link("Edition 02", "/v2/"), link("Jump to the examples", "#v2-structure"), link("Meet Crumb", "#v2-crumb"), link("The two forms", "#v3-forms")])
    structure = el("section", {"id": "v2-structure", "class": "v2-chapter v2-paper v2-structure wrap"}, [section_heading("01", "Name the structure once.", "Structure"), el("div", {"class": "nested-layout"}, [el("div", {"class": "section-intro"}, [paragraph("Descriptions name the fields, including nested types. The rows carry the values."), link("Read about nested tables", "/syntax/#nested-tables")]), el("div", {}, [code_block(table_example(), ".COMIC · Nested table"), value_diagram()])])])
    references = el("section", {"class": "v2-chapter v2-references wrap"}, [section_heading("02", "A lock file with connections.", "References"), paragraph("Resolved versions and dependencies, represented as typed records.", "section-lead"), connected_lock(), el("div", {"class": "v2-reference-caption"}, [node("span", "One field. An explicit dependency.", "v2-caption"), paragraph("The dependencies field names memchr. Reading the reference does not fetch code.")]), paragraph("Descriptions omitted; digest shortened. Excerpt from the current Incan profile proposal. Oven’s lock remains TOML until the proposal is adopted.", "fine-print muted"), link("See the worked example", "/syntax/#references", "text-link cyan")])
    benchmark = el("section", {"class": "v2-chapter v2-paper v2-benchmark wrap"}, [section_heading("04", "Measure the trade-offs.", "Benchmarks"), paragraph("Historical prototype measurements. These precede the current grammar; explore their results and limitations.", "section-lead"), benchmark_widget()])
    forms = el("section", {"id": "v3-forms", "class": "v2-chapter v2-forms v3-forms wrap"}, [node("span", "05 / Two forms", "issue-number"), el("h2", {}, [txt("Two forms. One "), node("em", "meaning"), txt(".")]), paragraph("Readable as .COMIC. Binary as Crumb. The same typed values, either way.", "v3-comparison-lead"), incus_comparison(), paragraph("The core is language-neutral. Incan is the first implementation, currently in progress.", "muted"), el("div", {"class": "closing-links"}, [link("See how it works", "/assets/how-it-works.html", "text-link cyan"), link("Read the specification", "/paper/", "text-link cyan")])])
    return shell("/v3/", [edition, hero, structure, references, crumb_chapter(), benchmark, forms, community_banner()], "homepage home-v2 home-v3")


pub def stylesheet_v3() -> str:
    return stylesheet_v2() + "\n/* Edition 03 puts Incus between the two representations. Edition 02 stays frozen. */\n.home-v3 .v3-forms{padding-bottom:30px}\n.home-v3 .v3-forms>h2{font-size:54px;max-width:none;margin-bottom:12px}\n.home-v3 .v3-forms>h2 em{font-style:normal;color:var(--amber)}\n.home-v3 .v3-comparison-lead{max-width:60ch}\n.home-v3 .v3-comparison{margin:30px 0 28px;position:relative;isolation:isolate}\n.home-v3 .v3-comparison-scene{display:grid;grid-template-columns:minmax(0,1fr) 330px minmax(0,1fr);gap:0;align-items:end;position:relative;padding:22px 0 0;isolation:isolate}\n.home-v3 .v3-comparison-scene:before{content:'';position:absolute;z-index:-2;left:10%;right:10%;height:140px;bottom:8px;background:var(--teal);transform:skew(-5deg);border:2px solid #000;box-shadow:5px 5px 0 #0004}\n.home-v3 .v3-comparison-scene:after{content:'';position:absolute;z-index:-1;left:25%;right:25%;top:-20px;bottom:0;background:url('/assets/comic-halftone.svg') center/contain no-repeat;opacity:.35}\n.home-v3 .v3-form{position:relative;z-index:2;background:var(--cream);color:var(--ink);border:2px solid #000;box-shadow:5px 5px 0 #0005;padding:19px 18px 16px;min-width:0;margin-bottom:35px}\n.home-v3 .v3-form-comic{transform:rotate(-1deg)}\n.home-v3 .v3-form-crumb{transform:rotate(1deg)}\n.home-v3 .v3-form h3{margin:0 0 13px;padding:0;line-height:1;background:none;transform:none;height:82px;display:flex;align-items:center}\n.home-v3 .v3-form-logo{width:200px;max-width:100%;height:64px;object-fit:contain;object-position:left center;display:block}\n.home-v3 .v3-comic-logo{width:190px;height:95px;object-position:left center}\n.home-v3 .v3-form-label{font:500 10px/1.5 'Martian Mono',monospace;display:block;color:var(--teal);margin-bottom:15px}\n.home-v3 .v3-form-summary{font-weight:600;font-size:18px;line-height:1.35;margin:0 0 17px}\n.home-v3 .v3-form pre{font:400 11px/1.8 'Martian Mono',monospace;white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 16px;background:none;padding:0;color:var(--ink);min-height:60px}\n.home-v3 .v3-form-detail{font-size:15px;line-height:1.5;margin:0 0 19px}\n.home-v3 .v3-form-operation{display:table;font:500 10px/1.4 'Martian Mono',monospace;background:var(--amber);padding:5px 9px;border:1px solid var(--ink);box-shadow:2px 2px 0 #11182026;transform:skew(-5deg)}\n.home-v3 .v3-form-crumb .v3-form-operation{background:#ccebed}\n.home-v3 .v3-codec-pair{font-size:14px;line-height:1.5;display:grid;grid-template-columns:auto auto;gap:6px 12px;margin:0 0 16px;min-height:60px}\n.home-v3 .v3-codec-pair dt{font-weight:600}\n.home-v3 .v3-codec-pair dd{margin:0}\n.home-v3 .v3-comparison-incus{position:relative;align-self:end;z-index:1;margin:0 -16px;pointer-events:none}\n.home-v3 .v3-comparison-incus img{width:100%;height:auto;display:block;filter:drop-shadow(5px 5px 0 #0004)}\n.home-v3 .v3-shared-value{position:relative;z-index:3;background:#ccebed;color:var(--ink);border:2px solid #000;box-shadow:5px 5px 0 #0004;padding:15px 20px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px}\n.home-v3 .v3-shared-value strong{font:400 26px/1.1 Bangers,sans-serif}\n.home-v3 .v3-shared-value>code{font:500 11px/1.5 'Martian Mono',monospace;color:var(--teal)}\n.home-v3 .v3-value-fields{display:flex;flex-wrap:wrap;gap:10px;margin-left:auto}\n.home-v3 .v3-value-fields span{font:500 11px/1.5 'Martian Mono',monospace;border:1px solid var(--ink);background:var(--cream);padding:6px 9px;box-shadow:2px 2px 0 #11182026;transform:skew(-5deg)}\n.home-v3 .v3-comparison-note{font-size:12px;line-height:1.5;color:#c4cfd0;margin-top:15px}\n@media(max-width:1100px){.home-v3 .v3-comparison-scene{grid-template-columns:minmax(0,1fr) 260px minmax(0,1fr)}.home-v3 .v3-form{padding:15px 13px}.home-v3 .v3-form-summary{font-size:16px}.home-v3 .v3-codec-pair{grid-template-columns:1fr;gap:0;line-height:1.35}.home-v3 .v3-codec-pair dd{margin-bottom:6px}.home-v3 .v3-form pre{font-size:10px}.home-v3 .v3-value-fields{margin-left:0}}\n@media(max-width:850px){.home-v3 .v3-comparison-scene{grid-template-columns:minmax(0,1fr) 200px minmax(0,1fr)}.home-v3 .v3-form-logo{height:48px}.home-v3 .v3-form h3{height:65px}.home-v3 .v3-comic-logo{height:80px}.home-v3 .v3-form-detail{font-size:14px}.home-v3 .v3-form{margin-bottom:25px}.home-v3 .v3-form-summary{min-height:44px}.home-v3 .v3-forms>h2{font-size:45px}}\n@media(max-width:700px){.home-v3 .v3-comparison-scene{grid-template-columns:1fr 1fr;gap:14px;padding-top:6px}.home-v3 .v3-form{grid-row:1;align-self:start;transform:none;margin:0;padding:14px 11px}.home-v3 .v3-form-comic{grid-column:1}.home-v3 .v3-form-crumb{grid-column:2}.home-v3 .v3-form-logo{height:43px}.home-v3 .v3-form h3{height:60px}.home-v3 .v3-comic-logo{height:auto;max-height:75px}.home-v3 .v3-form-label{font-size:9px;margin-bottom:11px}.home-v3 .v3-form-summary{font-size:16px;margin-bottom:13px;min-height:43px}.home-v3 .v3-form pre{font-size:9px;min-height:78px;line-height:1.75}.home-v3 .v3-form-detail{font-size:14px;margin-bottom:14px}.home-v3 .v3-form-operation{font-size:9px;padding:5px 6px}.home-v3 .v3-codec-pair{font-size:13px;min-height:78px}.home-v3 .v3-comparison-incus{grid-column:1/-1;grid-row:2;width:260px;margin:-2px auto 0}.home-v3 .v3-comparison-scene:before{bottom:12px;left:0;right:0;height:100px}.home-v3 .v3-comparison-scene:after{top:auto;bottom:20px;left:0;right:0;height:280px}.home-v3 .v3-shared-value{padding:15px;gap:12px}.home-v3 .v3-shared-value strong{font-size:26px}.home-v3 .v3-value-fields{gap:8px}.home-v3 .v3-value-fields span{font-size:10px;padding:6px}.home-v3 .v3-forms>h2{font-size:38px}.home-v3 .v3-forms>p{font-size:17px}}\n"
