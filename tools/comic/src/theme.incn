amber);color:var(--ink);font:600 11px/1.3 'Martian Mono',monospace;padding:5px 10px;transform:skew(-6deg);box-shadow:2px 2px 0 var(--ink)}\n.homepage .section-heading h2,.case-scene h2{position:relative;isolation:isolate;width:fit-content}.homepage .paper-section .section-heading h2:before,.case-panel:not(.case-cover) .case-scene h2:before{content:'';position:absolute;left:-4px;bottom:3px;width:67%;height:12px;z-index:-1;background:var(--amber);transform:rotate(-1deg) skew(-12deg);opacity:.65;pointer-events:none}.homepage .lock-section .section-heading h2:after{content:'';position:absolute;right:-25px;top:-13px;width:27px;height:25px;background:linear-gradient(90deg,transparent 45%,var(--amber) 45% 55%,transparent 55%) 0 0/12px 13px no-repeat,linear-gradient(135deg,transparent 43%,var(--amber) 43% 54%,transparent 54%) 11px 8px/16px 16px no-repeat;transform:rotate(15deg);pointer-events:none}\n.panel-tab{max-width:100%;white-space:normal;line-height:1.5!important;box-shadow:2px 2px 0 var(--ink)}\n.navigation-arrow{display:inline-block;width:20px;height:16px;flex:0 0 20px;vertical-align:middle;pointer-events:none}.arrow-previous{transform:scaleX(-1)}.ticker-controls button,.case-controls button{display:inline-flex;align-items:center;justify-content:center;gap:6px}.ticker-controls .navigation-arrow{width:15px;height:13px;flex-basis:15px}.ticker-controls button{padding-left:7px;padding-right:7px}.case-controls button:hover .arrow-next{transform:translateX(2px)}.case-controls button:hover .arrow-previous{transform:scaleX(-1) translateX(2px)}\n.incus-speaker-image{display:block;width:100%;height:auto}.visor-glint{position:absolute;left:26%;top:43%;width:36%;height:13%;clip-path:polygon(9% 0,100% 31%,89% 100%,0 63%);background:linear-gradient(110deg,transparent 35%,#40ffff99 44%,#e4ffff 49%,#40ffff99 54%,transparent 63%);background-size:280% 100%;opacity:0;pointer-events:none}\n.ticker-example:not([hidden]),.case-panel:not([hidden]){animation:panel-arrive 260ms cubic-bezier(.2,.7,.3,1) both}\n@keyframes panel-arrive{from{transform:translateX(9px) rotate(.15deg)}to{transform:translateX(0) rotate(0)}}\n.hero-showcase:has(#hero-example-0:not([hidden])) .visor-glint{animation:visor-glint-0 620ms ease-out 100ms both}\n@keyframes visor-glint-0{0%{background-position:100% 0;opacity:0}25%{opacity:.65}70%{opacity:.45}100%{background-position:0% 0;opacity:0}}\n.hero-showcase:has(#hero-example-1:not([hidden])) .visor-glint{animation:visor-glint-1 620ms ease-out 100ms both}\n@keyframes visor-glint-1{0%{background-position:100% 0;opacity:0}25%{opacity:.65}70%{opacity:.45}100%{background-position:0% 0;opacity:0}}\n.hero-showcase:has(#hero-example-2:not([hidden])) .visor-glint{animation:visor-glint-2 620ms ease-out 100ms both}\n@keyframes visor-glint-2{0%{background-position:100% 0;opacity:0}25%{opacity:.65}70%{opacity:.45}100%{background-position:0% 0;opacity:0}}\n.hero-showcase:has(#hero-example-3:not([hidden])) .visor-glint{animation:visor-glint-3 620ms ease-out 100ms both}\n@keyframes visor-glint-3{0%{background-position:100% 0;opacity:0}25%{opacity:.65}70%{opacity:.45}100%{background-position:0% 0;opacity:0}}\n@media(max-width:600px){.section-heading .issue-number{font-size:9px;padding:5px 8px}.section-heading{gap:10px}.homepage .paper-section .section-heading h2:before,.case-panel:not(.case-cover) .case-scene h2:before{height:9px}.case-controls .navigation-arrow{width:16px;height:14px;flex-basis:16px}.case-controls button{gap:4px}.ticker-controls button{gap:4px;padding-left:5px;padding-right:5px}.ticker-controls .navigation-arrow{width:12px;flex-basis:12px}.homepage .lock-section .section-heading h2:after{right:-15px;width:19px}}\n@media(prefers-reduced-motion:reduce){.ticker-example:not([hidden]),.case-panel:not([hidden]),.hero-showcase .visor-glint{animation:none!important}.visor-glint{display:none}.case-controls button:hover .arrow-next{transform:none}.case-controls button:hover .arrow-previous{transform:scaleX(-1)}}\n\n.workload-buttons bu