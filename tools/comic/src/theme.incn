map-field{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;padding:9px 12px;border:1px solid #11182055;margin:0;align-items:center}.map-field dt{color:var(--teal)}.map-field dd{color:#a63d00;font-weight:600;white-space:nowrap}.buyer-record{border:2px solid var(--ink);background:var(--cream);padding:0 12px 12px}.buyer-header{margin:0 -12px 12px;background:#bfe6e0}.buyer-record .map-field+.map-field{margin-top:8px}\n.representations-diagram{margin:32px 0;color:var(--ink);position:relative}.representations-flow{display:grid;grid-template-columns:minmax(0,1fr) 80px minmax(0,1fr) 80px minmax(0,1fr);gap:10px;align-items:center}.representation-card{min-width:0;min-height:225px;border:2px solid var(--ink);background:var(--cream);padding:20px 17px;box-shadow:4px 4px 0 #000;text-align:left}.representation-card h3{display:inline-block;font:400 33px/1.1 Bangers,sans-serif;padding:2px 9px;margin-bottom:8px;background:var(--amber);transform:skew(-7deg)}.representation-subtitle{font-size:14px;margin-bottom:18px}.representation-card pre{font:400 12px/1.65 'Martian Mono',monospace;font-variation-settings:'wdth' 95;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}.representation-card .representation-note{font-size:11px;line-height:1.4;color:#46646a;margin-top:16px}.typed-representation{border-color:var(--cyan);background:#e2f0e9}.typed-representation h3{background:var(--cyan)}.represented-type{display:block;font:600 11px/1.5 'Martian Mono',monospace;overflow-wrap:anywhere;color:var(--teal);margin:8px 0 12px}.represented-fields{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font:400 14px/1.5 'Martian Mono',monospace}.represented-fields dt{color:var(--teal)}.represented-fields dd{color:#a63d00;text-align:right}.binary-meaning{font:600 17px/1.4 Barlow,sans-serif}.representation-flow{position:relative;min-width:0;height:112px;text-align:center;font:italic 700 13px/1.1 Barlow,sans-serif}.representation-flow img{display:block;width:100%;height:70px;object-fit:fil