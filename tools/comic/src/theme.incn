er) 58% 91%,transparent 91%);padding:0 3px;margin:0 -3px;box-decoration-break:clone;-webkit-box-decoration-break:clone}\n.namespace-map{position:relative;border:1.5px dashed var(--teal);padding:38px 20px 16px;max-width:660px;margin-top:27px}.namespace-label{position:absolute;left:16px;top:-16px;display:flex;align-items:center;gap:12px;background:var(--cream);padding:5px 12px;border:1.5px solid var(--teal);color:var(--teal)}.namespace-label>span{font:500 10px/1.3 Barlow,sans-serif;text-transform:uppercase;letter-spacing:.08em}.namespace-label strong{font:500 17px/1.3 'Martian Mono',monospace}.record-bubble{position:relative;background:url('/assets/record-bubble.svg') center/100% 100% no-repeat;min-width:0;padding:18px 22px 42px}.record-bubble-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 18px}.record-bubble-title strong{font:400 40px/1 Bangers,sans-serif;color:var(--ink)}.bubble-type{font:400 10px/1.4 'Martian Mono',monospace;color:var(--teal)}.record-bubble-fields{display:grid;grid-template-columns:minmax(74px,1fr) minmax(0,3fr);gap:22px;align-items:start}.bubble-field{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid #11182066;background:#ffe0a0;margin:0}.bubble-field dt{color:var(--teal)}.bubble-field dd{color:#a63d00;white-space:nowrap}.nested-field-label{display:inline-block;font:500 12px/1.4 'Martian Mono',monospace;color:var(--teal);margin:0 0 8px}.buyer-bubble{background-image:url('/assets/buyer-bubble.svg');padding:15px 18px 35px}.buyer-bubble .record-bubble-title{margin-bottom:14px;gap:8px}.buyer-bubble .record-bubble-title strong{font-size:31px}.buyer-bubble .bubble-type{font-size:9px}.buyer-bubble .bubble-field{background:#edf8f4}.buyer-bubble .bubble-field+.bubble-field{margin-top:8px}\n.homepage .lock-section>.code-panel{border:3px solid #000;border-radius:0;box-shadow:7px 7px 0 var(--amber);overflow:visible;position:relative;margin-top:34px;margin-bottom:32px;padding-top:16px}.homepage .lock-section>.code-panel>.code-label{display:inline-block;position:relative;margin:-35px 18px 0;padding:7px 13px;border:2px solid #000;background:var(--amber);font:italic 700 14px/1.3 Barlow,sans-serif;transform:skew(-5deg);max-width:calc(100% - 36px);box-shadow:2px 2px 0 #000}.homepage .lock-section>.code-panel pre{padding:22px 26px 24px}.homepage .lock-section>.code-panel:after{content:'';position:absolute;right:0;top:0;border-top:25px solid var(--amber);border-left:30px solid transparent;pointer-events:none}.homepage .dependency-node{border:2px solid #000;border-radius:0;box-shadow:4px 4px 0 var(--amber)}\n.footer-brand-line{display:flex;align-items:center;gap:18px}.footer-logo{display:block;line-height:0}.footer-logo img{display:block;width:125px;height:auto}.footer-brand-line .maker-signature{border-left:1px solid var(--cream);padding-left:18px;margin:0}.footer-brand>.muted{margin-top:6px}.footer-foundation{width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}.built-with-incan{display:block;line-height:0}.built-with-incan img{display:block;width:170px;height:auto}.footer-foundation .fine-print{color:var(--muted);font-size:12px}\n@media(max-width:900px){.namespace-map{padding:30px 14px 12px}.record-bubble{padding:15px 18px 35px}.record-bubble-fields{gap:12px;grid-template-columns:minmax(60px,1fr) minmax(0,3fr)}.record-bubble-title{flex-wrap:wrap;gap:6px}.buyer-bubble .record-bubble-title{flex-wrap:wrap}.bubble-field{padding:8px 9px;gap:7px}.buyer-bubble{padding:14px 14px 32px}.bubble-type{font-size:9px}}\n@media(max-width:600px){.namespace-map{padding:29px 10px 10px}.namespace-label{font-size:12px;left:10px}.namespace-label strong{font-size:15px}.record-bubble-fields{grid-template-columns:1fr;gap:13px}.record-bubble-title strong{font-size:35px}.item-field{max-width:100px}.nested-buyer-field{margin-left:18px}.buyer-bubble .record-bubble-title{flex-wrap:nowrap}.bubble-field{font-size:12px}.homepage .lock-section>.code-panel{box-shadow:4px 4px 0 var(--amber);margin-top:28px}.homepage .lock-section>.code-panel>.code-label{font-size:11px;margin-left:10px;padding:6px 9px;max-width:calc(100% - 24px)}.homepage .lock-section>.code-panel pre{padding:18px 13px 20px;font-size:12px}.footer-brand-line{gap:14px}.footer-brand-line .maker-signature{padding-left:14px}.footer-foundation{align-items:flex-start;flex-direction:column;gap:14px}.built-with-incan img{width:150px}.footer-foundation .fine-print{font-size:11px}}\n\n/* Field assignments read as printed labels rather than form inputs. */\n.record-bubble{background:none;isolation:isolate}.record-bubble:before{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background:url('/assets/record-bubble.svg') center/100% 100% no-repeat;filter:drop-shadow(4px 4px 0 #11182026)}.buyer-bubble:before{background-image:url('/assets/buyer-bubble.svg')}.record-bubble-title strong{font-size:26px}.buyer-bubble .record-bubble-title strong{font-size:22px}.record-bubble-title{margin-bottom:17px}.buyer-bubble .record-bubble-title{margin-bottom:17px}.record-bubble-fields{grid-template-columns:max-content minmax(0,1fr);gap:24px}\n.bubble-field,.buyer-bubble .bubble-field{display:inline-flex;width:fit-content;max-width:100%;align-items:baseline;justify-content:flex-start;gap:8px;border:1.5px solid #111820;background:var(--amber);padding:6px 10px;transform:skew(-6deg);box-shadow:2px 2px 0 #11182030;font:500 13px/1.4 'Martian Mono',monospace;margin:0 12px 12px 0}.bubble-field dt{color:var(--ink)}.bubble-field dd{color:var(--ink);font-weight:600}.buyer-bubble .bubble-field{background:#bfe6e0}.buyer-bubble .bubble-field+.bubble-field{margin-top:0}.item-field{max-width:none}.nested-field-label{margin-bottom:9px}\n@media(max-width:600px){.record-bubble-title strong{font-size:26px}.buyer-bubble .record-bubble-title strong{font-size:22px}.record-bubble-fields{grid-template-columns:1fr;gap:8px}.bubble-field,.buyer-bubble .bubble-field{font-size:12px;padding:5px 9px;gap:7px;margin-right:10px}.record-bubble:before{filter:drop-shadow(3px 3px 0 #11182026)}}\n\n/* Code uses the same printed-panel treatment, without speech tails. */\n.code-panel,.nested-layout .code-panel,.hero-bubble .code-panel,.homepage .lock-section>.code-panel{position:relative;border:2px solid #111820;border-radius:0;background:var(--cream);box-shadow:4px 4px 0 #11182026;padding:0;overflow:visible}.code-panel:before,.code-panel:after,.hero-bubble .code-panel:after,.homepage .lock-section>.code-panel:after{content:none}\n.code-label,.nested-layout .code-label,.hero-bubble .code-label,.homepage .lock-section>.code-panel>.code-label{display:inline-block;position:relative;color:var(--ink);background:var(--amber);border:1.5px solid #111820;padding:5px 9px;margin:12px 14px 0;max-width:calc(100% - 28px);font:500 11px/1.4 'Martian Mono',monospace;transform:skew(-6deg);box-shadow:2px 2px 0 #11182030;white-space:normal;overflow-wrap:anywhere}\n.code-panel pre,.homepage .lock-section>.code-panel pre{padding:14px 18px 18px}.nested-layout .code-panel{margin:0 0 24px}.homepage .lock-section>.code-panel{margin:26px 0 30px}\n.hero-bubble .code-panel{margin:0 0 12px}.hero-bubble .code-label{font:500 12px/1.2 Barlow,sans-serif;padding:4px 9px;margin:9px 12px 6px;max-width:calc(100% - 24px)}.hero-bubble .code-panel pre{padding:0 12px 10px}.ticker-heading{margin-bottom:10px}\n@media(max-width:750px){.ticker-heading{margin-bottom:12px}.hero-bubble .code-label{font-size:11px}.hero-bubble .code-panel pre{padding:0 10px 8px}}\n@media(max-width:600px){.code-panel,.nested-layout .code-panel,.hero-bubble .code-panel,.homepage .lock-section>.code-panel{box-shadow:3px 3px 0 #11182026}.code-label,.nested-layout .code-label,.homepage .lock-section>.code-panel>.code-label{font-size:9px;padding:4px 7px;margin:10px 10px 0;max-width:calc(100% - 20px)}.code-panel pre,.homepage .lock-section>.code-panel pre{padding:12px 12px 15px}.hero-bubble .code-panel{margin-bottom:10px;border-width:1.5px}.hero-bubble .code-label{font:500 10px/1.2 Barlow,sans-serif;border-width:1px;padding:3px 6px;margin:6px 8px 4px;max-width:calc(100% - 16px)}.hero-bubble .code-panel pre{padding:0 8px 6px}}\n\n.hero-bubble .code-label{font-family:'Martian Mono',monospace;font-size:11px;line-height:1.4}@media(min-width:481px) and (max-width:750px){.hero-bubble .code-panel pre{font-size:14.5px}}@media(max-width:600px){.hero-bubble .code-label{font-size:9px;line-height:1.4}}\n\n/* Isolated highlighting study: no palette changes to the rest of the site. */\n.syntax-lab .article-heading{padding-bottom:28px}.highlight-lab{padding-bottom:50px}.lab-controls{display:flex;align-items:flex-end;flex-wrap:wrap;gap:20px;margin:0 0 28px}.lab-control-label{display:block;font:500 11px/1.4 'Martian Mono',monospace;color:var(--cyan);margin-bottom:9px}.lab-button-group{display:flex;gap:8px;flex-wrap:wrap}.lab-button-group button{border:1.5px solid var(--cream);background:transparent;color:var(--cream);padding:9px 13px;min-height:42px;font:600 13px Barlow,sans-serif;cursor:pointer}.lab-button-group button[aria-pressed=true]{background:var(--amber);border-color:#000;color:var(--ink);box-shadow:3px 3px 0 #000;transform:skew(-5deg)}.lab-button-group button:focus-visible{outline:3px solid var(--cyan);outline-offset:4px}.lab-layout{display:grid;grid-template-columns:minmax(0,1fr) 225px;gap:28px;align-items:start}.lab-code-panel{margin:0;min-width:0}.lab-code-panel pre{font:400 13px/1.65 'Martian Mono',monospace;font-variation-settings:'wdth' 95;max-height:760px;overflow:auto;tab-size:4}.lab-code-panel code{white-space:pre}.lab-legend{padding:20px;border:1px solid #fff4df55;background:#fff4df09}.lab-legend h2{font:400 29px/1.1 Bangers,sans-serif;margin-bottom:20px}.token-legend{list-style:none;padding:0;margin:0 0 24px}.token-legend li{display:flex;align-items:center;gap:10px;margin-bottom:11px;font:600 13px/1.4 Barlow,sans-serif}.token-swatch{width:12px;height:12px;background:currentColor;display:inline-block;flex:0 0 12px}.lab-note{font:400 14px/1.5 Barlow,sans-serif;margin:18px 0}.lab-legend>a{display:block;font-size:14px;margin-top:18px}.syntax-lab-link{margin:4px 0 22px;font-size:15px}.highlight-lab{--hl-declaration:#005f73;--hl-kind:#653c88;--hl-type:#4c4c74;--hl-path:#076789;--hl-variant:#775116;--hl-field:#26363d;--hl-metadata:#68541f;--hl-string:#9a4214;--hl-number:#984311;--hl-literal:#70508b;--hl-comment:#626b69;--hl-operator:#38494e;--hl-punctuation:#53625f;--hl-name:#26363d}.highlight-lab[data-palette=classic]{--hl-declaration:#006976;--hl-kind:#006976;--hl-type:#006976;--hl-path:#006976;--hl-variant:#006976;--hl-field:#006976;--hl-metadata:#006976;--hl-string:#a63d00;--hl-number:#a63d00;--hl-literal:#a63d00;--hl-operator:#26363d}.highlight-lab[data-palette=punchy]{--hl-declaration:#004fc4;--hl-kind:#990078;--hl-type:#007064;--hl-path:#004fc4;--hl-variant:#994600;--hl-field:#25313d;--hl-metadata:#885100;--hl-string:#b82b14;--hl-number:#9d5000;--hl-literal:#990078;--hl-comment:#626b69;--hl-operator:#b82b14;--hl-punctuation:#53625f;--hl-name:#25313d;}.highlight-lab[data-mode=night]{--hl-declaration:#65dbe5;--hl-kind:#d8a6ef;--hl-type:#b7b9f0;--hl-path:#89c9ff;--hl-variant:#ffd17f;--hl-field:#eee5d6;--hl-metadata:#e9ca7d;--hl-string:#b7ddad;--hl-number:#ffc184;--hl-literal:#d8a6ef;--hl-comment:#9aa9b1;--hl-operator:#d9dfdf;--hl-punctuation:#a7b7bc;--hl-name:#eee5d6}.highlight-lab[data-mode=night][data-palette=classic]{--hl-kind:#65dbe5;--hl-type:#65dbe5;--hl-path:#65dbe5;--hl-variant:#65dbe5;--hl-field:#65dbe5;--hl-metadata:#65dbe5;--hl-string:#ffc184;--hl-literal:#ffc184}.highlight-lab[data-mode=night][data-palette=punchy]{--hl-declaration:#87c3ff;--hl-kind:#ef9cdb;--hl-type:#78e0c3;--hl-path:#87c3ff;--hl-variant:#ffd079;--hl-metadata:#ffd079;--hl-string:#ffa79a;--hl-number:#ffd079;--hl-literal:#ef9cdb;--hl-operator:#ffa79a}.highlight-lab .tok-declaration{color:var(--hl-declaration);font-weight:600}.highlight-lab .tok-kind{color:var(--hl-kind);font-weight:600}.highlight-lab .tok-type{color:var(--hl-type)}.highlight-lab .tok-path{color:var(--hl-path)}.highlight-lab .tok-variant{color:var(--hl-variant)}.highlight-lab .tok-field{color:var(--hl-field)}.highlight-lab .tok-metadata{color:var(--hl-metadata)}.highlight-lab .tok-string{color:var(--hl-string)}.highlight-lab .tok-number{color:var(--hl-number)}.highlight-lab .tok-literal{color:var(--hl-literal)}.highlight-lab .tok-comment{color:var(--hl-comment);font-style:italic}.highlight-lab .tok-operator{color:var(--hl-operator);font-weight:600}.highlight-lab .tok-punctuation{color:var(--hl-punctuation)}.highlight-lab .tok-name{color:var(--hl-name)}.highlight-lab[data-mode=paper] .lab-legend{background:var(--cream);color:var(--ink);border:2px solid #000;box-shadow:4px 4px 0 #11182026}.highlight-lab[data-mode=night] .lab-code-panel{background:#142029;color:#eee5d6;box-shadow:4px 4px 0 #69778055}.highlight-lab[data-mode=night] .lab-legend{background:#142029;color:#eee5d6}.highlight-lab[data-mode=paper] .lab-legend a{color:var(--teal)}.highlight-lab[data-wrap=wrap] .lab-code-panel code{white-space:pre-wrap;overflow-wrap:anywhere}.highlight-lab[data-wrap=wrap] .lab-code-panel pre{white-space:pre-wrap}\n@media(max-width:900px){.lab-layout{grid-template-columns:minmax(0,1fr)}.lab-legend{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.lab-legend h2{grid-column:1/-1}.token-legend{grid-row:span 4}.lab-note{margin-top:0}.lab-code-panel pre{max-height:660px}}\n@media(max-width:600px){.lab-controls{gap:16px}.lab-button-group button{font-size:12px;padding:8px 10px}.lab-code-panel pre{font-size:11px;max-height:570px;padding:12px}.lab-legend{display:block}.token-legend{display:grid;grid-template-columns:1fr 1fr;gap:0 10px}.syntax-lab .article-heading h1{font-size:46px}.syntax-lab .article-lead{font-size:18px}.highlight-lab{padding-bottom:35px}}\n\n/* Approved Punchy treatment for regular code panels. Night study colors are unchanged. */\n:root{--hl-declaration:#004fc4;--hl-kind:#990078;--hl-type:#007064;--hl-path:#004fc4;--hl-variant:#994600;--hl-field:#25313d;--hl-metadata:#885100;--hl-string:#b82b14;--hl-number:#9d5000;--hl-literal:#990078;--hl-comment:#626b69;--hl-operator:#b82b14;--hl-punctuation:#53625f;--hl-name:#25313d;}\n.code-panel .tok-declaration{color:var(--hl-declaration);font-weight:600;}\n.code-panel .tok-kind{color:var(--hl-kind);font-weight:600;}\n.code-panel .tok-type{color:var(--hl-type);}\n.code-panel .tok-path{color:var(--hl-path);}\n.code-panel .tok-variant{color:var(--hl-variant);}\n.code-panel .tok-field{color:var(--hl-field);}\n.code-panel .tok-metadata{color:var(--hl-metadata);}\n.code-panel .tok-string{color:var(--hl-string);}\n.code-panel .tok-number{color:var(--hl-number);}\n.code-panel .tok-literal{color:var(--hl-literal);}\n.code-panel .tok-comment{color:var(--hl-comment);font-style:italic;}\n.code-panel .tok-operator{color:var(--hl-operator);font-weight:600;}\n.code-panel .tok-punctuation{color:var(--hl-punctuation);}\n.code-panel .tok-name{color:var(--hl-name);}\n\n/* Keep the complete invoice value clear of the narrator without growing the stage. */\n.hero-bubble{padding-top:30px}.hero-bubble .code-panel{margin-bottom:9px}.hero-bubble .code-label{margin-top:6px}.ticker-example .example-explanation{margin-top:10px}@media(max-width:480px){.hero-bubble{padding-top:28px}}\n\n@media(min-width:751px){.hero-bubble{min-height:590px}}\n\n/* The closing invitation anchors Incus and the print texture as one composition. */\n.incus-guide h2 .inline-comic-logo{display:inline-block;height:1.05em;width:auto;vertical-align:-.12em;margin:0 .05em}\n.homepage .lock-section:before,.homepage .closing:before{content:none}.homepage .lock-section>.code-panel:before{content:'';position:absolute;right:12px;top:12px;width:180px;height:135px;background:url('/assets/comic-halftone.svg') center/contain no-repeat;opacity:.15;pointer-events:none}.homepage .lock-section>.code-panel pre{position:relative;z-index:1}.homepage .lock-section>.code-panel>.code-label{z-index:1}\n.community-banner{padding-top:20px;padding-bottom:46px}.community-panel{display:grid;grid-template-columns:300px minmax(0,1fr);gap:38px;align-items:center;background:var(--cream);color:var(--ink);border:3px solid #000;box-shadow:6px 6px 0 var(--amber);isolation:isolate;position:relative}.community-incus{position:relative;align-self:end;height:320px;overflow:hidden;isolation:isolate}.community-incus:before{content:'';position:absolute;left:-20px;top:35px;width:340px;height:255px;background:url('/assets/comic-halftone.svg') center/contain no-repeat;opacity:.38;z-index:-1;pointer-events:none}.community-incus img{position:absolute;bottom:0;left:7px;width:290px;height:auto;display:block}.community-copy{padding:28px 32px 28px 0;min-width:0}.community-kicker{display:inline-block;border:1.5px solid #111820;background:var(--amber);color:var(--ink);padding:5px 10px;font:500 10px/1.3 'Martian Mono',monospace;transform:skew(-6deg);box-shadow:2px 2px 0 #11182030;margin-bottom:16px}.community-copy h2{font:400 52px/1.05 Bangers,sans-serif;margin-bottom:14px}.community-copy>p{font-size:18px;line-height:1.5;max-width:43ch;margin-bottom:20px}.community-actions{display:flex;align-items:center;flex-wrap:wrap;gap:18px;margin-bottom:18px}.community-actions .button{display:inline-flex;align-items:center;gap:14px;border:2px solid #000;box-shadow:3px 3px 0 #11182030;font-size:16px;transform:skew(-5deg)}.community-destination{font:400 13px/1.4 Barlow,sans-serif;color:#46646a}.community-copy>.text-link{color:var(--teal);font-size:15px}\n/* Match the approved site's cropped monochrome stamp, preserving the source file. */\n.built-with-incan{position:relative;width:128px;height:36px;overflow:hidden;flex:0 0 128px}.built-with-incan img{display:block;position:absolute;max-width:none;width:143%;height:auto;left:-21.5%;top:-29%;mix-blend-mode:lighten}\n@media(max-width:900px){.community-panel{grid-template-columns:230px minmax(0,1fr);gap:24px}.community-incus{height:285px}.community-incus img{width:240px;left:-3px}.community-incus:before{width:280px;height:210px;left:-25px;top:50px}.community-copy{padding:26px 24px 26px 0}.community-copy h2{font-size:43px}.community-copy>p{font-size:16px}.community-actions{gap:12px}.community-actions .button{font-size:14px;padding:10px 15px}.community-destination{font-size:12px}}\n@media(max-width:600px){.community-banner{padding-top:12px;padding-bottom:32px}.community-panel{grid-template-columns:minmax(0,1fr);gap:0;box-shadow:4px 4px 0 var(--amber)}.community-copy{order:0;padding:24px 21px 14px}.community-copy h2{font-size:39px}.community-copy>p{font-size:17px}.community-incus{order:1;height:200px;width:100%}.community-incus img{width:180px;left:calc(50% - 90px)}.community-incus:before{width:270px;height:202px;left:calc(50% - 135px);top:0}.community-actions .button{font-size:14px}.community-copy>.text-link{font-size:14px}.community-kicker{font-size:9px;margin-bottom:12px}.built-with-incan{width:120px;height:34px;flex-basis:120px}.built-with-incan img{width:143%}.homepage .lock-section>.code-panel:before{width:140px;height:105px;right:8px;top:8px;opacity:.1}}\n\n/* Fixed stamp dimensions must not become a vertical flex basis on phone. */\n.built-with-incan{flex:0 0 auto}\n\n/* Community illustration: a separate notebook scene, with the complete gesture visible. */\n.community-panel{grid-template-columns:400px minmax(0,1fr);gap:30px}\n.community-incus{height:300px;overflow:hidden}\n.community-incus img{width:100%;left:0;bottom:0}\n.community-incus:before{left:24px;top:18px;width:300px;height:225px;opacity:.24}\n@media(max-width:900px){.community-panel{grid-template-columns:290px minmax(0,1fr);gap:24px}.community-incus{height:285px}.community-incus img{width:100%;left:0}.community-incus:before{left:8px;top:64px;width:250px;height:188px}}\n@media(max-width:600px){.community-panel{grid-template-columns:minmax(0,1fr);gap:0}.community-incus{height:auto;aspect-ratio:1.5;width:100%}.community-incus img{width:100%;left:0}.community-incus:before{left:calc(50% - 125px);top:12px;width:250px;height:188px}}\n"
