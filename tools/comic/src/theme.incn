"""Approved .COMIC appearance. CSS is a generated browser-target artifact."""


pub def stylesheet() -> str:
    return "@import url('/assets/encero/wordmark.css');\n@font-face{font-family:Bangers;src:url('/assets/fonts/Bangers-Regular.ttf') format('truetype');font-weight:400;font-display:swap}\n@font-face{font-family:Barlow;src:url('/assets/fonts/Barlow-Regular.ttf') format('truetype');font-weight:400;font-display:swap}\n@font-face{font-family:Barlow;src:url('/assets/fonts/Barlow-SemiBold.ttf') format('truetype');font-weight:600;font-display:swap}\n@font-face{font-family:Barlow;src:url('/assets/fonts/Barlow-Bold.ttf') format('truetype');font-weight:700;font-display:swap}\n@font-face{font-family:'Martian Mono';src:url('/assets/fonts/MartianMono.ttf') format('truetype');font-weight:100 800;font-stretch:75% 112.5%;font-display:swap}\n:root{--ink:#111820;--cream:#fff4df;--amber:#ffc15a;--cyan:#48f0ef;--teal:#00777e;--muted:#c4c9ca;--paper-rule:#d6cbb9;color-scheme:dark}\n*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--ink);color:var(--cream);font:18px/1.55 Barlow,Arial,sans-serif}body,figure,p,h1,h2,h3,dl,dd{margin:0}a{color:inherit;text-underline-offset:5px}button,select,input{font:inherit}a,button,summary,select{touch-action:manipulation}a:focus-visible,button:focus-visible,summary:focus-visible,select:focus-visible,pre:focus-visible,.table-scroll:focus-visible{outline:3px solid var(--teal);outline-offset:5px}h1,h2{font-family:Bangers,Impact,sans-serif;font-weight:400;line-height:1.02;letter-spacing:.015em}h3{font-size:24px;line-height:1.2}em{font-style:normal;color:var(--amber)}[hidden]{display:none!important}.wrap{width:calc(100% - 80px);max-width:1080px;margin-inline:auto}.mono,code,.bar-value,.issue-number{font-family:'Martian Mono',monospace;font-variation-settings:'wght' 400,'wdth' 95;font-stretch:95%;font-variant-ligatures:none;letter-spacing:normal}.muted{color:var(--muted)}.fine-print{font-size:14px;line-height:1.5}.cyan{color:var(--cyan)}\n.site-header{display:flex;align-items:center;gap:20px;min-height:115px;border-bottom:2px solid #fff4df80;position:relative}.brand{flex-shrink:0;display:block}.brand img{display:block;width:126px;height:63px;object-fit:contain;filter:grayscale(1);background:#fff}.brand-description{padding-left:18px;border-left:2px solid var(--cream);font-size:12px;line-height:1.2;white-space:pre-line}.maker-signature{display:flex;align-items:center;gap:7px;font-size:13px;line-height:1.3;margin-top:6px;white-space:nowrap}.maker-by{font-family:Barlow,sans-serif;font-weight:400;font-style:italic}.desktop-nav{display:flex;gap:25px;margin-left:auto;font-size:15px;font-weight:600}.desktop-nav a{text-decoration:none;padding:12px 0}.desktop-nav a:hover,.desktop-nav a[aria-current=page]{color:var(--amber)}.mobile-menu{display:none}.skip-link{position:absolute;top:-100px;left:0;background:var(--cream);color:var(--ink);padding:12px;z-index:20}.skip-link:focus{top:0}.text-link{font-weight:600;text-decoration:underline;text-decoration-thickness:2px}.text-link:hover{color:var(--teal)}.cyan:hover{color:var(--amber)}\n.hero{padding-top:58px;padding-bottom:38px;text-align:center}.eyebrow{font-family:'Martian Mono',monospace;font-variation-settings:'wght' 400,'wdth' 95;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--amber);margin-bottom:20px}.hero h1{font-size:clamp(62px,7.4vw,104px);max-width:1000px;margin:auto;line-height:.99}.hero-description{max-width:720px;margin:25px auto 0;font-size:23px;line-height:1.35}.hero-actions{display:flex;align-items:center;justify-content:center;gap:36px;margin:27px 0 42px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:10px 24px;font-weight:700;font-size:21px;text-decoration:none;border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink)}.button-primary{background:var(--amber);color:var(--ink)}.button-primary:hover{background:var(--cream)}.hero-caption{font-size:17px;margin-top:28px}.code-panel{color:var(--ink);background:var(--cream);border:2px solid var(--ink);border-radius:7px;margin:24px 0;min-width:0;max-width:100%;overflow:hidden}.code-label{font-size:12px;font-weight:600;line-height:1.4;padding:8px 18px 0;color:#555d60}.code-panel pre{margin:0;overflow:auto;padding:15px 20px 20px;max-width:100%;font-size:15px;line-height:1.7;tab-size:4}.code-panel code{font-size:inherit;white-space:pre}.syntax-name{color:var(--teal)}.syntax-string,.syntax-number{color:#a23b0c}.section-heading{display:flex;align-items:baseline;gap:18px;margin-bottom:24px}.section-heading h2{font-size:clamp(35px,4.5vw,54px)}.issue-number{font-size:12px;line-height:1;border:1px solid currentColor;padding:7px;opacity:.7}.section-lead{font-size:21px;max-width:780px;margin-bottom:25px}.paper-section{background:var(--cream);color:var(--ink);padding-block:48px;color-scheme:light}.paper-section .text-link{color:var(--teal)}.nested-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:36px}.section-intro{padding-top:10px;display:flex;flex-direction:column;gap:24px;font-size:20px}.nested-layout .code-panel{border:0;border-left:2px solid var(--ink);border-radius:0;margin:0 0 20px;background:none}.nested-layout .code-label{padding-top:0}.value-diagram{font-family:'Martian Mono',monospace;font-variation-settings:'wght' 400,'wdth' 95;font-size:14px}.diagram-caption{font-family:Barlow,sans-serif;font-size:13px;font-weight:600;margin-bottom:8px}.record{display:flex;flex-wrap:wrap;gap:12px;border:2px solid #32646b;background:#e6f2e9;border-radius:9px;padding:16px}.record-type{width:100%;color:var(--teal)}.field{display:flex;align-items:center;gap:10px;background:var(--cream);padding:8px 11px;border:1px solid #567178;border-radius:6px}.field dt{color:var(--teal)}.field dd{color:#a23b0c}.nested-record{flex:1;background:#ccece6;min-width:0;padding:12px}.lock-section{padding-block:48px}.lock-section .code-panel{margin-top:25px;margin-bottom:24px}.lock-section .code-label{background:var(--amber);color:var(--ink);display:inline-block;padding:4px 10px;font-weight:700}.dependency-diagram{display:flex;align-items:center;justify-content:center;gap:30px;margin:25px 0}.dependency-node{border:2px solid var(--cyan);border-radius:8px;padding:12px 22px;display:flex;flex-direction:column;align-items:center;background:var(--cream);color:var(--teal);line-height:1.3}.dependency-label{font-size:14px;text-decoration:underline;text-underline-offset:6px}.lock-section>.fine-print{max-width:730px;margin:0 0 15px}\n.chart-controls{display:flex;align-items:center;gap:20px;justify-content:space-between;margin:30px 0 25px}.chart-controls label{font-size:15px;font-weight:600}.chart-controls select{max-width:60%;background:var(--cream);border:2px solid var(--ink);border-radius:0;color:var(--ink);padding:8px 34px 8px 12px;font-size:16px}.dataset-chart h3{margin-bottom:4px}.chart-unit{font-size:14px;color:#4c565b}.bars{margin:25px 0 20px;display:flex;flex-direction:column;gap:14px}.bar-row{display:grid;grid-template-columns:165px minmax(0,1fr) 84px;gap:15px;align-items:center}.bar-label{font-size:16px;font-weight:600;text-align:right;line-height:1.25}.bar-track{min-width:0;border-left:1px solid #11182070;padding-left:0}.bar-track meter{display:block;width:100%;height:26px;border:0;background:none;border-radius:0;appearance:none;-webkit-appearance:none}.bar-track meter::-webkit-meter-bar{background:#1118200a;border:0;border-radius:0;box-shadow:none}.bar-track meter::-webkit-meter-optimum-value{background:var(--amber);border-radius:0}.toon-bar meter::-webkit-meter-optimum-value{background:var(--teal)}.json-bar meter::-webkit-meter-optimum-value{background:#919699}.formatted-bar meter::-webkit-meter-optimum-value{background:#bc7b2c}.csv-bar meter::-webkit-meter-optimum-value{background:#596b54}.bar-track meter::-moz-meter-bar{background:var(--amber)}.toon-bar meter::-moz-meter-bar{background:var(--teal)}.json-bar meter::-moz-meter-bar{background:#919699}.formatted-bar meter::-moz-meter-bar{background:#bc7b2c}.csv-bar meter::-moz-meter-bar{background:#596b54}.bar-value{font-size:14px}.chart-result{font-size:15px;font-weight:600;margin-bottom:18px}.method-note{font-size:15px;line-height:1.5;border-left:3px solid var(--teal);padding-left:15px;margin:20px 0 14px;max-width:850px}.closing{text-align:center;padding-block:42px}.closing h2{display:inline-block;font-size:42px;color:var(--ink);background:var(--amber);padding:9px 22px;margin-bottom:15px}.closing>.muted{font-size:15px;margin:20px auto}.forms-diagram{display:flex;align-items:center;justify-content:center;gap:0;margin:26px auto;max-width:650px;font-weight:600}.form-node{border:1px solid var(--cyan);padding:9px 20px;min-width:110px}.model-node{padding:10px 25px;border-top:1px solid var(--cyan);border-bottom:1px solid var(--cyan);font-size:14px}.site-footer{border-top:2px solid var(--cyan);padding:24px 0 35px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:20px}.site-footer nav{display:flex;gap:25px;font-size:15px;color:var(--cyan)}.site-footer strong{font-family:Bangers,sans-serif;letter-spacing:.05em;font-size:26px}.site-footer .muted{font-size:14px}.site-footer>.fine-print{width:100%;color:var(--muted);font-size:12px}\n.article-heading{padding-block:45px 55px}.breadcrumb{font-size:15px;color:var(--cyan);font-weight:600}.article-heading .eyebrow{margin-top:35px;margin-bottom:15px}.article-heading h1{font-size:clamp(50px,6vw,78px);max-width:900px}.article-lead{font-size:24px;margin-top:22px;max-width:760px}.reading{max-width:900px}.reading>section{margin:45px 0;scroll-margin-top:25px}.reading p{margin-bottom:22px}.reading .section-heading{margin-top:40px;margin-bottom:20px}.reading .section-heading h2{font-size:42px}.reading .code-panel{margin-block:22px 30px}.reading .dependency-node{border-color:var(--teal)}.reading>.value-diagram,.reading section>.value-diagram{margin:28px 0}.contents{display:flex;flex-wrap:wrap;gap:8px 24px;font-size:15px;border-bottom:1px solid var(--paper-rule);padding-bottom:25px;margin-bottom:30px;color:var(--teal)}.contents strong{width:100%;color:var(--ink)}.callout{border:2px solid var(--ink);background:#ffe4aa;padding:18px 22px;font-size:17px;box-shadow:4px 4px 0 var(--ink)}.table-scroll{overflow:auto;max-width:100%;margin:25px 0}table{border-collapse:collapse;font-size:15px;width:100%;font-variant-numeric:tabular-nums}caption{text-align:left;font-size:13px;padding-bottom:12px;color:#4c565b}th,td{padding:12px 15px;border-bottom:1px solid var(--paper-rule);text-align:right;white-space:nowrap}th:first-child{text-align:left;white-space:normal;min-width:160px}thead th{border-bottom:2px solid var(--ink);font-weight:700}tbody td:first-of-type{background:#ffc15a26;font-weight:600}.methodology{display:grid;grid-template-columns:155px minmax(0,1fr);gap:18px 30px}.methodology dt{font-weight:700;font-size:16px}.methodology dd{font-size:17px}.download-links{display:flex;flex-wrap:wrap;gap:18px 30px;margin:30px 0}.article-paper .button{font-size:18px;margin:10px 0 30px}\n@media(max-width:900px){.wrap{width:calc(100% - 48px)}.site-header{gap:15px;min-height:91px}.brand img{width:112px;height:56px}.brand-description{font-size:10px;padding-left:12px}.desktop-nav{gap:18px;font-size:13px}.hero{padding-top:35px}.hero h1{font-size:76px}.hero-description{font-size:21px}.hero-actions{margin-bottom:35px;gap:28px}.hero-caption{font-size:16px}.nested-layout{grid-template-columns:180px minmax(0,1fr);gap:20px}.section-intro{font-size:18px}.code-panel pre{font-size:12px;padding-inline:16px}.record{padding:12px;gap:8px}.field{font-size:12px;padding:7px}.value-diagram{font-size:12px}.section-heading h2{font-size:42px}.section-heading{gap:13px}.paper-section,.lock-section{padding-block:35px}.site-footer nav{gap:16px;font-size:14px}}\n@media(max-width:600px){.wrap{width:calc(100% - 32px)}body{font-size:17px}.site-header{min-height:86px;gap:12px}.brand img{width:99px;height:50px}.brand-description{font-size:9px;padding-left:10px}.desktop-nav{display:none}.mobile-menu{display:block;margin-left:auto;position:relative;font-size:14px}.mobile-menu summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:700;border-bottom:2px solid var(--amber)}.mobile-menu nav{position:absolute;right:0;top:48px;width:180px;background:var(--cream);color:var(--ink);box-shadow:4px 4px 0 #000;border:2px solid #000;padding:10px;z-index:10;display:flex;flex-direction:column;gap:0}.mobile-menu nav a{padding:10px;text-decoration:none}.hero{padding-top:30px;padding-bottom:30px}.eyebrow{font-size:9px;letter-spacing:0;margin-bottom:16px}.hero h1{font-size:clamp(45px,11vw,66px);line-height:1.03}.hero-description{font-size:18px;line-height:1.4;margin-top:18px}.hero-actions{gap:20px;flex-wrap:wrap;margin:22px 0 28px}.button{font-size:18px;min-height:47px;padding:8px 18px}.hero-actions>.text-link{font-size:16px}.hero-caption{font-size:14px;line-height:1.4;margin-top:22px;max-width:300px;margin-inline:auto}.paper-section,.lock-section{padding-block:30px}.section-heading{gap:10px;margin-bottom:18px}.section-heading h2{font-size:32px}.issue-number{font-size:9px;padding:5px}.nested-layout{grid-template-columns:1fr;gap:18px}.section-intro{padding:0;font-size:17px;gap:14px}.nested-layout .code-panel{margin-bottom:18px}.code-panel pre{font-size:11px;line-height:1.8;padding:12px}.code-label{font-size:10px;padding:7px 12px 0}.nested-layout .code-label{padding-top:4px}.section-lead{font-size:18px;margin-bottom:18px}.nested-record{flex-basis:100%}.record{gap:10px}.field{font-size:12px}.record-type{font-size:13px}.dependency-diagram{gap:13px}.dependency-node{padding:10px 12px;font-size:15px}.dependency-label{font-size:11px}.dependency-node .mono{font-size:12px}.chart-controls{display:block;margin:23px 0}.chart-controls label{display:block;font-size:13px;margin-bottom:7px}.chart-controls select{width:100%;max-width:100%;font-size:15px;min-height:44px}.dataset-chart h3{font-size:21px}.chart-unit{font-size:12px}.bars{gap:13px;margin-top:20px}.bar-row{grid-template-columns:96px minmax(0,1fr) 60px;gap:8px}.bar-label{font-size:12px}.bar-value{font-size:10px}.bar-track meter{height:22px}.chart-result,.method-note{font-size:13px}.benchmark-widget>.text-link{font-size:15px}.closing{padding-block:30px}.closing h2{font-size:30px;padding:10px 12px}.closing>p{font-size:16px}.forms-diagram{max-width:100%;font-size:14px}.form-node{min-width:75px;padding:8px 10px}.model-node{font-size:11px;padding:10px 12px}.site-footer{padding-block:20px 30px;gap:18px}.site-footer nav{width:100%;font-size:13px;justify-content:space-between;gap:8px}.site-footer .fine-print{font-size:11px}.article-heading{padding-block:25px 35px}.article-heading h1{font-size:49px}.article-heading .eyebrow{margin-top:25px}.article-lead{font-size:20px}.reading .section-heading h2{font-size:32px}.reading .code-panel pre{font-size:10px}.reading .section-heading{margin-top:30px}.contents{gap:10px 18px;font-size:14px}.callout{padding:16px;font-size:15px}.methodology{grid-template-columns:1fr;gap:6px}.methodology dd{font-size:16px;margin-bottom:15px}.methodology dt{font-size:15px}.download-links{gap:20px;font-size:15px}.fine-print{font-size:13px}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}.workload-buttons{display:flex;gap:12px;justify-content:flex-end;margin:18px 0 24px}.workload-buttons button{background:transparent;border:1px solid var(--ink);color:var(--ink);font-size:13px;font-weight:600;padding:8px 12px;min-height:44px;cursor:pointer}.workload-buttons button:hover{background:#ffc15a50}a:focus-visible,summary:focus-visible{outline-color:var(--cyan)}.paper-section a:focus-visible,.paper-section button:focus-visible,.paper-section select:focus-visible{outline-color:var(--teal)}\n@media(max-width:900px){.hero{padding-top:28px;padding-bottom:28px}.hero-description{margin-top:18px}.hero-actions{margin:22px 0 28px}.hero .eyebrow{margin-bottom:14px}.hero-caption{margin-top:20px}.paper-section,.lock-section{padding-block:32px}.closing{padding-block:28px}.hero h1{font-size:74px}}\n@media(max-width:600px){.hero h1{font-size:clamp(45px,11vw,66px)}.code-panel pre,.reading .code-panel pre{font-size:12px}.bar-value{font-size:12px}.bar-label{font-size:13px}.workload-buttons{justify-content:space-between;gap:8px}.workload-buttons button{font-size:12px;padding:8px 10px}.hero-caption{font-size:14px}}\n\n/* Supplied and generated raster brand artwork; all overlaid text is selectable. */\n.brand img{filter:none;background:transparent}.hero-actions{margin-bottom:20px}\n@media(max-width:900px){.hero h1{font-size:84px}.hero{padding-top:25px}.hero-actions{margin-bottom:16px}}\n@media(max-width:600px){.hero h1{font-size:clamp(45px,11vw,66px)}.hero-actions{margin-bottom:13px}}\n@media(max-width:900px){}\n@media(max-width:600px){}\n\n/* Match the approved cover: a wide ink bubble, independent callouts and yellow flairs. */\n.hero-title{position:relative;max-width:1000px;margin-inline:auto}.hero-title h1{position:relative;z-index:1}.headline-flair{position:absolute;z-index:0;width:80px;height:94px;object-fit:contain;top:12%;pointer-events:none}.headline-flair-left{left:1%}.headline-flair-right{right:1%;transform:scaleX(-1)}\n.hero-actions .button-primary{clip-path:polygon(7% 0,100% 0,93% 100%,0 100%);padding:10px 34px;border:0;box-shadow:none;font-style:italic}.closing h2{clip-path:polygon(4% 0,100% 0,96% 100%,0 100%);padding:10px 35px}.homepage .issue-number{display:none}.homepage .paper-section .section-heading{padding-bottom:14px;position:relative}.homepage .paper-section .section-heading:after{content:'';position:absolute;width:100px;left:0;bottom:0;border-bottom:6px solid var(--cyan)}.lock-section em{color:var(--amber)}\n@media(max-width:1100px) and (min-width:901px){.headline-flair{width:65px;height:80px}}\n@media(max-width:900px) and (min-width:601px){.hero-title h1{font-size:80px}.headline-flair{width:60px;height:70px;top:11%}.headline-flair-left{left:0}.headline-flair-right{right:0}.hero-caption{margin-top:10px}}\n@media(max-width:600px){.hero-title h1{font-size:clamp(44px,11vw,66px)}.headline-flair{width:40px;height:52px;top:1%}.headline-flair-left{left:-5px}.headline-flair-right{right:-5px}.hero-actions{gap:17px}.hero-actions .button-primary{padding:10px 25px;font-size:17px}.hero-caption{margin-top:10px}.closing h2{padding-inline:22px}.homepage .paper-section .section-heading:after{width:75px;border-bottom-width:5px}}\n\n.mobile-code-break{display:none}\n@media(max-width:900px) and (min-width:601px){.headline-flair{width:80px;height:90px;top:7%}}\n@media(max-width:600px){.mobile-code-break{display:block}}\n\n/* Scale the code with the cover rather than leaving the balloon visually empty. */\n@media(min-width:1101px){}\n@media(min-width:901px) and (max-width:1100px){}\n@media(min-width:601px) and (max-width:900px){}\n\n/* Sparse comic-print highlights along section edges. Decorative, with no hit targets. */\n.homepage .lock-section,.homepage .closing,.article-heading{position:relative;isolation:isolate;overflow:clip}\n.article-heading:after{right:-58px;top:2px;width:230px;height:230px;opacity:.19;transform:rotate(180deg)}\n@media(max-width:600px){.article-heading:after{width:155px;height:155px;right:-47px;opacity:.16}}\n@media(max-width:600px){}\n/* Detective Incus's issue: a paced comic presentation over the same Incan-owned document model. */\n.closing-links{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 30px;margin-top:22px}.spec-links{display:flex;flex-direction:column;gap:14px;margin:22px 0 35px}.site-footer nav{flex-wrap:wrap}.casebook{padding-top:28px;padding-bottom:55px}.case-masthead{margin-bottom:24px}.case-masthead h1{font-size:52px;letter-spacing:.03em;margin:12px 0 8px}.case-subtitle{font-size:16px;color:var(--muted)}.case-jump{display:flex;align-items:center;gap:15px;flex-wrap:wrap;margin:20px 0}.case-jump label{font-weight:600;font-size:14px}.case-jump select{background:var(--cream);color:var(--ink);border:2px solid #000;min-h