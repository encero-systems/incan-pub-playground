"""Crumb's companion identity and its introductory front-page chapter."""
from pub::pallay import DocumentNode
from components import el, node, txt, paragraph, link


pub def crumb_chapter() -> DocumentNode:
    identity = el("div", {"class": "crumb-identity"}, [el("img", {"src": "/assets/crumb-logo.svg", "alt": "Crumb", "width": "400", "height": "128", "class": "crumb-logo"}, []), node("p", "Typed binary", "crumb-identity-label"), paragraph("One typed model. Two representations.", "crumb-identity-note")])
    heading = el("h2", {}, [txt("The same values."), el("br", {}, []), txt("In "), node("mark", "binary", "word-highlight"), txt(".")])
    codecs = el("dl", {"class": "crumb-codecs"}, [el("dt", {}, [node("strong", "Row codec"), node("code", "crumb-row/1")]), el("dd", {}, [txt("Keeps each record’s typed cells together.")]), el("dt", {}, [node("strong", "Column codec"), node("code", "crumb-columns/1")]), el("dd", {}, [txt("Stores ordered records by field, with bounded blocks for selecting values.")])])
    copy = el("div", {"class": "crumb-story"}, [heading, paragraph("Crumb is the binary representation of the typed value model shared with .COMIC. The types, fields and values keep the same meaning.", "crumb-intro"), paragraph("A value carries its type description or is explicitly bound to one. Reference values stay references; reading them does not fetch their targets.", "crumb-detail"), codecs, paragraph("Experimental codec profiles · the format is still a draft.", "crumb-status"), el("div", {"class": "crumb-links"}, [link("Read the binary specification", "https://github.com/encero-systems/incan/blob/74324b9305547bb6c2d39197c7258b15a99cb7fd/specs/comic/spec/binary.md", "text-link"), link("See how the two forms fit", "/assets/how-it-works.html", "text-link")])])
    return el("section", {"id": "v2-crumb", "class": "v2-chapter v2-paper v2-crumb wrap", "aria-label": "Crumb: the shared typed value model in binary"}, [node("span", "03 / Crumb", "issue-number"), el("div", {"class": "crumb-layout"}, [identity, copy])])
