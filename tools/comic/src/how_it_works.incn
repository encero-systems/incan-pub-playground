"""Self-contained, static diagram in the approved .COMIC visual language."""


pub def how_it_works_html() -> str:
    return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>How .COMIC works</title><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bangers&amp;family=Barlow:wght@400;600&amp;family=Martian+Mono:wght@400;500&amp;display=swap\"><style>\n*{box-sizing:border-box}body{margin:0;background:#111820;color:#fff4df;font:18px/1.5 Barlow,Arial,sans-serif}main{width:calc(100% - 48px);max-width:1328px;margin:36px auto}header{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin:0 0 28px}h1{font:400 48px/1.05 Bangers,sans-serif;margin:14px 0}p{margin:0;max-width:75ch}a{color:#48f0ef;text-underline-offset:5px;font-size:15px}.eyebrow{display:inline-block;background:#ffc15a;color:#111820;padding:5px 10px;font:500 11px/1.5 'Martian Mono',monospace}.diagram-container{width:100%;max-width:100%;min-width:0;overflow-x:auto;background:#fff4df;border:3px solid #000;box-shadow:5px 5px 0 #fff4df2b}svg{display:block;width:100%;min-width:1280px;color:#111820}.diagram-container:focus-visible{outline:3px solid #48f0ef;outline-offset:5px}.pan-note{font-size:14px;color:#c4c9ca;margin:12px 0 26px}.reader-notes{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;font-size:16px;margin-top:24px}.reader-notes h2{font:600 18px/1.4 Barlow,sans-serif;margin:0 0 8px}.source-note{border-top:1px solid #fff4df44;margin-top:28px;padding-top:16px;color:#c4c9ca;font-size:13px}.node-name{font-family:Barlow,Arial,sans-serif;font-size:16px;font-weight:600;fill:#111820}.body-copy{font-family:Barlow,Arial,sans-serif;font-size:14px;fill:#25313d}.code{font-family:'Martian Mono',monospace;font-size:12px;font-variation-settings:'wdth' 95;fill:#25313d}.label{font-family:'Martian Mono',monospace;font-size:12px;font-weight:500;fill:#111820}.small{font-family:Barlow,Arial,sans-serif;font-size:14px;font-weight:600;fill:#111820}.output-title{font-family:Barlow,Arial,sans-serif;font-size:16px;font-weight:600;fill:#111820}svg text{font-kerning:normal}@media(max-width:700px){main{width:calc(100% - 28px);margin:24px auto}header{display:block}header a{display:inline-block;margin-top:15px}h1{font-size:40px}.reader-notes{grid-template-columns:1fr;gap:22px}.diagram-container{box-shadow:3px 3px 0 #fff4df2b}}@media print{body{background:#fff4df;color:#111820}main{width:100%;margin:0}.diagram-container{overflow-x:visible;box-shadow:none;border:0}svg{min-width:0}.pan-note,header a{display:none}.source-note{color:#46646a}.reader-notes{font-size:12px}}\n</style></head><body><main><header><div><span class=\"eyebrow\">.COMIC / HOW IT WORKS</span><h1>From descriptions to typed data.</h1><p>One complete example, from readable text to an admitted value and its two representations.</p></div><a href=\"/v2/\">Back to .COMIC v2</a></header><div class=\"diagram-container\" tabindex=\"0\" aria-label=\"How .COMIC works. Scroll horizontally to follow the complete diagram.\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1280 752\" role=\"img\" aria-labelledby=\"how-it-works-title how-it-works-desc\">\n<title id=\"how-it-works-title\">How .COMIC works</title>\n<desc id=\"how-it-works-desc\">A .COMIC reader parses document-described values, checks admission against the caller’s requested type, refuses invalid input, and produces admitted typed data for canonical text or Crumb encoding.</desc>\n<defs>\n<clipPath id=\"how-it-works-corner\"><path d=\"M1008 0H1280V144Z\"/></clipPath>\n<pattern id=\"how-it-works-dots\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\"><circle cx=\"10\" cy=\"10\" r=\"3\" fill=\"#d7a53a\"/></pattern>\n</defs>\n<rect x=\"0\" y=\"0\" width=\"1280\" height=\"752\" fill=\"#fff4df\"/>\n<g clip-path=\"url(#how-it-works-corner)\" opacity=\".3\"><rect x=\"1008\" y=\"0\" width=\"272\" height=\"144\" fill=\"url(#how-it-works-dots)\"/></g>\n<text x=\"40\" y=\"68\" font-family=\"Bangers,sans-serif\" font-size=\"40\" fill=\"#111820\">Descriptions make the types explicit.</text>\n<text x=\"40\" y=\"100\" class=\"body-copy\">Parse through the document’s description, then admit against the caller’s requested type.</text>\n<!-- A regular halftone field sits behind the admitted record, outside the reading surfaces. -->\n<g id=\"how-it-works-value-halftone\" transform=\"translate(0 32)\" fill=\"#d7a53a\" opacity=\".28\" aria-hidden=\"true\"><circle cx=\"768\" cy=\"168\" r=\"1\"/><circle cx=\"784\" cy=\"168\" r=\"1\"/><circle cx=\"800\" cy=\"168\" r=\"1\"/><circle cx=\"816\" cy=\"168\" r=\"1\"/><circle cx=\"832\" cy=\"168\" r=\"1\"/><circle cx=\"848\" cy=\"168\" r=\"1\"/><circle cx=\"864\" cy=\"168\" r=\"1\"/><circle cx=\"880\" cy=\"168\" r=\"1\"/><circle cx=\"736\" cy=\"184\" r=\"1\"/><circle cx=\"752\" cy=\"184\" r=\"1\"/><circle cx=\"768\" cy=\"184\" r=\"1\"/><circle cx=\"784\" cy=\"184\" r=\"2\"/><circle cx=\"800\" cy=\"184\" r=\"2\"/><circle cx=\"816\" cy=\"184\" r=\"2\"/><circle cx=\"832\" cy=\"184\" r=\"2\"/><circle cx=\"848\" cy=\"184\" r=\"2\"/><circle cx=\"864\" cy=\"184\" r=\"2\"/><circle cx=\"880\" cy=\"184\" r=\"1\"/><circle cx=\"896\" cy=\"184\" r=\"1\"/><circle cx=\"912\" cy=\"184\" r=\"1\"/><circle cx=\"720\" cy=\"200\" r=\"1\"/><circle cx=\"736\" cy=\"200\" r=\"1\"/><circle cx=\"752\" cy=\"200\" r=\"2\"/><circle cx=\"768\" cy=\"200\" r=\"2\"/><circle cx=\"784\" cy=\"200\" r=\"2\"/><circle cx=\"800\" cy=\"200\" r=\"2\"/><circle cx=\"816\" cy=\"200\" r=\"2\"/><circle cx=\"832\" cy=\"200\" r=\"2\"/><circle cx=\"848\" cy=\"200\" r=\"2\"/><circle cx=\"864\" cy=\"200\" r=\"2\"/><circle cx=\"880\" cy=\"200\" r=\"2\"/><circle cx=\"896\" cy=\"200\" r=\"2\"/><circle cx=\"912\" cy=\"200\" r=\"1\"/><circle cx=\"928\" cy=\"200\" r=\"1\"/><circle cx=\"704\" cy=\"216\" r=\"1\"/><circle cx=\"720\" cy=\"216\" r=\"1\"/><circle cx=\"736\" cy=\"216\" r=\"2\"/><circle cx=\"752\" cy=\"216\" r=\"2\"/><circle cx=\"768\" cy=\"216\" r=\"2\"/><circle cx=\"784\" cy=\"216\" r=\"3\"/><circle cx=\"800\" cy=\"216\" r=\"3\"/><circle cx=\"816\" cy=\"216\" r=\"3\"/><circle cx=\"832\" cy=\"216\" r=\"3\"/><circle cx=\"848\" cy=\"216\" r=\"3\"/><circle cx=\"864\" cy=\"216\" r=\"3\"/><circle cx=\"880\" cy=\"216\" r=\"2\"/><circle cx=\"896\" cy=\"216\" r=\"2\"/><circle cx=\"912\" cy=\"216\" r=\"2\"/><circle cx=\"928\" cy=\"216\" r=\"1\"/><circle cx=\"944\" cy=\"216\" r=\"1\"/><circle cx=\"688\" cy=\"232\" r=\"1\"/><circle cx=\"704\" cy=\"232\" r=\"1\"/><circle cx=\"720\" cy=\"232\" r=\"2\"/><circle cx=\"736\" cy=\"232\" r=\"2\"/><circle cx=\"752\" cy=\"232\" r=\"2\"/><circle cx=\"768\" cy=\"232\" r=\"3\"/><circle cx=\"784\" cy=\"232\" r=\"3\"/><circle cx=\"800\" cy=\"232\" r=\"3\"/><circle cx=\"816\" cy=\"232\" r=\"3\"/><circle cx=\"832\" cy=\"232\" r=\"3\"/><circle cx=\"848\" cy=\"232\" r=\"3\"/><circle cx=\"864\" cy=\"232\" r=\"3\"/><circle cx=\"880\" cy=\"232\" r=\"3\"/><circle cx=\"896\" cy=\"232\" r=\"2\"/><circle cx=\"912\" cy=\"232\" r=\"2\"/><circle cx=\"928\" cy=\"232\" r=\"2\"/><circle cx=\"944\" cy=\"232\" r=\"1\"/><circle cx=\"960\" cy=\"232\" r=\"1\"/><circle cx=\"688\" cy=\"248\" r=\"1\"/><circle cx=\"704\" cy=\"248\" r=\"2\"/><circle cx=\"720\" cy=\"248\" r=\"2\"/><circle cx=\"736\" cy=\"248\" r=\"2\"/><circle cx=\"752\" cy=\"248\" r=\"3\"/><circle cx=\"768\" cy=\"248\" r=\"3\"/><circle cx=\"784\" cy=\"248\" r=\"3\"/><circle cx=\"800\" cy=\"248\" r=\"3\"/><circle cx=\"816\" cy=\"248\" r=\"3\"/><circle cx=\"832\" cy=\"248\" r=\"3\"/><circle cx=\"848\" cy=\"248\" r=\"3\"/><circle cx=\"864\" cy=\"248\" r=\"3\"/><circle cx=\"880\" cy=\"248\" r=\"3\"/><circle cx=\"896\" cy=\"248\" r=\"3\"/><circle cx=\"912\" cy=\"248\" r=\"2\"/><circle cx=\"928\" cy=\"248\" r=\"2\"/><circle cx=\"944\" cy=\"248\" r=\"2\"/><circle cx=\"960\" cy=\"248\" r=\"1\"/><circle cx=\"672\" cy=\"264\" r=\"1\"/><circle cx=\"688\" cy=\"264\" r=\"1\"/><circle cx=\"704\" cy=\"264\" r=\"2\"/><circle cx=\"720\" cy=\"264\" r=\"2\"/><circle cx=\"736\" cy=\"264\" r=\"3\"/><circle cx=\"752\" cy=\"264\" r=\"3\"/><circle cx=\"768\" cy=\"264\" r=\"3\"/><circle cx=\"784\" cy=\"264\" r=\"3\"/><circle cx=\"800\" cy=\"264\" r=\"3\"/><circle cx=\"816\" cy=\"264\" r=\"3\"/><circle cx=\"832\" cy=\"264\" r=\"3\"/><circle cx=\"848\" cy=\"264\" r=\"3\"/><circle cx=\"864\" cy=\"264\" r=\"3\"/><circle cx=\"880\" cy=\"264\" r=\"3\"/><circle cx=\"896\" cy=\"264\" r=\"3\"/><circle cx=\"912\" cy=\"264\" r=\"3\"/><circle cx=\"928\" cy=\"264\" r=\"2\"/><circle cx=\"944\" cy=\"264\" r=\"2\"/><circle cx=\"960\" cy=\"264\" r=\"1\"/><circle cx=\"976\" cy=\"264\" r=\"1\"/><circle cx=\"672\" cy=\"280\" r=\"1\"/><circle cx=\"688\" cy=\"280\" r=\"1\"/><circle cx=\"704\" cy=\"280\" r=\"2\"/><circle cx=\"720\" cy=\"280\" r=\"2\"/><circle cx=\"736\" cy=\"280\" r=\"3\"/><circle cx=\"752\" cy=\"280\" r=\"3\"/><circle cx=\"768\" cy=\"280\" r=\"3\"/><circle cx=\"784\" cy=\"280\" r=\"3\"/><circle cx=\"800\" cy=\"280\" r=\"3\"/><circle cx=\"816\" cy=\"280\" r=\"3\"/><circle cx=\"832\" cy=\"280\" r=\"3\"/><circle cx=\"848\" cy=\"280\" r=\"3\"/><circle cx=\"864\" cy=\"280\" r=\"3\"/><circle cx=\"880\" cy=\"280\" r=\"3\"/><circle cx=\"896\" cy=\"280\" r=\"3\"/><circle cx=\"912\" cy=\"280\" r=\"3\"/><circle cx=\"928\" cy=\"280\" r=\"2\"/><circle cx=\"944\" cy=\"280\" r=\"2\"/><circle cx=\"960\" cy=\"280\" r=\"1\"/><circle cx=\"976\" cy=\"280\" r=\"1\"/><circle cx=\"672\" cy=\"296\" r=\"1\"/><circle cx=\"688\" cy=\"296\" r=\"1\"/><circle cx=\"704\" cy=\"296\" r=\"2\"/><circle cx=\"720\" cy=\"296\" r=\"2\"/><circle cx=\"736\" cy=\"296\" r=\"3\"/><circle cx=\"752\" cy=\"296\" r=\"3\"/><circle cx=\"768\" cy=\"296\" r=\"3\"/><circle cx=\"784\" cy=\"296\" r=\"3\"/><circle cx=\"800\" cy=\"296\" r=\"3\"/><circle cx=\"816\" cy=\"296\" r=\"3\"/><circle cx=\"832\" cy=\"296\" r=\"3\"/><circle cx=\"848\" cy=\"296\" r=\"3\"/><circle cx=\"864\" cy=\"296\" r=\"3\"/><circle cx=\"880\" cy=\"296\" r=\"3\"/><circle cx=\"896\" cy=\"296\" r=\"3\"/><circle cx=\"912\" cy=\"296\" r=\"3\"/><circle cx=\"928\" cy=\"296\" r=\"2\"/><circle cx=\"944\" cy=\"296\" r=\"2\"/><circle cx=\"960\" cy=\"296\" r=\"1\"/><circle cx=\"976\" cy=\"296\" r=\"1\"/><circle cx=\"672\" cy=\"312\" r=\"1\"/><circle cx=\"688\" cy=\"312\" r=\"2\"/><circle cx=\"704\" cy=\"312\" r=\"2\"/><circle cx=\"720\" cy=\"312\" r=\"3\"/><circle cx=\"736\" cy=\"312\" r=\"3\"/><circle cx=\"752\" cy=\"312\" r=\"3\"/><circle cx=\"768\" cy=\"312\" r=\"3\"/><circle cx=\"784\" cy=\"312\" r=\"3\"/><circle cx=\"800\" cy=\"312\" r=\"3\"/><circle cx=\"816\" cy=\"312\" r=\"3\"/><circle cx=\"832\" cy=\"312\" r=\"3\"/><circle cx=\"848\" cy=\"312\" r=\"3\"/><circle cx=\"864\" cy=\"312\" r=\"3\"/><circle cx=\"880\" cy=\"312\" r=\"3\"/><circle cx=\"896\" cy=\"312\" r=\"3\"/><circle cx=\"912\" cy=\"312\" r=\"3\"/><circle cx=\"928\" cy=\"312\" r=\"3\"/><circle cx=\"944\" cy=\"312\" r=\"2\"/><circle cx=\"960\" cy=\"312\" r=\"2\"/><circle cx=\"976\" cy=\"312\" r=\"1\"/><circle cx=\"672\" cy=\"328\" r=\"1\"/><circle cx=\"688\" cy=\"328\" r=\"1\"/><circle cx=\"704\" cy=\"328\" r=\"2\"/><circle cx=\"720\" cy=\"328\" r=\"2\"/><circle cx=\"736\" cy=\"328\" r=\"3\"/><circle cx=\"752\" cy=\"328\" r=\"3\"/><circle cx=\"768\" cy=\"328\" r=\"3\"/><circle cx=\"784\" cy=\"328\" r=\"3\"/><circle cx=\"800\" cy=\"328\" r=\"3\"/><circle cx=\"816\" cy=\"328\" r=\"3\"/><circle cx=\"832\" cy=\"328\" r=\"3\"/><circle cx=\"848\" cy=\"328\" r=\"3\"/><circle cx=\"864\" cy=\"328\" r=\"3\"/><circle cx=\"880\" cy=\"328\" r=\"3\"/><circle cx=\"896\" cy=\"328\" r=\"3\"/><circle cx=\"912\" cy=\"328\" r=\"3\"/><circle cx=\"928\" cy=\"328\" r=\"2\"/><circle cx=\"944\" cy=\"328\" r=\"2\"/><circle cx=\"960\" cy=\"328\" r=\"1\"/><circle cx=\"976\" cy=\"328\" r=\"1\"/><circle cx=\"672\" cy=\"344\" r=\"1\"/><circle cx=\"688\" cy=\"344\" r=\"1\"/><circle cx=\"704\" cy=\"344\" r=\"2\"/><circle cx=\"720\" cy=\"344\" r=\"2\"/><circle cx=\"736\" cy=\"344\" r=\"3\"/><circle cx=\"752\" cy=\"344\" r=\"3\"/><circle cx=\"768\" cy=\"344\" r=\"3\"/><circle cx=\"784\" cy=\"344\" r=\"3\"/><circle cx=\"800\" cy=\"344\" r=\"3\"/><circle cx=\"816\" cy=\"344\" r=\"3\"/><circle cx=\"832\" cy=\"344\" r=\"3\"/><circle cx=\"848\" cy=\"344\" r=\"3\"/><circle cx=\"864\" cy=\"344\" r=\"3\"/><circle cx=\"880\" cy=\"344\" r=\"3\"/><circle cx=\"896\" cy=\"344\" r=\"3\"/><circle cx=\"912\" cy=\"344\" r=\"3\"/><circle cx=\"928\" cy=\"344\" r=\"2\"/><circle cx=\"944\" cy=\"344\" r=\"2\"/><circle cx=\"960\" cy=\"344\" r=\"1\"/><circle cx=\"976\" cy=\"344\" r=\"1\"/><circle cx=\"672\" cy=\"360\" r=\"1\"/><circle cx=\"688\" cy=\"360\" r=\"1\"/><circle cx=\"704\" cy=\"360\" r=\"2\"/><circle cx=\"720\" cy=\"360\" r=\"2\"/><circle cx=\"736\" cy=\"360\" r=\"3\"/><circle cx=\"752\" cy=\"360\" r=\"3\"/><circle cx=\"768\" cy=\"360\" r=\"3\"/><circle cx=\"784\" cy=\"360\" r=\"3\"/><circle cx=\"800\" cy=\"360\" r=\"3\"/><circle cx=\"816\" cy=\"360\" r=\"3\"/><circle cx=\"832\" cy=\"360\" r=\"3\"/><circle cx=\"848\" cy=\"360\" r=\"3\"/><circle cx=\"864\" cy=\"360\" r=\"3\"/><circle cx=\"880\" cy=\"360\" r=\"3\"/><circle cx=\"896\" cy=\"360\" r=\"3\"/><circle cx=\"912\" cy=\"360\" r=\"3\"/><circle cx=\"928\" cy=\"360\" r=\"2\"/><circle cx=\"944\" cy=\"360\" r=\"2\"/><circle cx=\"960\" cy=\"360\" r=\"1\"/><circle cx=\"976\" cy=\"360\" r=\"1\"/><circle cx=\"688\" cy=\"376\" r=\"1\"/><circle cx=\"704\" cy=\"376\" r=\"2\"/><circle cx=\"720\" cy=\"376\" r=\"2\"/><circle cx=\"736\" cy=\"376\" r=\"2\"/><circle cx=\"752\" cy=\"376\" r=\"3\"/><circle cx=\"768\" cy=\"376\" r=\"3\"/><circle cx=\"784\" cy=\"376\" r=\"3\"/><circle cx=\"800\" cy=\"376\" r=\"3\"/><circle cx=\"816\" cy=\"376\" r=\"3\"/><circle cx=\"832\" cy=\"376\" r=\"3\"/><circle cx=\"848\" cy=\"376\" r=\"3\"/><circle cx=\"864\" cy=\"376\" r=\"3\"/><circle cx=\"880\" cy=\"376\" r=\"3\"/><circle cx=\"896\" cy=\"376\" r=\"3\"/><circle cx=\"912\" cy=\"376\" r=\"2\"/><circle cx=\"928\" cy=\"376\" r=\"2\"/><circle cx=\"944\" cy=\"376\" r=\"2\"/><circle cx=\"960\" cy=\"376\" r=\"1\"/><circle cx=\"688\" cy=\"392\" r=\"1\"/><circle cx=\"704\" cy=\"392\" r=\"1\"/><circle cx=\"720\" cy=\"392\" r=\"2\"/><circle cx=\"736\" cy=\"392\" r=\"2\"/><circle cx=\"752\" cy=\"392\" r=\"2\"/><circle cx=\"768\" cy=\"392\" r=\"3\"/><circle cx=\"784\" cy=\"392\" r=\"3\"/><circle cx=\"800\" cy=\"392\" r=\"3\"/><circle cx=\"816\" cy=\"392\" r=\"3\"/><circle cx=\"832\" cy=\"392\" r=\"3\"/><circle cx=\"848\" cy=\"392\" r=\"3\"/><circle cx=\"864\" cy=\"392\" r=\"3\"/><circle cx=\"880\" cy=\"392\" r=\"3\"/><circle cx=\"896\" cy=\"392\" r=\"2\"/><circle cx=\"912\" cy=\"392\" r=\"2\"/><circle cx=\"928\" cy=\"392\" r=\"2\"/><circle cx=\"944\" cy=\"392\" r=\"1\"/><circle cx=\"960\" cy=\"392\" r=\"1\"/><circle cx=\"704\" cy=\"408\" r=\"1\"/><circle cx=\"720\" cy=\"408\" r=\"1\"/><circle cx=\"736\" cy=\"408\" r=\"2\"/><circle cx=\"752\" cy=\"408\" r=\"2\"/><circle cx=\"768\" cy=\"408\" r=\"2\"/><circle cx=\"784\" cy=\"408\" r=\"3\"/><circle cx=\"800\" cy=\"408\" r=\"3\"/><circle cx=\"816\" cy=\"408\" r=\"3\"/><circle cx=\"832\" cy=\"408\" r=\"3\"/><circle cx=\"848\" cy=\"408\" r=\"3\"/><circle cx=\"864\" cy=\"408\" r=\"3\"/><circle cx=\"880\" cy=\"408\" r=\"2\"/><circle cx=\"896\" cy=\"408\" r=\"2\"/><circle cx=\"912\" cy=\"408\" r=\"2\"/><circle cx=\"928\" cy=\"408\" r=\"1\"/><circle cx=\"944\" cy=\"408\" r=\"1\"/><circle cx=\"720\" cy=\"424\" r=\"1\"/><circle cx=\"736\" cy=\"424\" r=\"1\"/><circle cx=\"752\" cy=\"424\" r=\"2\"/><circle cx=\"768\" cy=\"424\" r=\"2\"/><circle cx=\"784\" cy=\"424\" r=\"2\"/><circle cx=\"800\" cy=\"424\" r=\"2\"/><circle cx=\"816\" cy=\"424\" r=\"2\"/><circle cx=\"832\" cy=\"424\" r=\"2\"/><circle cx=\"848\" cy=\"424\" r=\"2\"/><circle cx=\"864\" cy=\"424\" r=\"2\"/><circle cx=\"880\" cy=\"424\" r=\"2\"/><circle cx=\"896\" cy=\"424\" r=\"2\"/><circle cx=\"912\" cy=\"424\" r=\"1\"/><circle cx=\"928\" cy=\"424\" r=\"1\"/><circle cx=\"736\" cy=\"440\" r=\"1\"/><circle cx=\"752\" cy=\"440\" r=\"1\"/><circle cx=\"768\" cy=\"440\" r=\"1\"/><circle cx=\"784\" cy=\"440\" r=\"2\"/><circle cx=\"800\" cy=\"440\" r=\"2\"/><circle cx=\"816\" cy=\"440\" r=\"2\"/><circle cx=\"832\" cy=\"440\" r=\"2\"/><circle cx=\"848\" cy=\"440\" r=\"2\"/><circle cx=\"864\" cy=\"440\" r=\"2\"/><circle cx=\"880\" cy=\"440\" r=\"1\"/><circle cx=\"896\" cy=\"440\" r=\"1\"/><circle cx=\"912\" cy=\"440\" r=\"1\"/><circle cx=\"768\" cy=\"456\" r=\"1\"/><circle cx=\"784\" cy=\"456\" r=\"1\"/><circle cx=\"800\" cy=\"456\" r=\"1\"/><circle cx=\"816\" cy=\"456\" r=\"1\"/><circle cx=\"832\" cy=\"456\" r=\"1\"/><circle cx=\"848\" cy=\"456\" r=\"1\"/><circle cx=\"864\" cy=\"456\" r=\"1\"/><circle cx=\"880\" cy=\"456\" r=\"1\"/></g>\n<!-- Paper shadows are decorative layers, painted before the connectors and opaque nodes. -->\n<g id=\"how-it-works-paper-shadows\" transform=\"translate(0 32)\" fill=\"#111820\" opacity=\".2\" aria-hidden=\"true\">\n<path d=\"M48 208L344 192V440H48Z\"/>\n<path d=\"M424 320L536 240L648 320L536 400Z\"/>\n<path d=\"M728 200H936V428H792L760 452L768 428H728Z\"/>\n<path d=\"M1048 156L1248 148V280H1048Z\"/>\n<path d=\"M1048 428L1248 420V552H1048Z\"/>\n<rect x=\"440\" y=\"508\" width=\"192\" height=\"96\" rx=\"20\"/>\n</g>\n<!-- Each connector is one closed, filled silhouette: no markers or overlaid strokes. -->\n<g id=\"how-it-works-connectors\" transform=\"translate(0 32)\" fill=\"#00777e\" stroke=\"#111820\" stroke-width=\"2\" stroke-linejoin=\"round\">\n<path id=\"how-it-works-read\" d=\"M336 308H396V301L416 312L396 323V316H336Z\"/>\n<path id=\"how-it-works-admit\" d=\"M632 308H700V301L720 312L700 323V316H632Z\"/>\n<path id=\"how-it-works-print\" d=\"M928 268H976Q980 268 980 264V216Q980 204 992 204H1020V197L1040 208L1020 219V212H992Q988 212 988 216V264Q988 276 976 276H928Z\"/>\n<path id=\"how-it-works-encode\" d=\"M928 348H984Q996 348 996 360V472Q996 476 1000 476H1020V469L1040 480L1020 491V484H1000Q988 484 988 472V360Q988 356 984 356H928Z\"/>\n<path id=\"how-it-works-caller-input\" d=\"M524 192V212H517L528 232L539 212H532V192Z\" fill=\"#111820\"/>\n<path id=\"how-it-works-refuse\" d=\"M524 388V480H517L528 500L539 480H532V388Z\" fill=\"#111820\"/>\n</g>\n<!-- Labels remain literal and separate from the arrow ink. -->\n<g text-anchor=\"middle\" transform=\"translate(0 32)\">\n<rect x=\"352\" y=\"280\" width=\"48\" height=\"20\" fill=\"#fff4df\"/><text x=\"376\" y=\"294\" class=\"label\">READ</text>\n<rect x=\"656\" y=\"280\" width=\"48\" height=\"20\" fill=\"#fff4df\"/><text x=\"680\" y=\"294\" class=\"label\">YES</text>\n<rect x=\"540\" y=\"436\" width=\"40\" height=\"20\" fill=\"#fff4df\"/><text x=\"560\" y=\"450\" class=\"label\">NO</text>\n<rect x=\"984\" y=\"176\" width=\"48\" height=\"20\" fill=\"#fff4df\"/><text x=\"1008\" y=\"190\" class=\"label\">PRINT</text>\n<rect x=\"936\" y=\"320\" width=\"56\" height=\"20\" fill=\"#fff4df\"/><text x=\"964\" y=\"334\" class=\"label\">ENCODE</text>\n</g>\n<!-- The document is a paper panel; its code stays straight and selectable. -->\n<g id=\"how-it-works-document\" transform=\"translate(0 32)\">\n<path d=\"M40 200L336 184V432H40Z\" fill=\"#fff4df\" stroke=\"#111820\" stroke-width=\"3\"/>\n<path d=\"M60 212H224L220 240H56Z\" fill=\"#111820\" opacity=\".2\"/>\n<path d=\"M60 208H224L220 236H56Z\" fill=\"#ffc15a\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"68\" y=\"226\" class=\"label\">01 / DOCUMENT</text>\n<rect x=\"56\" y=\"244\" width=\"264\" height=\"96\" fill=\"#fff9ee\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<path d=\"M56 244H320V272H56Z\" fill=\"#ffe0a3\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"68\" y=\"263\" class=\"small\">Type description</text>\n<text x=\"68\" y=\"288\" class=\"code\"><tspan fill=\"#004fc4\">shop.Item</tspan> = <tspan fill=\"#990078\">Record</tspan> {</text>\n<text x=\"92\" y=\"308\" class=\"code\">id: <tspan fill=\"#007064\">i64</tspan></text>\n<text x=\"68\" y=\"328\" class=\"code\">}</text>\n<rect x=\"56\" y=\"352\" width=\"264\" height=\"60\" fill=\"#fff9ee\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<path d=\"M56 352H320V380H56Z\" fill=\"#ffe0a3\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"68\" y=\"371\" class=\"small\">Stored value</text>\n<text x=\"68\" y=\"401\" class=\"code\"><tspan fill=\"#004fc4\">shop.Item</tspan> &lt;&lt; (id=<tspan fill=\"#9d5000\">1</tspan>)</text>\n</g>\n<g id=\"how-it-works-caller\">\n<path d=\"M458 188H610L606 228H454Z\" fill=\"#111820\" opacity=\".2\"/>\n<path d=\"M454 184H606L602 224H450Z\" fill=\"#ffc15a\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"528\" y=\"201\" text-anchor=\"middle\" class=\"small\">Requested type</text>\n<text x=\"528\" y=\"218\" text-anchor=\"middle\" class=\"small\">from caller</text>\n</g>\n<g id=\"how-it-works-reader\">\n<path d=\"M444 120H620L616 148H440Z\" fill=\"#111820\" opacity=\".2\"/>\n<path d=\"M444 116H620L616 144H440Z\" fill=\"#00777e\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"528\" y=\"135\" text-anchor=\"middle\" font-family=\"'Martian Mono',monospace\" font-size=\"12\" fill=\"#fff4df\">02 / READER</text>\n<rect x=\"424\" y=\"152\" width=\"64\" height=\"24\" fill=\"#d2eeeb\" stroke=\"#111820\"/>\n<rect x=\"496\" y=\"152\" width=\"64\" height=\"24\" fill=\"#d2eeeb\" stroke=\"#111820\"/>\n<rect x=\"568\" y=\"152\" width=\"64\" height=\"24\" fill=\"#d2eeeb\" stroke=\"#111820\"/>\n<text x=\"456\" y=\"168\" text-anchor=\"middle\" class=\"small\">Syntax</text><text x=\"528\" y=\"168\" text-anchor=\"middle\" class=\"small\">Shape</text><text x=\"600\" y=\"168\" text-anchor=\"middle\" class=\"small\">Limits</text>\n<g transform=\"translate(0 32)\">\n<path d=\"M416 312L528 232L640 312L528 392Z\" fill=\"#fff0cf\" stroke=\"#111820\" stroke-width=\"4\"/>\n<text x=\"528\" y=\"304\" text-anchor=\"middle\" font-family=\"Bangers,sans-serif\" font-size=\"26\" fill=\"#111820\">Valid for the</text>\n<text x=\"528\" y=\"332\" text-anchor=\"middle\" font-family=\"Bangers,sans-serif\" font-size=\"26\" fill=\"#111820\">requested type?</text>\n</g>\n</g>\n<!-- The admitted record uses the same square speech shape as the site's Item/Buyer diagrams. -->\n<g id=\"how-it-works-value\" transform=\"translate(0 32)\">\n<path d=\"M720 192H928V420H784L752 444L760 420H720Z\" fill=\"#d2eeeb\" stroke=\"#111820\" stroke-width=\"3\" stroke-linejoin=\"bevel\"/>\n<path d=\"M740 212H916L912 240H736Z\" fill=\"#111820\" opacity=\".2\"/>\n<path d=\"M740 208H916L912 236H736Z\" fill=\"#ffc15a\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"748\" y=\"226\" class=\"label\">03 / TYPED VALUE</text>\n<text x=\"736\" y=\"278\" font-family=\"Bangers,sans-serif\" font-size=\"32\" fill=\"#111820\">Item</text>\n<text x=\"736\" y=\"302\" class=\"code\">shop.Item</text>\n<text x=\"736\" y=\"330\" class=\"small\">Stored field</text><text x=\"856\" y=\"330\" class=\"small\">Type</text>\n<path d=\"M744 348H852L848 384H740Z\" fill=\"#111820\" opacity=\".2\"/>\n<path d=\"M740 344H848L844 380H736Z\" fill=\"#ffc15a\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"750\" y=\"368\" class=\"code\" font-weight=\"500\">id = 1</text>\n<path d=\"M860 348H916L912 384H856Z\" fill=\"#111820\" opacity=\".2\"/>\n<path d=\"M860 344H916L912 380H856Z\" fill=\"#fff4df\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"870\" y=\"368\" class=\"code\">i64</text>\n<text x=\"736\" y=\"408\" class=\"small\">The type stays explicit.</text>\n</g>\n<g id=\"how-it-works-text\" transform=\"translate(0 32)\">\n<path d=\"M1040 148L1240 140V272H1040Z\" fill=\"#fff9ee\" stroke=\"#111820\" stroke-width=\"3\"/>\n<path d=\"M1056 156H1228L1224 184H1052Z\" fill=\"#ffc15a\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"1062\" y=\"177\" font-family=\"Bangers,sans-serif\" font-size=\"22\" fill=\"#111820\">Canonical .COMIC</text>\n<text x=\"1056\" y=\"208\" class=\"body-copy\">Descriptions first.</text>\n<text x=\"1056\" y=\"232\" class=\"body-copy\">Fixed text layout.</text>\n<text x=\"1056\" y=\"256\" class=\"small\">Readable text</text>\n</g>\n<g id=\"how-it-works-binary\" transform=\"translate(0 32)\">\n<path d=\"M1040 420L1240 412V544H1040Z\" fill=\"#fff9ee\" stroke=\"#111820\" stroke-width=\"3\"/>\n<path d=\"M1056 428H1200L1196 456H1052Z\" fill=\"#d2eeeb\" stroke=\"#111820\" stroke-width=\"1.5\"/>\n<text x=\"1062\" y=\"449\" font-family=\"Bangers,sans-serif\" font-size=\"24\" fill=\"#111820\">Crumb binary</text>\n<text x=\"1056\" y=\"480\" class=\"body-copy\">Row or column codec.</text>\n<text x=\"1056\" y=\"504\" class=\"body-copy\">Same logical value.</text>\n<text x=\"1056\" y=\"528\" class=\"small\">Experimental codecs</text>\n</g>\n<g id=\"how-it-works-invalid\" transform=\"translate(0 32)\">\n<rect x=\"432\" y=\"500\" width=\"192\" height=\"96\" rx=\"20\" fill=\"#f1e8d8\" stroke=\"#111820\" stroke-width=\"2.5\"/>\n<text x=\"528\" y=\"532\" text-anchor=\"middle\" font-family=\"Bangers,sans-serif\" font-size=\"24\" fill=\"#111820\">Input refused</text>\n<text x=\"528\" y=\"556\" text-anchor=\"middle\" class=\"small\">Wrong type · duplicate field</text>\n<text x=\"528\" y=\"576\" text-anchor=\"middle\" class=\"small\">Missing description · limits</text>\n</g>\n<line x1=\"40\" y1=\"688\" x2=\"1240\" y2=\"688\" stroke=\"#d6cbb9\"/>\n<text x=\"40\" y=\"716\" class=\"body-copy\">Reading does not run constructors.</text>\n<text x=\"704\" y=\"716\" class=\"body-copy\">References stay references. Reading fetches nothing.</text>\n</svg></div><p class=\"pan-note\">On a narrow screen, scroll the diagram sideways. Text remains at its designed size.</p><div class=\"reader-notes\"><section><h2>The document describes the data.</h2><p>The reader first parses each value through the document’s own description. It then admits the value against the description requested by the caller, matching fields by name and recorded earlier names. A document can be consistent with itself and still be refused for the requested type.</p></section><section><h2>The representation can change.</h2><p>The admitted type, fields and values can be printed as canonical .COMIC or encoded as Crumb. This diagram shows the specified flow, not a delivered codec claim.</p></section></div><footer class=\"source-note\">Based on the site's specification pin 74324b930554: text, values and binary contracts. Hashing, compatibility details, sealing and codec layout are intentionally outside this overview.</footer></main></body></html>"
