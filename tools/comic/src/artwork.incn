"""Deterministic geometric artwork emitted as SVG by the Incan publication."""


pub def halftone_svg() -> str:
    mut svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 180" fill="#48f0ef">'
    for row in range(14):
        y = 12 + row * 12
        for column in range(18):
            x = 12 + column * 12 + (row % 2) * 6
            distance = (x - 120) * (x - 120) + (y - 90) * (y - 90)
            if distance <= 6400:
                mut radius = 1
                if distance < 900:
                    radius = 4
                elif distance < 2500:
                    radius = 3
                elif distance < 4500:
                    radius = 2
                svg += '<circle cx="' + str(x) + '" cy="' + str(y) + '" r="' + str(radius) + '"/>'
    return svg + '</svg>'


pub def flow_arrows_svg() -> str:
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 70"><path d="M4 19H91M82 10l9 9-9 9" fill="none" stroke="#48f0ef" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"/><path d="M96 51H9M18 42l-9 9 9 9" fill="none" stroke="#ffc15a" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"/></svg>'


pub def speech_tail_svg() -> str:
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 90" preserveAspectRatio="none"><path d="M0 0H44L116 82Z" fill="#fff4df"/><path d="M0 0L116 82L44 0" fill="none" stroke="#000" stroke-width="5" stroke-linejoin="bevel" vector-effect="non-scaling-stroke"/></svg>'


pub def navigation_arrow_svg() -> str:
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 18"><path d="M1 5H13V1L23 9L13 17V13H1Z" fill="#ffc45b" stroke="#111820" stroke-width="1.5" stroke-linejoin="miter"/></svg>'


pub def bubble_outline_svg(mobile: bool = false) -> str:
    mut bottom = "516"
    if mobile:
        bottom = str("596")
    points = "24,24 1196,4 1152," + bottom + " 4," + bottom
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" preserveAspectRatio="none"><defs><clipPath id="bubble"><polygon points="' + points + '"/></clipPath></defs><polygon points="' + points + '" fill="#fff4df"/><path d="M1060 0H1200V100Z" fill="#ffc45b" clip-path="url(#bubble)"/><polygon points="' + points + '" fill="none" stroke="#000" stroke-width="5" stroke-linejoin="miter" vector-effect="non-scaling-stroke"/></svg>'


pub def visor_mask_svg() -> str:
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1290"><path d="M344 568C357 565 380 568 400 570L414 578L450 574L464 581L510 578L522 585L550 583L568 591L600 590L635 599L655 598L674 607L719 619L700 674L516 701L434 637Q385 613 325 635Z" fill="white"/></svg>'


pub def record_bubble_svg(buyer: bool = false) -> str:
    mut fill = "#fff4df"
    if buyer:
        fill = str("#d0eeea")
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300" preserveAspectRatio="none"><path d="M4 4H596V270H82L43 294L50 270H4Z" fill="' + fill + '" stroke="#000" stroke-width="3" stroke-linejoin="bevel" vector-effect="non-scaling-stroke"/></svg>'


pub def amber_halftone_svg() -> str:
    return halftone_svg().replace("#48f0ef", "#d7a53a")


pub def comic_flow_arrows_svg() -> str:
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 88"><path d="M4 18H72V6L96 24L72 42V30H4Z" fill="#00777e" stroke="#111820" stroke-width="2" stroke-linejoin="miter"/><path d="M96 58H28V46L4 64L28 82V70H96Z" fill="#ffc15a" stroke="#111820" stroke-width="2" stroke-linejoin="miter"/></svg>'
