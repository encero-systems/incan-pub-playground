pub def stylesheet() -> str:
    return """
@font-face{font-family:Young Serif;src:url(assets/young-serif.woff2);font-display:swap}
@font-face{font-family:Montagu Slab;src:url(assets/montagu-slab.woff2);font-weight:700;font-display:swap}
@font-face{font-family:Caveat;src:url(assets/caveat.woff2);font-weight:500;font-display:swap}
@font-face{font-family:Playfair Display;src:url(assets/playfair-display.woff2);font-weight:800;font-display:swap}
@font-face{font-family:Inter;src:url(assets/inter.woff2);font-weight:400 800;font-display:swap}
@font-face{font-family:Encero Lato;src:url(../incan-io-directions/obsidian-incan/fonts/Lato-Bold.ttf);font-weight:700;font-display:swap}
:root{
  --paper:#fbf8f0;--ink:#11151d;--blue:#1238b5;--navy:#101b31;--rule:#1a2a51;--grid:#314d9f20;
  --serif:"Playfair Display",Georgia,serif;--sans:Inter,system-ui,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Consolas,monospace;color-scheme:light;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1rem/1.55 var(--sans)}
p,h1,h2,h3,figure,dl,dd{margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:5px}
.wrap{width:min(100% - 5rem,1250px);margin-inline:auto}
.skip{position:absolute;top:.75rem;left:1rem;z-index:2;background:var(--paper);padding:.5rem 1rem;transform:translateY(-160%)}
.skip:focus{transform:none}
.masthead{min-height:132px;display:flex;align-items:center;justify-content:space-between;gap:1.5rem;border-bottom:3px solid var(--rule)}
.signature,.brand,.maker,.masthead nav{display:flex;align-items:center}
.signature{flex-shrink:0;gap:1rem}
.brand{text-decoration:none;line-height:1;white-space:nowrap}
.record-mark{background:url(assets/record-mark.svg) center/contain no-repeat;width:32px;height:32px;margin-inline-end:.64rem}
.brand-word{font:400 clamp(2.2rem,3.15vw,3rem)/1 "Young Serif",Georgia,serif;letter-spacing:-.065em}
.db-stamp{
  position:relative;display:inline-block;color:var(--blue);padding:.08em .115em .09em;margin-inline-start:.025em;
  font:700 clamp(1.45rem,2.15vw,2rem)/.93 "Montagu Slab",Georgia,serif;letter-spacing:-.03em;
  transform:rotate(-8deg);text-shadow:.015em .015em #143aa78c;
  mask:url(assets/stamp-grain.png) center/100% 100%;
}
.db-stamp::before{
  content:"";position:absolute;inset:0;border-radius:.08em;
  background:
    linear-gradient(90deg,var(--blue) 0 38%,transparent 40% 44%,var(--blue) 46%) top/100% .055em no-repeat,
    linear-gradient(var(--blue) 0 32%,transparent 33% 41%,var(--blue) 42%) right/.057em 100% no-repeat,
    linear-gradient(90deg,var(--blue) 0 12%,transparent 13% 17%,var(--blue) 18%) bottom/100% .074em no-repeat,
    linear-gradient(var(--blue),#2148af) left/.055em 100% no-repeat;
}
.db-stamp::after{content:"";position:absolute;right:.05em;bottom:-.06em;width:44%;height:.035em;background:#1238b583}
.maker{border-inline-start:1px solid var(--ink);padding-inline-start:.72rem;gap:.42rem;white-space:nowrap}
.maker i{font:italic 1.02rem Georgia,serif}
.maker strong{font:700 .9rem "Encero Lato",sans-serif;letter-spacing:.14em}
.masthead nav{gap:clamp(1.15rem,3.25vw,3.4rem)}
.masthead nav a{text-decoration:none;font-weight:550;white-space:nowrap}
.masthead nav a:hover{text-decoration:underline;text-underline-offset:.24em}
.photocopied{mask:linear-gradient(#000,#000),url(assets/toner-grain.png) 0 0/570px 167px;mask-composite:subtract}
.action{
  --stamp:var(--blue);--label:var(--paper);--angle:-1.3deg;--fleck:.7;
  position:relative;display:inline-flex;align-items:center;justify-content:center;
  isolation:isolate;min-height:48px;padding:.66rem 1.18rem;color:var(--label);
  font-weight:680;font-size:.98rem;line-height:1.35;text-align:center;text-decoration:none;white-space:nowrap;
}
.action::before{
  content:"";position:absolute;z-index:-1;inset:0;border-radius:5px 4px 6px 5px;
  background:var(--stamp);transform:rotate(var(--angle));
  clip-path:polygon(.1% 9%,1.6% 2%,23% 1.6%,34% 0,48% 1.6%,60% .3%,66% 1.8%,95% .8%,99.3% 3.8%,99.9% 13%,99.5% 27%,100% 43%,99.7% 83%,98.9% 95%,96.3% 98%,73% 97.4%,65% 100%,56% 98.1%,36% 99.2%,25% 97.7%,3% 98.3%,.6% 92%,.3% 77%,.8% 64%,0 47%,.4% 35%);
  mask:url(assets/stamp-grain.png) center/100% 100%;
}
.action::after{
  content:"";position:absolute;z-index:-2;inset:-12% -3%;opacity:var(--fleck);transform:rotate(var(--angle));
  background:
    radial-gradient(ellipse 2.2px 1.4px at 2.4% 74%,var(--stamp) 0 54%,transparent 100%),
    radial-gradient(ellipse 1px 1.3px at 1% 80%,var(--stamp) 0 35%,transparent 100%),
    radial-gradient(ellipse 1.7px .8px at 4% 88%,var(--stamp) 0 40%,transparent 100%),
    radial-gradient(ellipse 1.9px 1.1px at 97% 19%,var(--stamp) 0 48%,transparent 100%),
    radial-gradient(ellipse 1px .7px at 99% 23%,var(--stamp) 0 32%,transparent 100%),
    linear-gradient(90deg,transparent,var(--stamp) 30% 69%,transparent) 89% 94%/13% 1px no-repeat;
}
.action:hover{text-decoration:underline;text-underline-offset:.22em}
.action-outline{--label:var(--navy);--angle:.65deg;--fleck:.48;min-height:44px}
.action-outline::before{
  clip-path:none;
  background:
    linear-gradient(90deg,var(--blue) 0 60%,transparent 61% 64%,var(--blue) 65%) top/100% 2px no-repeat,
    linear-gradient(var(--blue) 0 24%,transparent 26% 32%,var(--blue) 34%) right/2px 100% no-repeat,
    linear-gradient(90deg,var(--blue) 0 15%,transparent 16% 18%,#102a91 19%) bottom/100% 2.5px no-repeat,
    linear-gradient(var(--blue),#1e3eab) left/2px 100% no-repeat;
}
.hero{
  display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.33fr);
  align-items:center;gap:clamp(1.4rem,3vw,2.8rem);padding-block:3.7rem 2.8rem;
  border-bottom:2px solid var(--rule);
}
h1,h2{font:800 1rem/1.08 var(--serif);letter-spacing:-.035em}
h1{font-size:clamp(2.65rem,4.2vw,4.15rem)}
.hero-copy>p{font-size:clamp(1.04rem,1.53vw,1.35rem);line-height:1.48;margin-top:1.45rem;max-width:35ch}
.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.45rem;margin-top:2.35rem}
.pen{font:500 1.65rem/1.05 Caveat,cursive;color:var(--blue)}
.pen-link{text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:.17em}
.pen-link span{display:inline-block;text-decoration:none;font:400 1.05em/1 Georgia,serif;transform:rotate(8deg)}
.pen-link:hover{text-decoration-thickness:2.5px}
.scratchpad{
  position:relative;isolation:isolate;min-width:0;min-height:360px;padding:2rem 1.45rem 1.6rem 2.9rem;
  filter:drop-shadow(1px 5px 4px #251f1c32);
}
.scratchpad::before{
  content:"";position:absolute;inset:0;z-index:-1;
  background:
    linear-gradient(90deg,transparent 27px,#c6537166 27px 28px,transparent 28px),
    repeating-linear-gradient(0deg,transparent 0 20px,var(--grid) 20px 21px),
    repeating-linear-gradient(90deg,transparent 0 20px,var(--grid) 20px 21px),#fdfcf7;
  border:1px solid #14275722;
  clip-path:polygon(.3% .6%,9% 0,22% .45%,32% .1%,46% .6%,57% .3%,72% .7%,84% .15%,99.6% .7%,99.9% 18%,99.7% 33%,100% 63%,99.8% 83%,99.9% 98.6%,96% 99.6%,92% 99.15%,88% 99.65%,83% 98.9%,76% 99.65%,72% 99.2%,69% 100%,65% 99.5%,61% 99.85%,56% 99.2%,50% 99.9%,46% 99.4%,42% 99.85%,37% 99.25%,29% 99.9%,24% 99.2%,19% 99.8%,15% 99.2%,10% 99.75%,5% 99.2%,.35% 99.8%,.15% 81%,0 60%,.25% 43%,.15% 18%);

}
.scratchpad figcaption{font-size:clamp(2.35rem,4.2vw,3.45rem);width:max-content;max-width:100%;border-bottom:2px solid var(--blue);padding-bottom:.16em}
.query-flow{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(54px,.9fr) minmax(0,1fr);gap:.45rem;align-items:center;margin-top:1.9rem}
.note-card{min-width:0;border:2px solid var(--blue);border-radius:13px 10px 12px 7px;background:#fbfaf29e;padding:.36rem .55rem .38rem;box-shadow:1px 1px #1238b52a}
.note-card.record{transform:rotate(-.7deg)}
.note-card.result{transform:rotate(.7deg)}
.note-title{font-size:clamp(1.35rem,2.2vw,1.94rem);padding-bottom:.25em;border-bottom:1px solid #1238b58c}
.record-name,.note-card dl{font:600 clamp(.74rem,1.17vw,1rem)/1.35 var(--mono)}
.record-name{display:block;padding:.37rem 0 .28rem;overflow-wrap:anywhere}
.note-card dl{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:.48em}
.note-card dt,.note-card dd{padding:.23rem 0;border-top:1px solid #1238b53b}
.note-card dd{overflow-wrap:anywhere}
.prism{color:var(--blue);margin-inline:-.3rem}
.prism svg{display:block;width:100%;height:auto}
.margin-note{margin-top:.65rem;transform:rotate(-1.6deg);width:max-content;max-width:100%;font-size:clamp(1.35rem,2.4vw,2.05rem)}
.margin-note span{font-family:Georgia,serif}
.product{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:1.65rem;padding-block:2.6rem 3.15rem}
.product h2{font-size:clamp(2.05rem,3.9vw,3.45rem)}
.features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;margin-top:1.65rem;padding:.7rem 0 1rem 1.2rem;border-inline-start:1px solid #c65371a0;background:repeating-linear-gradient(0deg,transparent 0 29px,var(--grid) 29px 30px)}
.features h3{font-size:clamp(1.03rem,1.6vw,1.4rem);line-height:1.2}
.features p{margin-top:.45rem;line-height:1.5}
.walkthrough{align-self:start;text-align:center}
.walkthrough img{display:block;width:min(100%,160px);height:auto;margin-inline:auto;mix-blend-mode:multiply}
.walkthrough summary{cursor:pointer;list-style:none;min-height:44px;padding:.35em .1em;font-size:1.65rem}
.walkthrough summary::-webkit-details-marker{display:none}
.walkthrough summary::after{content:" +";display:inline-block;padding-left:.18em;text-decoration:none}
.walkthrough details[open] summary::after{content:" −"}
.walkthrough ol,.walkthrough details>p{text-align:left;font-size:.9rem;line-height:1.5}
.walkthrough ol{margin:.25rem 0 .6rem;padding-left:1.25rem}
.walkthrough li+li{margin-top:.28rem}
.access{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:1.55rem;background:var(--navy);color:var(--paper);border-radius:10px;margin-bottom:3rem;padding:1.85rem 2.35rem}
.access h2{font-size:clamp(1.85rem,3.2vw,2.75rem);white-space:nowrap}
.access p{border-inline-start:1px solid #fbf8f0a3;padding-inline-start:1.55rem}
.action-paper{--stamp:#fbf4e6;--label:#10234d;--angle:.55deg;--fleck:.54}
.action-paper:focus-visible{outline-color:var(--paper)}
@media(max-width:1040px){
  .wrap{width:min(100% - 3rem,1250px)}
  .signature{gap:.6rem}
  .maker{padding-inline-start:.6rem}
  .maker strong{font-size:.78rem}
  .masthead nav{gap:1rem}
  .scratchpad{min-height:320px;padding-inline:2.35rem 1rem}
}
@media(max-width:830px){
  .masthead{min-height:0;flex-wrap:wrap;gap:.8rem 1rem;padding-block:1rem}
  .masthead nav{order:3;flex-basis:100%;gap:1.4rem}
  .hero{grid-template-columns:1fr;gap:2rem;padding-block:2.35rem 2.3rem}
  h1{font-size:clamp(2.7rem,7.5vw,4.15rem)}
  .hero-copy>p{max-width:44ch}
  .hero-actions{margin-top:1.55rem}
  .scratchpad{min-height:0;padding-bottom:1.2rem}
  .record-name,.note-card dl{font-size:clamp(.76rem,2.2vw,1rem)}
  .product{grid-template-columns:minmax(0,1fr) 160px;gap:1.1rem}
  .features{grid-template-columns:1fr;gap:1rem}
  .access{grid-template-columns:minmax(0,1fr) auto;padding:1.4rem}
  .access p{grid-column:1;border:0;padding:0}
  .access .action{grid-column:2;grid-row:1/3}
}
@media(max-width:500px){
  .wrap{width:calc(100% - 2.15rem)}
  .masthead .action{display:none}
  .signature{gap:.5rem}
  .record-mark{width:25px;height:25px;margin-inline-end:.45rem}
  .brand-word{font-size:1.88rem}
  .db-stamp{font-size:1.27rem}
  .maker{gap:.26rem;padding-inline-start:.5rem}
  .maker i{font-size:.86rem}
  .maker strong{font-size:.64rem}
  .masthead nav a{display:inline-flex;align-items:center;min-height:44px}
  .hero-actions{gap:1.15rem}
  .scratchpad{padding:1.15rem .75rem 1.12rem 1.35rem}
  .scratchpad::before{background-position:-12px 0,0 0,0 0,0 0}
  .scratchpad figcaption{font-size:2.35rem}
  .query-flow{margin-top:1.05rem;gap:.28rem;grid-template-columns:minmax(0,1.19fr) 48px minmax(0,.98fr)}
  .note-card{padding:.28rem .32rem}
  .note-title{font-size:1.25rem}
  .note-card dl{column-gap:.29em}
  .record-name,.note-card dl{font-size:.72rem}
  .product{grid-template-columns:1fr;padding-block:2rem}
  .walkthrough{justify-self:center;max-width:290px}
  .walkthrough img{width:126px}
  .access{display:flex;align-items:flex-start;flex-direction:column;gap:.85rem;padding:1.3rem}
}
@media(max-width:365px){
  .signature{flex-basis:100%}
  .masthead nav{order:2;flex-basis:auto;gap:.65rem}
  .hero-actions{gap:.65rem 1rem}
  h1{font-size:2.42rem}
  .scratchpad{padding-inline-start:.85rem}
  .scratchpad figcaption{font-size:2.04rem}
  .query-flow{grid-template-columns:minmax(0,1.2fr) 39px minmax(0,.98fr)}
  .note-title{font-size:1.1rem}
  .note-card dl{grid-template-columns:1fr}
  .note-card dd{border:0;padding-top:0}
}
"""
