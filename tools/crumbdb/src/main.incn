from std.environ import get_or
from std.fs import Path
from page import homepage
from theme import stylesheet


def write_output(directory: Path, name: str, content: str) -> None:
    directory.joinpath(name).write_text(content, encoding="utf-8", errors="strict", newline=None).unwrap()


def main() -> None:
    output = Path(get_or("CRUMBDB_OUTPUT", "../../crumbdb"))
    output.mkdir(parents=true, exist_ok=true).unwrap()
    write_output(output, "index.html", homepage())
    write_output(output, "photocopied.css", stylesheet())
