#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
compiler=${CRUMBDB_INCAN:-incan}
output=${CRUMBDB_OUTPUT:-"$root/../../crumbdb"}
mkdir -p "$output"
export CRUMBDB_OUTPUT
CRUMBDB_OUTPUT=$(cd "$output" && pwd)
export INCAN_HOME=${CRUMBDB_INCAN_HOME:-"$root/target/incan-home"}
export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-1.98.0}
unset INCAN_STDLIB
cd "$root"
"$compiler" run src/main.incn
mkdir -p "$CRUMBDB_OUTPUT/assets"
cp -R "$root/assets/." "$CRUMBDB_OUTPUT/assets/"
