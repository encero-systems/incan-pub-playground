{
  "name": "incan-pub-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:tool && npm run build:site",
    "check": "node --test tools/site/tests.mjs tools/site/registry-tests.mjs",
    "snapshot": "tools/site/target/incan/main/oven/release/main --snapshot",
    "build:tool": "cd tools/site && INCAN_HOME=\"$PWD/target/incan-home\" incan build main.incn",
    "build:site": "tools/site/target/incan/main/oven/release/main --registry assets/registry . tools/site/templates"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "markdown-it": "14.1.0"
  }
}
