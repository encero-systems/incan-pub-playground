# Registry documentation is digest-bound; preserve upstream bytes exactly.
assets/registry/content/sha256/* -text -diff
assets/registry/manifests/** -text

# Incan sources: highlight as Python until Linguist knows Incan, without counting them as Python.
*.incn linguist-language=Python -linguist-detectable

# Approved COMIC snapshot and artifact receipts bind exact bytes, including font licenses.
comic/** -text
tools/comic/** -text
